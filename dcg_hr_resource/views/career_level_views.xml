<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_career_level_list" model="ir.ui.view">
        <field name="name">dcg.employee.career.level.list</field>
        <field name="model">dcg.employee.career.level</field>
        <field name="arch" type="xml">
            <list string="Career Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="minimum_years"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_career_level" model="ir.actions.act_window">
        <field name="name">Career Levels</field>
        <field name="res_model">dcg.employee.career.level</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
