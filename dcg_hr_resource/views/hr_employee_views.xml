<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_hr_resource" model="ir.ui.view">
        <field name="name">hr.employee.form.hr.resource</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Delivery Profile" name="delivery_profile"
                      groups="dcg_hr_resource.group_dcg_hr_resource_user">
                    <group>
                        <group string="Delivery Info">
                            <field name="employee_code"/>
                            <field name="career_level_id"/>
                            <field name="is_billable"/>
                            <field name="join_delivery_date"/>
                        </group>
                        <group string="Cost &amp; Capacity">
                            <field name="hour_cost"/>
                            <field name="hour_bill_rate"/>
                            <field name="capacity_hours_month"/>
                            <field name="target_utilization"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>
                <page string="Certificates" name="certificates"
                      groups="dcg_hr_resource.group_dcg_hr_resource_user">
                    <field name="certificate_ids">
                        <list>
                            <field name="name"/>
                            <field name="issuer"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" widget="boolean"
                                   decoration-danger="is_expired"/>
                        </list>
                    </field>
                </page>
                <page string="Training" name="training"
                      groups="dcg_hr_resource.group_dcg_hr_resource_user">
                    <field name="training_ids">
                        <list>
                            <field name="course_name"/>
                            <field name="provider"/>
                            <field name="start_date"/>
                            <field name="result" widget="badge"/>
                            <field name="has_certificate" widget="boolean"/>
                        </list>
                    </field>
                </page>
                <page string="KPI" name="kpi"
                      groups="dcg_hr_resource.group_dcg_hr_resource_manager">
                    <field name="kpi_ids">
                        <list>
                            <field name="period"/>
                            <field name="utilization_rate" widget="progressbar"/>
                            <field name="billable_hours"/>
                            <field name="overall_score"/>
                            <field name="is_locked" widget="boolean"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
