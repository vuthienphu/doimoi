<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_competency_list" model="ir.ui.view">
        <field name="name">dcg.employee.competency.list</field>
        <field name="model">dcg.employee.competency</field>
        <field name="arch" type="xml">
            <list string="Competency Assessments">
                <field name="employee_id"/>
                <field name="period"/>
                <field name="assessment_date"/>
                <field name="technical_score"/>
                <field name="communication_score"/>
                <field name="leadership_score" optional="show"/>
                <field name="problem_solving_score" optional="show"/>
                <field name="teamwork_score" optional="show"/>
                <field name="overall_score"/>
                <field name="reviewer_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_competency" model="ir.actions.act_window">
        <field name="name">Competency Assessments</field>
        <field name="res_model">dcg.employee.competency</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
