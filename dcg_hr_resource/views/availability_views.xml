<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_availability_list" model="ir.ui.view">
        <field name="name">dcg.employee.availability.list</field>
        <field name="model">dcg.employee.availability</field>
        <field name="arch" type="xml">
            <list string="Availability" editable="bottom">
                <field name="employee_id"/>
                <field name="available_from"/>
                <field name="available_to"/>
                <field name="available_hours"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'partial'"
                       decoration-danger="status in ('allocated', 'resigned')"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_availability" model="ir.actions.act_window">
        <field name="name">Availability</field>
        <field name="res_model">dcg.employee.availability</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
