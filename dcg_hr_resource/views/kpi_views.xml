<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_kpi_list" model="ir.ui.view">
        <field name="name">dcg.employee.kpi.list</field>
        <field name="model">dcg.employee.kpi</field>
        <field name="arch" type="xml">
            <list string="Delivery KPIs">
                <field name="employee_id"/>
                <field name="period"/>
                <field name="utilization_rate" widget="progressbar"/>
                <field name="billable_rate" optional="show"/>
                <field name="total_hours" optional="show"/>
                <field name="billable_hours"/>
                <field name="overtime_hours" optional="show"/>
                <field name="project_count" optional="show"/>
                <field name="overall_score"/>
                <field name="is_locked" widget="boolean"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_kpi_search" model="ir.ui.view">
        <field name="name">dcg.employee.kpi.search</field>
        <field name="model">dcg.employee.kpi</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="period"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_kpi" model="ir.actions.act_window">
        <field name="name">Delivery KPIs</field>
        <field name="res_model">dcg.employee.kpi</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
