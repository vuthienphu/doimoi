<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_training_list" model="ir.ui.view">
        <field name="name">dcg.employee.training.list</field>
        <field name="model">dcg.employee.training</field>
        <field name="arch" type="xml">
            <list string="Training History">
                <field name="employee_id"/>
                <field name="course_name"/>
                <field name="provider" optional="show"/>
                <field name="start_date"/>
                <field name="end_date" optional="show"/>
                <field name="hours" optional="show"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'passed'"
                       decoration-danger="result == 'failed'"/>
                <field name="has_certificate" widget="boolean"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_training" model="ir.actions.act_window">
        <field name="name">Training History</field>
        <field name="res_model">dcg.employee.training</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
