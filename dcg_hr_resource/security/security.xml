        <field name="name">DCG HR Resource / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
    </record>
    <record id="group_dcg_hr_resource_manager" model="res.groups">
        <field name="name">DCG HR Resource / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_hr_resource_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
