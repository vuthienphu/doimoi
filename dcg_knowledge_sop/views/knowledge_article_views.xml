<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_knowledge_article_kanban" model="ir.ui.view">
        <field name="name">dcg.knowledge.article.kanban</field>
        <field name="model">dcg.knowledge.article</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <field name="category_id"/><field name="article_type"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold" t-esc="record.title.value"/>
                        <div class="text-muted"><field name="code"/> — <field name="article_type"/></div>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer>
                            <span class="text-muted"><i class="fa fa-eye"/> <field name="view_count"/></span>
                            <span class="text-muted ms-2"><i class="fa fa-star"/> <field name="avg_rating"/></span>
                            <field name="author_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dcg_knowledge_article_list" model="ir.ui.view">
        <field name="name">dcg.knowledge.article.list</field>
        <field name="model">dcg.knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Articles" multi_edit="1">
                <field name="code"/><field name="title"/>
                <field name="article_type"/><field name="category_id"/>
                <field name="audience" optional="show"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="view_count" optional="show"/>
                <field name="avg_rating" optional="show"/>
                <field name="published_date" optional="show"/>
                <field name="is_pinned" widget="boolean_toggle" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state == 'review'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_knowledge_article_form" model="ir.ui.view">
        <field name="name">dcg.knowledge.article.form</field>
        <field name="model">dcg.knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article">
                <header>
                    <button name="action_submit_review" type="object" string="Submit Review"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="dcg_knowledge_sop.group_dcg_knowledge_editor"/>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state != 'review'"
                            groups="dcg_knowledge_sop.group_dcg_knowledge_manager"/>
                    <button name="action_archive_article" type="object" string="Archive"
                            invisible="state not in ('published',)"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('review', 'archived')"/>
                    <button name="action_create_revision" type="object" string="Save Revision"
                            invisible="state != 'published'"
                            groups="dcg_knowledge_sop.group_dcg_knowledge_editor"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/><h1><field name="title"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="article_type"/>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="audience"/>
                            <field name="module_name"/>
                            <field name="keyword"/>
                        </group>
                        <group string="Metadata">
                            <field name="author_id"/>
                            <field name="reviewer_id"/>
                            <field name="current_version"/>
                            <field name="published_date"/>
                            <field name="expiry_date"/>
                            <field name="is_expired" readonly="1"/>
                            <field name="is_pinned"/>
                            <field name="is_featured"/>
                        </group>
                    </group>
                    <group>
                        <group string="Metrics">
                            <field name="view_count" readonly="1"/>
                            <field name="like_count" readonly="1"/>
                            <field name="avg_rating" readonly="1"/>
                        </group>
                        <group string="Links">
                            <field name="project_id"/>
                            <field name="ticket_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Content" name="content">
                            <field name="summary" placeholder="Brief summary..."/>
                            <field name="content"/>
                        </page>
                        <page string="FAQ" name="faq"
                              invisible="article_type != 'faq'">
                            <separator string="Question"/>
                            <field name="question"/>
                            <separator string="Answer"/>
                            <field name="answer"/>
                        </page>
                        <page string="Known Issue" name="known_issue"
                              invisible="article_type != 'known_issue'">
                            <separator string="Problem"/>
                            <field name="problem"/>
                            <separator string="Root Cause"/>
                            <field name="root_cause"/>
                            <separator string="Solution"/>
                            <field name="solution"/>
                        </page>
                        <page string="Revisions" name="revisions">
                            <field name="revision_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="version"/>
                                    <field name="revised_by_id"/>
                                    <field name="change_note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feedback" name="feedback">
                            <field name="feedback_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="rating"/>
                                    <field name="is_helpful" widget="boolean_toggle"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_knowledge_article_search" model="ir.ui.view">
        <field name="name">dcg.knowledge.article.search</field>
        <field name="model">dcg.knowledge.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/><field name="code"/>
                <field name="keyword"/><field name="module_name"/>
                <field name="category_id"/><field name="tag_ids"/>
                <field name="article_type"/><field name="author_id"/>
                <separator/>
                <filter string="Published" name="filter_published" domain="[('state', '=', 'published')]"/>
                <filter string="In Review" name="filter_review" domain="[('state', '=', 'review')]"/>
                <filter string="FAQ" name="filter_faq" domain="[('article_type', '=', 'faq')]"/>
                <filter string="SOP" name="filter_sop" domain="[('article_type', '=', 'sop')]"/>
                <filter string="Known Issue" name="filter_ki" domain="[('article_type', '=', 'known_issue')]"/>
                <filter string="Pinned" name="filter_pinned" domain="[('is_pinned', '=', True)]"/>
                <filter string="Expired" name="filter_expired" domain="[('is_expired', '=', True)]"/>
                <separator/>
                <filter string="My Articles" name="filter_my" domain="[('author_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_cat" context="{'group_by': 'category_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'article_type'}"/>
                    <filter string="Author" name="group_author" context="{'group_by': 'author_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Audience" name="group_audience" context="{'group_by': 'audience'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_knowledge_article" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">dcg.knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a knowledge article</p>
        </field>
    </record>

    <record id="action_dcg_knowledge_article_all" model="ir.actions.act_window">
        <field name="name">All Articles</field>
        <field name="res_model">dcg.knowledge.article</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_dcg_knowledge_faq" model="ir.actions.act_window">
        <field name="name">FAQ</field>
        <field name="res_model">dcg.knowledge.article</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('article_type', '=', 'faq')]</field>
        <field name="context">{'default_article_type': 'faq'}</field>
    </record>

    <record id="action_dcg_knowledge_sop" model="ir.actions.act_window">
        <field name="name">SOP</field>
        <field name="res_model">dcg.knowledge.article</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('article_type', '=', 'sop')]</field>
        <field name="context">{'default_article_type': 'sop'}</field>
    </record>

</odoo>
