<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_knowledge_category_list" model="ir.ui.view">
        <field name="name">dcg.knowledge.category.list</field>
        <field name="model">dcg.knowledge.category</field>
        <field name="arch" type="xml">
            <list string="Knowledge Categories" editable="bottom">
                <field name="sequence" widget="handle"/><field name="code"/><field name="name"/>
                <field name="article_count"/><field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_knowledge_category" model="ir.actions.act_window">
        <field name="name">Categories</field><field name="res_model">dcg.knowledge.category</field><field name="view_mode">list</field>
    </record>
</odoo>
