<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_knowledge_user" model="res.groups">
        <field name="name">DCG Knowledge / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
    </record>
    <record id="group_dcg_knowledge_editor" model="res.groups">
        <field name="name">DCG Knowledge / Editor</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_knowledge_user'))]"/>
    </record>
    <record id="group_dcg_knowledge_manager" model="res.groups">
        <field name="name">DCG Knowledge / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_knowledge_editor'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
