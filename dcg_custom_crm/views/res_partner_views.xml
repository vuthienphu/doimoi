<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dcg_custom_crm_view_partner_filter" model="ir.ui.view">
        <field name="name">dcg.custom.crm.res.partner.filter</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Công ty" name="group_by_parent_id" context="{'group_by': 'parent_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_dcg_person_contacts" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_company', '=', False)]</field>
        <field name="context">{'default_is_company': False, 'search_default_group_by_parent_id': 1}</field>
    </record>

    <record id="action_dcg_company_contacts" model="ir.actions.act_window">
        <field name="name">Công ty</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{'default_is_company': True}</field>
    </record>

    <menuitem id="contacts.menu_contacts" name="Liên hệ"/>

    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_dcg_person_contacts" 
              name="Khách hàng" 
              parent="contacts.menu_contacts" 
              action="action_dcg_person_contacts" 
              sequence="1"/>

    <menuitem id="menu_dcg_company_contacts" 
              name="Công ty" 
              parent="contacts.menu_contacts" 
              action="action_dcg_company_contacts" 
              sequence="2"/>

    <record id="dcg_custom_crm_view_partner_tree" model="ir.ui.view">
        <field name="name">dcg.custom.crm.res.partner.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="function" string="Chức danh" optional="show"/>
                <field name="department_name" string="Phòng ban" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="dcg_custom_crm_view_partner_form" model="ir.ui.view">
        <field name="name">dcg.custom.crm.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_supplier" invisible="not is_company"/>
            </xpath>
            <xpath expr="//field[@name='function']" position="after">
                <field name="department_name" invisible="is_company"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']//field[@name='comment']" position="replace">
            </xpath>
            <xpath expr="//page[@name='contact_addresses']//field[@name='child_ids']" position="after">
                <separator string="Ghi chú"/>
                <field name="comment" nolabel="1" placeholder="Nhập ghi chú..."/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='function']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Chức danh</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//div[@class='row flex-row']" position="after">
                <div class="d-flex gap-4 mt-2" invisible="is_company or type != 'contact'">
                    <label for="is_decision_maker"/>
                    <field name="is_decision_maker"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="payment_info" string="Thanh toán">
                    <field name="bank_ids">
                        <list editable="bottom">
                            <field name="acc_holder_name" string="Chủ tài khoản"/>
                            <field name="bank_id" string="Tên ngân hàng"/>
                            <field name="acc_number" string="Số tài khoản"/>
                            <field name="branch_name" string="Chi nhánh"/>
                        </list>
                    </field>
                </page>
                <page string="Kế hoạch khách hàng" name="account_plan" invisible="not is_company">
                    <!-- Dòng 1: Tổng hợp thông tin khách hàng (Dữ liệu tự động) -->
                    <div class="row mt-2 mb-4">
                        <div class="col-12">
                            <h3 style="color: #017e84;">Tổng hợp dữ liệu Khách hàng</h3>
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_total_opportunity_count"/></strong><br/>Tổng Cơ hội
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_open_opportunity_count"/></strong><br/>Cơ hội đang mở
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_won_opportunity_count"/></strong><br/>Cơ hội đã thắng
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_total_revenue"/></strong><br/>Tổng Doanh thu
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_pipeline_value"/></strong><br/>Pipeline dự kiến
                        </div>
                        <div class="col border-end text-center">
                            <strong><field name="account_active_contract_count"/></strong><br/>Hợp đồng (Kích hoạt)
                        </div>
                        <div class="col text-center">
                            <strong><field name="account_active_project_count"/></strong><br/>Dự án / Ticket đang mở
                        </div>
                    </div>

                    <group>
                        <group string="1. Đánh giá tổng quan">
                            <field name="account_customer_status" required="is_company"/>
                            <field name="account_relationship_level" required="is_company"/>
                            <field name="account_customer_potential" required="is_company"/>
                            <field name="account_next_evaluation_date"/>
                        </group>
                        <group string="2. Đánh giá rủi ro">
                            <field name="account_risk_level"/>
                            <field name="account_risk_reason_ids" widget="many2many_tags" invisible="account_risk_level not in ('low','medium','high','critical')"/>
                            <field name="account_risk_description" invisible="account_risk_level not in ('low','medium','high','critical')" rows="2"/>
                        </group>
                    </group>

                    <group>
                        <group string="3. Mục tiêu &amp; Nhu cầu">
                            <field name="account_customer_goal"/>
                            <field name="account_business_goal"/>
                            <field name="account_current_issues"/>
                            <field name="account_current_needs"/>
                            <field name="account_expected_needs"/>
                        </group>
                        <group string="4. Định hướng phát triển">
                            <field name="account_tech_orientation"/>
                            <field name="account_development_strategy"/>
                            <field name="account_internal_note"/>
                        </group>
                    </group>

                    <separator string="5. Sản phẩm / Dịch vụ đang sử dụng"/>
                    <field name="account_product_status_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="status"/>
                            <field name="project_id"/>
                            <field name="lead_id"/>
                            <field name="notes"/>
                        </list>
                    </field>

                    <separator string="6. Cơ hội Bán thêm / Bán chéo (Upsell / Cross-sell)"/>
                    <field name="account_upsell_ids" nolabel="1" colspan="2">
                        <list editable="bottom" decoration-success="state=='converted'" decoration-muted="state=='lost'">
                            <field name="type"/>
                            <field name="product_name"/>
                            <field name="expected_revenue"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="expected_date"/>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="opportunity_id" readonly="1" invisible="not opportunity_id"/>
                            <button name="action_create_opportunity" type="object" string="Tạo Cơ hội CRM" icon="fa-plus-circle" invisible="state != 'qualified' or opportunity_id"/>
                        </list>
                    </field>
                </page>

            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='is_decision_maker']" position="after">
                <label for="account_role" invisible="is_company or type != 'contact'"/>
                <field name="account_role" invisible="is_company or type != 'contact'"/>
            </xpath>
        </field>
    </record>
</odoo>
