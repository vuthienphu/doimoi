<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_dcg_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.dcg.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_set_won_rainbowman']" position="after">
                <button name="action_complete_survey" string="Hoàn thành khảo sát" type="object"
                        invisible="type == 'lead' or survey_done"/>
                <button name="action_continue_survey" string="Tiếp tục khảo sát" type="object"
                        invisible="type == 'lead' or not survey_done"/>
                <button name="action_complete_demo" string="Hoàn thành demo" type="object"
                        invisible="type == 'lead' or demo_done"/>
                <button name="action_continue_demo" string="Tiếp tục demo" type="object"
                        invisible="type == 'lead' or not demo_done"/>
            </xpath>
            <xpath expr="//sheet/field[@name='won_status']" position="after">
                <field name="survey_done" invisible="1"/>
                <field name="demo_done" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/h2" position="replace">
            </xpath>
            <xpath expr="//group[1]" position="before">
                <group name="financial_info">
                    <group>
                        <field name="company_currency" invisible="1"/>
                        <field name="contract_type" string="Loại hợp đồng"/>
                        <field name="expected_revenue" string="Doanh thu dự kiến" invisible="contract_type == 'service'" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                        <field name="periodic_revenue" string="Doanh thu từng kỳ" invisible="contract_type == 'package'" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                        <field name="probability" string="Xác suất (%)"/>
                    </group>
                    <group>
                    </group>
                </group>
            </xpath>
            <xpath expr="(//field[@name='user_id'])[1]" position="after">
                <label for="commission_rate"/>
                <div class="o_row">
                    <field name="commission_rate" readonly="1" class="oe_inline"/>
                    <span>%</span>
                </div>
            </xpath>
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='tag_ids']" position="after">
                <field name="project_id"
                       context="{'default_partner_id': partner_id, 'default_user_id': user_id}"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="before">
                <page name="exchange_history" string="Lịch sử trao đổi">
                    <field name="exchange_history_ids">
                        <list editable="bottom">
                            <field name="user_id"/>
                            <field name="date"/>
                            <field name="partner_id" domain="[('parent_id', '=', parent.customer_company_id)]"/>
                            <field name="exchange_method"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="user_id"/>
                                        <field name="partner_id" domain="[('parent_id', '=', parent.customer_company_id)]"/>
                                    </group>
                                    <group>
                                        <field name="date"/>
                                        <field name="exchange_method"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Nội dung">
                                        <field name="content"/>
                                    </page>
                                    <page string="Đính kèm">
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page name="dcg_survey" string="Khảo sát" invisible="type == 'lead'">
                    <group>
                        <group string="Khảo sát">
                            <field name="survey_done" readonly="1" widget="boolean_toggle"/>
                            <field name="survey_finish_date" readonly="1"/>
                            <field name="survey_note"/>
                        </group>
                    </group>
                    <div class="h3">Chi tiết đầu mục khảo sát</div>
                    <field name="survey_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="module"/>
                            <field name="name"/>
                            <field name="current_state"/>
                            <field name="desired_state"/>
                            <field name="priority"/>
                            <field name="solution"/>
                            <field name="survey_date"/>
                            <field name="surveyor_id" options="{'no_create': True}"/>
                            <field name="customer_contact_id" options="{'no_create': True}"/>
                            <field name="dev_requirement_clear" widget="boolean_toggle"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
                <page name="dcg_demo" string="Demo" invisible="type == 'lead'">
                    <group>
                        <group string="Thông tin Demo">
                            <field name="demo_done" widget="boolean_toggle"/>
                            <field name="demo_finish_date"/>
                            <field name="is_internal_demo_done" widget="boolean_toggle"/>
                            <field name="is_customer_demo_done" widget="boolean_toggle"/>
                        </group>
                        <group string="Nhân sự">
                            <field name="internal_demo_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="demo_reviewer_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="h3">Checklist Demo Nội Bộ</div>
                    <field name="internal_demo_checklist_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="checker_id" options="{'no_create': True}" readonly="1"/>
                            <field name="is_confirmed" widget="boolean_toggle" readonly="1"/>
                            <field name="notes" readonly="1"/>
                            <button name="action_open_confirm_wizard" type="object" string="Kiểm tra" icon="fa-check-square-o" class="btn-secondary"/>
                        </list>
                    </field>
                    <div class="h3 mt-3">Demo Khách Hàng</div>
                    <field name="customer_demo_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="demo_date"/>
                            <field name="feedback"/>
                            <field name="has_survey_followup" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="crm_case_tree_view_oppor_inherit_dcg_custom" model="ir.ui.view">
        <field name="name">crm.lead.list.opportunity.inherit.dcg.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field name="commission_rate" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="survey_date" optional="show"/>
                <field name="surveyor_id" optional="show"/>
                <field name="customer_contact_id" optional="show"/>
                <field name="dev_requirement_clear" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='contact_name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='my_activity_date_deadline']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
    <record id="sales_team.sales_team_crm_tag_action" model="ir.actions.act_window">
        <field name="name">Module (Thẻ)</field>
    </record>
    <record id="crm_tag_view_tree_inherit_dcg_custom" model="ir.ui.view">
        <field name="name">crm.tag.tree.inherit.dcg.custom</field>
        <field name="model">crm.tag</field>
        <field name="inherit_id" ref="sales_team.sales_team_crm_tag_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="module_function"/>
                <field name="checklist_text"/>
            </xpath>
        </field>
    </record>
    <record id="crm_tag_view_form_inherit_dcg_custom" model="ir.ui.view">
        <field name="name">crm.tag.form.inherit.dcg.custom</field>
        <field name="model">crm.tag</field>
        <field name="inherit_id" ref="sales_team.sales_team_crm_tag_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="module_function"/>
                <field name="checklist_text"/>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_survey_line_view_form" model="ir.ui.view">
        <field name="name">crm.lead.survey.line.form</field>
        <field name="model">crm.lead.survey.line</field>
        <field name="arch" type="xml">
            <form string="Khảo sát thêm">
                <group>
                    <field name="module"/>
                    <field name="name"/>
                    <field name="current_state"/>
                    <field name="desired_state"/>
                    <field name="priority"/>
                    <field name="solution"/>
                    <field name="survey_date"/>
                    <field name="surveyor_id"/>
                    <field name="customer_contact_id"/>
                    <field name="dev_requirement_clear"/>
                    <field name="notes"/>
                </group>
            </form>
        </field>
    </record>
    <record id="crm_demo_customer_line_view_form" model="ir.ui.view">
        <field name="name">crm.demo.customer.line.form</field>
        <field name="model">crm.demo.customer.line</field>
        <field name="arch" type="xml">
            <form string="Demo thêm">
                <group>
                    <field name="partner_id"/>
                    <field name="demo_date"/>
                    <field name="feedback"/>
                    <field name="has_survey_followup"/>
                </group>
            </form>
        </field>
    </record>
    <record id="crm_lead_search_inherit_dcg_custom" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.dcg.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="competitor" string="Đối thủ"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Lý do mất cơ hội" name="group_by_lost_reason" context="{'group_by':'lost_reason_id'}"/>
                <filter string="Đối thủ" name="group_by_competitor" context="{'group_by':'competitor'}"/>
            </xpath>
        </field>
    </record>
</odoo>
