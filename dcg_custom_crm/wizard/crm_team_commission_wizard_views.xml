<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_commission_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.team.commission.wizard.form</field>
        <field name="model">crm.team.commission.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật toàn bộ hoa hồng">
                <group>
                    <field name="team_id"/>
                    <label for="commission_rate"/>
                    <div class="o_row">
                        <field name="commission_rate" class="oe_inline"/>
                        <span>%</span>
                    </div>
                </group>
                <p>
                    Cập nhật toàn bộ hoa hồng cho các thành viên theo tỷ lệ hiện tại của Bộ phận Sales?
                </p>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
