<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_demo_checklist_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.demo.checklist.wizard.form</field>
        <field name="model">crm.demo.checklist.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác nhận kiểm tra">
                <group>
                    <field name="checklist_id" invisible="1"/>
                    <field name="is_confirmed"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
