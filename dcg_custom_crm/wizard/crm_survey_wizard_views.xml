<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_survey_wizard_view_form" model="ir.ui.view">
        <field name="name">crm.survey.wizard.form</field>
        <field name="model">crm.survey.wizard</field>
        <field name="arch" type="xml">
            <form string="Tiếp tục khảo sát/demo">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="type" invisible="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="content" placeholder="Nhập nội dung khảo sát/demo thêm..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
