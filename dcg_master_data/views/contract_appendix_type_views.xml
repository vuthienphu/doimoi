<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_contract_appendix_type_list" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.type.list</field>
        <field name="model">dcg.contract.appendix.type</field>
        <field name="arch" type="xml">
            <list string="Contract Appendix Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_contract_appendix_type_form" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.type.form</field>
        <field name="model">dcg.contract.appendix.type</field>
        <field name="arch" type="xml">
            <form string="Contract Appendix Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_contract_appendix_type_search" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.type.search</field>
        <field name="model">dcg.contract.appendix.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dcg_contract_appendix_type" model="ir.actions.act_window">
        <field name="name">Contract Appendix Types</field>
        <field name="res_model">dcg.contract.appendix.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_contract_appendix_type"
        name="Contract Appendix Types"
        parent="menu_dcg_config_contract"
        action="action_dcg_contract_appendix_type"
        sequence="20"/>

</odoo>
