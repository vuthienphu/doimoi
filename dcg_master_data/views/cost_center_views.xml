<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_cost_center_list" model="ir.ui.view">
        <field name="name">dcg.cost.center.list</field>
        <field name="model">dcg.cost.center</field>
        <field name="arch" type="xml">
            <list string="Cost Centers">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_cost_center_form" model="ir.ui.view">
        <field name="name">dcg.cost.center.form</field>
        <field name="model">dcg.cost.center</field>
        <field name="arch" type="xml">
            <form string="Cost Center">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_cost_center_search" model="ir.ui.view">
        <field name="name">dcg.cost.center.search</field>
        <field name="model">dcg.cost.center</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_cost_center" model="ir.actions.act_window">
        <field name="name">Cost Centers</field>
        <field name="res_model">dcg.cost.center</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_cost_center"
        name="Cost Centers"
        parent="menu_dcg_config_finance"
        action="action_dcg_cost_center"
        sequence="20"/>

</odoo>
