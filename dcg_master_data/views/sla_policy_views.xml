<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_sla_policy_list" model="ir.ui.view">
        <field name="name">dcg.sla.policy.list</field>
        <field name="model">dcg.sla.policy</field>
        <field name="arch" type="xml">
            <list string="SLA Policies">
                <field name="code"/>
                <field name="name"/>
                <field name="ticket_type_id"/>
                <field name="severity_id"/>
                <field name="response_hours"/>
                <field name="resolution_hours"/>
                <field name="working_calendar_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_sla_policy_form" model="ir.ui.view">
        <field name="name">dcg.sla.policy.form</field>
        <field name="model">dcg.sla.policy</field>
        <field name="arch" type="xml">
            <form string="SLA Policy">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group string="Scope">
                            <field name="ticket_type_id"/>
                            <field name="severity_id"/>
                            <field name="working_calendar_id"/>
                        </group>
                    </group>
                    <group string="SLA Targets">
                        <field name="response_hours"/>
                        <field name="resolution_hours"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_sla_policy_search" model="ir.ui.view">
        <field name="name">dcg.sla.policy.search</field>
        <field name="model">dcg.sla.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="ticket_type_id"/>
                <field name="severity_id"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Ticket Type" name="group_ticket_type" context="{'group_by': 'ticket_type_id'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_sla_policy" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">dcg.sla.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_sla_policy"
        name="SLA Policies"
        parent="menu_dcg_config_support"
        action="action_dcg_sla_policy"
        sequence="40"/>

</odoo>
