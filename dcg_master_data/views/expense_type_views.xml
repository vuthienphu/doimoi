<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_expense_type_list" model="ir.ui.view">
        <field name="name">dcg.expense.type.list</field>
        <field name="model">dcg.expense.type</field>
        <field name="arch" type="xml">
            <list string="Expense Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="expense_group"/>
                <field name="is_billable" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_expense_type_form" model="ir.ui.view">
        <field name="name">dcg.expense.type.form</field>
        <field name="model">dcg.expense.type</field>
        <field name="arch" type="xml">
            <form string="Expense Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="expense_group"/>
                        </group>
                        <group>
                            <field name="is_billable"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_expense_type_search" model="ir.ui.view">
        <field name="name">dcg.expense.type.search</field>
        <field name="model">dcg.expense.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="expense_group"/>
                <filter string="Billable" name="filter_billable" domain="[('is_billable', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Expense Group" name="group_expense_group" context="{'group_by': 'expense_group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">dcg.expense.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_expense_type"
        name="Expense Types"
        parent="menu_dcg_config_finance"
        action="action_dcg_expense_type"
        sequence="10"/>

</odoo>
