<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_service_catalog_list" model="ir.ui.view">
        <field name="name">dcg.service.catalog.list</field>
        <field name="model">dcg.service.catalog</field>
        <field name="arch" type="xml">
            <list string="Service Catalog">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="service_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_service_catalog_form" model="ir.ui.view">
        <field name="name">dcg.service.catalog.form</field>
        <field name="model">dcg.service.catalog</field>
        <field name="arch" type="xml">
            <form string="Service Catalog">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="service_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Detailed description of the service..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_service_catalog_search" model="ir.ui.view">
        <field name="name">dcg.service.catalog.search</field>
        <field name="model">dcg.service.catalog</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="service_type"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Service Type" name="group_service_type" context="{'group_by': 'service_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_service_catalog" model="ir.actions.act_window">
        <field name="name">Service Catalog</field>
        <field name="res_model">dcg.service.catalog</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_service_catalog"
        name="Service Catalog"
        parent="menu_dcg_config_crm"
        action="action_dcg_service_catalog"
        sequence="30"/>

</odoo>
