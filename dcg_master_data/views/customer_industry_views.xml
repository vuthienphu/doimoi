<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_customer_industry_list" model="ir.ui.view">
        <field name="name">dcg.customer.industry.list</field>
        <field name="model">dcg.customer.industry</field>
        <field name="arch" type="xml">
            <list string="Customer Industries">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_customer_industry_form" model="ir.ui.view">
        <field name="name">dcg.customer.industry.form</field>
        <field name="model">dcg.customer.industry</field>
        <field name="arch" type="xml">
            <form string="Customer Industry">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes about this industry..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_customer_industry_search" model="ir.ui.view">
        <field name="name">dcg.customer.industry.search</field>
        <field name="model">dcg.customer.industry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dcg_customer_industry" model="ir.actions.act_window">
        <field name="name">Customer Industries</field>
        <field name="res_model">dcg.customer.industry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new customer industry
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dcg_customer_industry"
        name="Customer Industries"
        parent="menu_dcg_config_crm"
        action="action_dcg_customer_industry"
        sequence="10"/>

</odoo>
