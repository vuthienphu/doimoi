<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module category -->
    <record id="module_category_dcg" model="ir.module.category">
        <field name="name">DCG</field>
        <field name="description">DCG internal applications</field>
        <field name="sequence">90</field>
    </record>

    <!-- User group: read-only -->
    <record id="group_dcg_master_data_user" model="res.groups">
        <field name="name">DCG Master Data / User</field>
        <field name="category_id" ref="module_category_dcg"/>
        <field name="comment">User có thể đọc dữ liệu master DCG.</field>
    </record>

    <!-- Manager group: full CRUD, implies User -->
    <record id="group_dcg_master_data_manager" model="res.groups">
        <field name="name">DCG Master Data / Manager</field>
        <field name="category_id" ref="module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_master_data_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Manager có toàn quyền cấu hình dữ liệu master DCG.</field>
    </record>

</odoo>
