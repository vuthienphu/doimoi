<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================ -->
    <!-- Ticket Severity                                                -->
    <!-- ============================================================ -->
    <record id="severity_critical" model="dcg.ticket.severity">
        <field name="name">Critical</field>
        <field name="code">SEV_CRIT</field>
        <field name="sequence">10</field>
        <field name="response_hours_default">1.0</field>
        <field name="resolution_hours_default">4.0</field>
    </record>
    <record id="severity_high" model="dcg.ticket.severity">
        <field name="name">High</field>
        <field name="code">SEV_HIGH</field>
        <field name="sequence">20</field>
        <field name="response_hours_default">2.0</field>
        <field name="resolution_hours_default">8.0</field>
    </record>
    <record id="severity_medium" model="dcg.ticket.severity">
        <field name="name">Medium</field>
        <field name="code">SEV_MED</field>
        <field name="sequence">30</field>
        <field name="response_hours_default">4.0</field>
        <field name="resolution_hours_default">24.0</field>
    </record>
    <record id="severity_low" model="dcg.ticket.severity">
        <field name="name">Low</field>
        <field name="code">SEV_LOW</field>
        <field name="sequence">40</field>
        <field name="response_hours_default">8.0</field>
        <field name="resolution_hours_default">72.0</field>
    </record>

    <!-- ============================================================ -->
    <!-- Ticket Priority                                                -->
    <!-- ============================================================ -->
    <record id="priority_p1" model="dcg.ticket.priority">
        <field name="name">P1</field>
        <field name="code">P1</field>
        <field name="sequence">10</field>
    </record>
    <record id="priority_p2" model="dcg.ticket.priority">
        <field name="name">P2</field>
        <field name="code">P2</field>
        <field name="sequence">20</field>
    </record>
    <record id="priority_p3" model="dcg.ticket.priority">
        <field name="name">P3</field>
        <field name="code">P3</field>
        <field name="sequence">30</field>
    </record>
    <record id="priority_p4" model="dcg.ticket.priority">
        <field name="name">P4</field>
        <field name="code">P4</field>
        <field name="sequence">40</field>
    </record>

    <!-- ============================================================ -->
    <!-- Ticket Type                                                    -->
    <!-- ============================================================ -->
    <record id="ticket_type_incident" model="dcg.ticket.type">
        <field name="name">Incident</field>
        <field name="code">INCIDENT</field>
        <field name="sequence">10</field>
    </record>
    <record id="ticket_type_bug" model="dcg.ticket.type">
        <field name="name">Bug</field>
        <field name="code">BUG</field>
        <field name="sequence">20</field>
    </record>
    <record id="ticket_type_service_request" model="dcg.ticket.type">
        <field name="name">Service Request</field>
        <field name="code">SR</field>
        <field name="sequence">30</field>
    </record>
    <record id="ticket_type_change_request" model="dcg.ticket.type">
        <field name="name">Change Request</field>
        <field name="code">CR</field>
        <field name="sequence">40</field>
    </record>
    <record id="ticket_type_consultation" model="dcg.ticket.type">
        <field name="name">Consultation</field>
        <field name="code">CONSULT</field>
        <field name="sequence">50</field>
    </record>
    <record id="ticket_type_training" model="dcg.ticket.type">
        <field name="name">Training Support</field>
        <field name="code">TRAINING</field>
        <field name="sequence">60</field>
    </record>

    <!-- ============================================================ -->
    <!-- Expense Type                                                   -->
    <!-- ============================================================ -->
    <record id="expense_type_taxi" model="dcg.expense.type">
        <field name="name">Taxi</field>
        <field name="code">EXP_TAXI</field>
        <field name="expense_group">transport</field>
        <field name="is_billable" eval="False"/>
    </record>
    <record id="expense_type_hotel" model="dcg.expense.type">
        <field name="name">Hotel</field>
        <field name="code">EXP_HOTEL</field>
        <field name="expense_group">accommodation</field>
        <field name="is_billable" eval="True"/>
    </record>
    <record id="expense_type_meal" model="dcg.expense.type">
        <field name="name">Meal</field>
        <field name="code">EXP_MEAL</field>
        <field name="expense_group">meal</field>
        <field name="is_billable" eval="False"/>
    </record>
    <record id="expense_type_travel" model="dcg.expense.type">
        <field name="name">Travel</field>
        <field name="code">EXP_TRAVEL</field>
        <field name="expense_group">travel</field>
        <field name="is_billable" eval="True"/>
    </record>
    <record id="expense_type_license" model="dcg.expense.type">
        <field name="name">License</field>
        <field name="code">EXP_LIC</field>
        <field name="expense_group">license</field>
        <field name="is_billable" eval="True"/>
    </record>
    <record id="expense_type_subcontractor" model="dcg.expense.type">
        <field name="name">Subcontractor</field>
        <field name="code">EXP_SUB</field>
        <field name="expense_group">subcontractor</field>
        <field name="is_billable" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Contract Type                                                  -->
    <!-- ============================================================ -->
    <record id="contract_type_implementation" model="dcg.contract.type">
        <field name="name">Implementation</field>
        <field name="code">IMPL</field>
        <field name="sequence">10</field>
    </record>
    <record id="contract_type_support" model="dcg.contract.type">
        <field name="name">Support</field>
        <field name="code">SUPPORT</field>
        <field name="sequence">20</field>
    </record>
    <record id="contract_type_maintenance" model="dcg.contract.type">
        <field name="name">Maintenance</field>
        <field name="code">MAINT</field>
        <field name="sequence">30</field>
    </record>

    <!-- ============================================================ -->
    <!-- Acceptance Type                                                -->
    <!-- ============================================================ -->
    <record id="acceptance_type_phase" model="dcg.acceptance.type">
        <field name="name">Phase Acceptance</field>
        <field name="code">ACC_PHASE</field>
        <field name="sequence">10</field>
    </record>
    <record id="acceptance_type_uat" model="dcg.acceptance.type">
        <field name="name">UAT Acceptance</field>
        <field name="code">ACC_UAT</field>
        <field name="sequence">20</field>
    </record>
    <record id="acceptance_type_golive" model="dcg.acceptance.type">
        <field name="name">Go-live Acceptance</field>
        <field name="code">ACC_GOLIVE</field>
        <field name="sequence">30</field>
    </record>

</odoo>
