<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_employee_form_inherit_level" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.level</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Thêm Level ngay dưới Job Title -->
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="level_id"/>
            </xpath>
            <!-- job_title giờ được ghép tự động từ Level + Vị trí công việc -->
            <xpath expr="//field[@name='job_title']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
