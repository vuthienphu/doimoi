<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_level_view_list" model="ir.ui.view">
        <field name="name">hr.level.list</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <list string="Level" editable="bottom">
                <field name="name"/>
                <field name="number"/>
            </list>
        </field>
    </record>

    <record id="hr_level_view_form" model="ir.ui.view">
        <field name="name">hr.level.form</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <form string="Level">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="number"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_level_view_search" model="ir.ui.view">
        <field name="name">hr.level.view.search</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
            </search>
        </field>
    </record>

    <record id="hr_level_action" model="ir.actions.act_window">
        <field name="name">Level</field>
        <field name="res_model">hr.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_level_menu"
              name="Level"
              parent="hr.menu_config_recruitment"
              action="hr_level_action"
              groups="hr.group_hr_user"
              sequence="1"/>

</odoo>
