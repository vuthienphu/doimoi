<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_resource_skill_list" model="ir.ui.view">
        <field name="name">dcg.resource.skill.list</field>
        <field name="model">dcg.resource.skill</field>
        <field name="arch" type="xml">
            <list string="Employee Skills" editable="bottom">
                <field name="employee_id"/>
                <field name="skill_name"/>
                <field name="skill_category"/>
                <field name="level"/>
                <field name="years_of_experience" optional="show"/>
                <field name="certified" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_resource_skill_search" model="ir.ui.view">
        <field name="name">dcg.resource.skill.search</field>
        <field name="model">dcg.resource.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="skill_name"/>
                <field name="employee_id"/>
                <field name="skill_category"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Category" name="group_cat" context="{'group_by': 'skill_category'}"/>
                    <filter string="Level" name="group_level" context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_resource_skill" model="ir.actions.act_window">
        <field name="name">Employee Skills</field>
        <field name="res_model">dcg.resource.skill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
