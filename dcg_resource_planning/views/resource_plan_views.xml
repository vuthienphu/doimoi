<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_resource_plan_list" model="ir.ui.view">
        <field name="name">dcg.resource.plan.list</field>
        <field name="model">dcg.resource.plan</field>
        <field name="arch" type="xml">
            <list string="Resource Plans">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id" optional="show"/>
                <field name="manager_id" widget="many2one_avatar_user" optional="show"/>
                <field name="planned_hours"/>
                <field name="allocated_hours"/>
                <field name="actual_hours" optional="show"/>
                <field name="remaining_hours" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_resource_plan_form" model="ir.ui.view">
        <field name="name">dcg.resource.plan.form</field>
        <field name="model">dcg.resource.plan</field>
        <field name="arch" type="xml">
            <form string="Resource Plan">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_done" type="object" string="Done"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Project">
                            <field name="project_id"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Summary">
                            <field name="planned_hours"/>
                            <field name="allocated_hours" readonly="1"/>
                            <field name="actual_hours" readonly="1"/>
                            <field name="remaining_hours" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allocations" name="allocations">
                            <field name="allocation_ids"
                                   context="{'default_plan_id': id, 'default_project_id': project_id}"/>
                        </page>
                        <page string="Resource Requests" name="requests">
                            <field name="request_ids"
                                   context="{'default_plan_id': id, 'default_project_id': project_id}"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_resource_plan_search" model="ir.ui.view">
        <field name="name">dcg.resource.plan.search</field>
        <field name="model">dcg.resource.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Manager" name="group_mgr" context="{'group_by': 'manager_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_resource_plan" model="ir.actions.act_window">
        <field name="name">Resource Plans</field>
        <field name="res_model">dcg.resource.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
