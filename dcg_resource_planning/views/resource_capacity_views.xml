<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_resource_capacity_list" model="ir.ui.view">
        <field name="name">dcg.resource.capacity.list</field>
        <field name="model">dcg.resource.capacity</field>
        <field name="arch" type="xml">
            <list string="Resource Capacity">
                <field name="period_label"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="role_id" optional="show"/>
                <field name="capacity_hours"/>
                <field name="allocated_hours"/>
                <field name="actual_hours" optional="show"/>
                <field name="available_hours"/>
                <field name="billable_hours" optional="show"/>
                <field name="allocation_rate" widget="progressbar"/>
                <field name="utilization_rate" widget="progressbar" optional="show"/>
                <field name="bench_hours" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_resource_capacity_search" model="ir.ui.view">
        <field name="name">dcg.resource.capacity.search</field>
        <field name="model">dcg.resource.capacity</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="period_label"/>
                <filter string="On Bench" name="filter_bench" domain="[('bench_hours', '&gt;', 40)]"/>
                <filter string="Over-allocated" name="filter_over" domain="[('allocation_rate', '&gt;', 100)]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_label'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_resource_capacity" model="ir.actions.act_window">
        <field name="name">Capacity</field>
        <field name="res_model">dcg.resource.capacity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
