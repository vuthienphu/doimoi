<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_resource_request_list" model="ir.ui.view">
        <field name="name">dcg.resource.request.list</field>
        <field name="model">dcg.resource.request</field>
        <field name="arch" type="xml">
            <list string="Resource Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="role_id"/>
                <field name="quantity"/>
                <field name="urgency" widget="badge"
                       decoration-danger="urgency == 'critical'"
                       decoration-warning="urgency == 'high'"/>
                <field name="needed_from"/>
                <field name="needed_until"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'allocated'"
                       decoration-info="state == 'approved'"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_resource_request_form" model="ir.ui.view">
        <field name="name">dcg.resource.request.form</field>
        <field name="model">dcg.resource.request</field>
        <field name="arch" type="xml">
            <form string="Resource Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="dcg_resource_planning.group_dcg_resource_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="dcg_resource_planning.group_dcg_resource_manager"/>
                    <button name="action_mark_allocated" type="object" string="Mark Allocated"
                            invisible="state != 'approved'"
                            groups="dcg_resource_planning.group_dcg_resource_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('allocated', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,allocated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="project_id"/>
                            <field name="plan_id"/>
                            <field name="requester_id"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Need">
                            <field name="role_id"/>
                            <field name="quantity"/>
                            <field name="urgency"/>
                            <field name="allocation_percent"/>
                            <field name="needed_from"/>
                            <field name="needed_until"/>
                        </group>
                    </group>
                    <group string="Requirements">
                        <field name="required_skills" nolabel="1"/>
                    </group>
                    <field name="justification"/>
                    <group string="Fulfillment" invisible="state not in ('approved', 'allocated')">
                        <field name="allocated_employee_ids" widget="many2many_tags"/>
                        <field name="fulfillment_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dcg_resource_request_search" model="ir.ui.view">
        <field name="name">dcg.resource.request.search</field>
        <field name="model">dcg.resource.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="role_id"/>
                <filter string="My Requests" name="filter_my" domain="[('requester_id', '=', uid)]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ['draft', 'submitted', 'approved'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Urgency" name="group_urgency" context="{'group_by': 'urgency'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_resource_request" model="ir.actions.act_window">
        <field name="name">Resource Requests</field>
        <field name="res_model">dcg.resource.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
