<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_resource" model="ir.ui.view">
        <field name="name">hr.employee.form.resource.planning</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Resource Planning" name="resource_planning"
                      groups="dcg_resource_planning.group_dcg_resource_planner">
                    <group>
                        <group>
                            <field name="primary_role_id"/>
                            <field name="current_allocation_percent"/>
                            <field name="is_on_bench" widget="boolean"/>
                        </group>
                    </group>
                    <separator string="Skills"/>
                    <field name="skill_ids">
                        <list editable="bottom">
                            <field name="skill_name"/>
                            <field name="skill_category"/>
                            <field name="level"/>
                            <field name="years_of_experience" optional="show"/>
                            <field name="certified" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
