<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_resource_planner" model="res.groups">
        <field name="name">DCG Resource / Planner</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">PM: tạo request, xem allocation của project mình.</field>
    </record>
    <record id="group_dcg_resource_manager" model="res.groups">
        <field name="name">DCG Resource / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_resource_planner'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: approve request, allocate, manage capacity/forecast.</field>
    </record>
</odoo>
