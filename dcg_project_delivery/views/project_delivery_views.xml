<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List -->
    <record id="view_dcg_project_delivery_list" model="ir.ui.view">
        <field name="name">dcg.project.delivery.list</field>
        <field name="model">dcg.project.delivery</field>
        <field name="arch" type="xml">
            <list string="Delivery Projects" sample="1">
                <field name="project_code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="project_manager_id" widget="many2one_avatar_user"/>
                <field name="project_type" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="progress_percent" widget="progressbar" optional="show"/>
                <field name="health_status" widget="badge"
                       decoration-success="health_status == 'green'"
                       decoration-warning="health_status == 'yellow'"
                       decoration-danger="health_status == 'red'"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('done', 'closed')"
                       decoration-info="state in ('in_progress', 'uat', 'ready')"
                       decoration-warning="state == 'on_hold'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_dcg_project_delivery_form" model="ir.ui.view">
        <field name="name">dcg.project.delivery.form</field>
        <field name="model">dcg.project.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery Project">
                <header>
                    <button name="action_mark_ready" type="object" string="Mark Ready"
                            invisible="state != 'draft'"/>
                    <button name="action_start_project" type="object" string="Start Project"
                            class="btn-primary" invisible="state not in ('ready', 'on_hold')"/>
                    <button name="action_set_on_hold" type="object" string="Set On Hold"
                            invisible="state != 'in_progress'"/>
                    <button name="action_move_to_uat" type="object" string="Move to UAT"
                            invisible="state != 'in_progress'"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state not in ('in_progress', 'uat')"/>
                    <button name="action_close_project" type="object" string="Close Project"
                            invisible="state != 'done'"/>
                    <button name="action_cancel_project" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,in_progress,uat,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <span class="o_stat_text">Contract</span>
                        </button>
                        <button name="action_view_milestones" type="object"
                                class="oe_stat_button" icon="fa-flag"
                                invisible="not milestone_count">
                            <field name="milestone_count" widget="statinfo" string="Milestones"/>
                        </button>
                        <button name="action_view_issues" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="not issue_count">
                            <field name="issue_count" widget="statinfo" string="Issues"/>
                        </button>
                        <button name="action_view_change_requests" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                invisible="not change_request_count">
                            <field name="change_request_count" widget="statinfo" string="CRs"/>
                        </button>
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <field name="project_code" readonly="1"/>
                    </div>

                    <group>
                        <group string="Source">
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="estimate_id"/>
                            <field name="project_type"/>
                            <field name="odoo_project_id"/>
                        </group>
                        <group string="Ownership">
                            <field name="project_manager_id"/>
                            <field name="delivery_owner_id"/>
                            <field name="presales_owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Timeline">
                            <field name="kick_off_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="actual_end_date"/>
                            <field name="warranty_start_date"/>
                            <field name="warranty_end_date"/>
                        </group>
                        <group string="Overview">
                            <field name="contract_amount_total" readonly="1"/>
                            <field name="expected_cost"/>
                            <field name="expected_margin"/>
                            <field name="planned_effort_hours" readonly="1"/>
                            <field name="actual_effort_hours"/>
                            <field name="progress_percent" widget="progressbar"/>
                            <field name="health_status" widget="badge"
                                   decoration-success="health_status == 'green'"
                                   decoration-warning="health_status == 'yellow'"
                                   decoration-danger="health_status == 'red'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Scope / Work Packages" name="scope">
                            <field name="scope_summary"/>
                            <field name="scope_ids"/>
                        </page>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids"/>
                        </page>
                        <page string="Team" name="team">
                            <field name="member_ids"/>
                        </page>
                        <page string="Issues / Risks" name="issues">
                            <field name="issue_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="issue_type"/>
                                    <field name="priority" decoration-danger="priority == 'critical'"
                                           decoration-warning="priority == 'high'"/>
                                    <field name="owner_id"/>
                                    <field name="target_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Change Requests" name="change_requests">
                            <field name="change_request_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="requested_by"/>
                                    <field name="estimated_extra_hours"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes / Handover" name="notes">
                            <group>
                                <field name="project_summary"/>
                                <field name="implementation_method"/>
                                <field name="assumption_note"/>
                                <field name="exclusion_note"/>
                                <field name="risk_summary"/>
                                <field name="handover_note"/>
                                <field name="overall_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_dcg_project_delivery_search" model="ir.ui.view">
        <field name="name">dcg.project.delivery.search</field>
        <field name="model">dcg.project.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_code"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="project_manager_id"/>
                <separator/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="On Hold" name="filter_on_hold" domain="[('state', '=', 'on_hold')]"/>
                <filter string="UAT" name="filter_uat" domain="[('state', '=', 'uat')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="My Projects (PM)" name="filter_my_pm"
                        domain="[('project_manager_id', '=', uid)]"/>
                <filter string="Health: Red" name="filter_red"
                        domain="[('health_status', '=', 'red')]"/>
                <filter string="Health: Yellow" name="filter_yellow"
                        domain="[('health_status', '=', 'yellow')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="PM" name="group_pm" context="{'group_by': 'project_manager_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'project_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Health" name="group_health" context="{'group_by': 'health_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dcg_project_delivery" model="ir.actions.act_window">
        <field name="name">Delivery Projects</field>
        <field name="res_model">dcg.project.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first delivery project
            </p>
            <p>
                Projects are typically created from a contract using the "Create Project" button.
            </p>
        </field>
    </record>

</odoo>
