<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_project_member_list" model="ir.ui.view">
        <field name="name">dcg.project.member.list</field>
        <field name="model">dcg.project.member</field>
        <field name="arch" type="xml">
            <list string="Team Members" editable="bottom">
                <field name="user_id"/>
                <field name="employee_id" optional="show"/>
                <field name="role"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="allocation_percent"/>
                <field name="is_billable" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
