<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_contract_form_delivery" model="ir.ui.view">
        <field name="name">dcg.contract.form.delivery</field>
        <field name="model">dcg.contract</field>
        <field name="inherit_id" ref="dcg_contract_management.view_dcg_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_project" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        string="Create Project"
                        invisible="project_created or state not in ('approved', 'active', 'in_progress')"/>
                <button name="action_view_projects" type="object"
                        class="oe_stat_button" icon="fa-cogs"
                        invisible="not project_count">
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
