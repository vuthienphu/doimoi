<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Task Stage Tree View -->
    <record id="view_dcg_project_task_stage_tree" model="ir.ui.view">
        <field name="name">dcg.project.task.stage.tree</field>
        <field name="model">dcg.project.task.stage</field>
        <field name="arch" type="xml">
            <list string="Task Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_start"/>
                <field name="is_done"/>
                <field name="is_cancel"/>
                <field name="allow_timesheet"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <!-- Task Stage Form View -->
    <record id="view_dcg_project_task_stage_form" model="ir.ui.view">
        <field name="name">dcg.project.task.stage.form</field>
        <field name="model">dcg.project.task.stage</field>
        <field name="arch" type="xml">
            <form string="Task Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="is_start"/>
                            <field name="is_done"/>
                            <field name="is_cancel"/>
                            <field name="allow_timesheet"/>
                            <field name="fold"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <label for="description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Tag Tree View -->
    <record id="view_dcg_project_task_tag_tree" model="ir.ui.view">
        <field name="name">dcg.project.task.tag.tree</field>
        <field name="model">dcg.project.task.tag</field>
        <field name="arch" type="xml">
            <list string="Task Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Task Kanban View -->
    <record id="view_dcg_project_task_kanban" model="ir.ui.view">
        <field name="name">dcg.project.task.kanban</field>
        <field name="model">dcg.project.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="stage_id"/>
                <field name="color"/>
                <field name="kanban_state"/>
                <field name="priority"/>
                <field name="task_type"/>
                <field name="tag_ids"/>
                <field name="assignee_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record oe_semantic_color_#{record.color.raw_value} oe_kanban_card">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="code"/>: <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <t t-if="widget.editable"><a type="edit" class="dropdown-item">Edit</a></t>
                                            <t t-if="widget.deletable"><a type="delete" class="dropdown-item">Delete</a></t>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div>📁 <field name="project_id"/></div>
                                    <div t-if="record.scope_id.raw_value">🔧 <field name="scope_id"/></div>
                                    <div class="mt-1">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <field name="kanban_state" widget="state_selection" options="{'is_blocked': 'blocked', 'is_ready': 'ready'}"/>
                                        <span class="badge text-bg-secondary"><field name="task_type"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-if="record.planned_end.raw_value" class="me-2 text-danger">
                                            ⏰ <field name="planned_end" widget="remaining_days"/>
                                        </span>
                                        <span t-if="record.progress_percent.raw_value" class="badge text-bg-info">
                                            📊 <field name="progress_percent"/>%
                                        </span>
                                        <img t-att-src="kanban_image('res.users', 'avatar_128', record.assignee_id.raw_value)" t-att-title="record.assignee_id.value" t-att-alt="record.assignee_id.value" class="oe_kanban_avatar rounded-circle" width="24" height="24"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Task Tree View -->
    <record id="view_dcg_project_task_tree" model="ir.ui.view">
        <field name="name">dcg.project.task.tree</field>
        <field name="model">dcg.project.task</field>
        <field name="arch" type="xml">
            <list string="Tasks" decoration-danger="is_overdue == True">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="scope_id"/>
                <field name="task_type"/>
                <field name="assignee_id" widget="many2one_avatar_user"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'critical'" decoration-warning="priority == 'high'" decoration-info="priority == 'normal'" decoration-muted="priority == 'low'"/>
                <field name="planned_end"/>
                <field name="progress_percent" widget="progressbar"/>
                <field name="stage_id" widget="badge"/>
                <field name="kanban_state" widget="badge" decoration-danger="kanban_state == 'blocked'" decoration-success="kanban_state == 'ready'" decoration-muted="kanban_state == 'normal'"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Task Form View -->
    <record id="view_dcg_project_task_form" model="ir.ui.view">
        <field name="name">dcg.project.task.form</field>
        <field name="model">dcg.project.task</field>
        <field name="arch" type="xml">
            <form string="Project Task">
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done" class="oe_highlight" invisible="is_done == True or is_cancel == True"/>
                    <button name="action_cancel" type="object" string="Cancel Task" invisible="is_cancel == True or is_done == True"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Task Name..." readonly="is_cancel == True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="project_id" readonly="is_cancel == True"/>
                            <field name="scope_id" readonly="is_cancel == True"/>
                            <field name="milestone_id" readonly="is_cancel == True"/>
                            <field name="parent_id" readonly="is_cancel == True"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority" readonly="is_cancel == True"/>
                            <field name="kanban_state" widget="state_selection" readonly="is_cancel == True"/>
                            <field name="task_type" readonly="is_cancel == True"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="is_cancel == True"/>
                            <field name="color" readonly="is_cancel == True"/>
                            <field name="active" invisible="1"/>
                            <field name="is_done" invisible="1"/>
                            <field name="is_cancel" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Assignments">
                            <field name="assignee_id" widget="many2one_avatar_user" readonly="is_cancel == True"/>
                            <field name="assignee_ids" widget="many2many_tags" readonly="is_cancel == True"/>
                            <field name="reviewer_id" widget="many2one_avatar_user" readonly="is_cancel == True"/>
                        </group>
                        <group string="Planning &amp; Tracking">
                            <field name="planned_start" readonly="is_cancel == True"/>
                            <field name="planned_end" readonly="is_cancel == True"/>
                            <field name="actual_start"/>
                            <field name="actual_end"/>
                        </group>
                    </group>
                    <group>
                        <group string="Hours &amp; Effort">
                            <field name="planned_hours" readonly="is_cancel == True"/>
                            <field name="actual_hours"/>
                            <field name="remaining_hours"/>
                            <field name="progress_percent" readonly="is_cancel == True"/>
                            <field name="is_overdue"/>
                        </group>
                        <group string="Commercial Info">
                            <field name="is_billable" readonly="is_cancel == True"/>
                            <field name="charge_type" readonly="is_cancel == True"/>
                            <field name="partner_id"/>
                            <field name="contract_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="page_description" string="Description">
                            <group>
                                <field name="description" placeholder="Describe the task details..." widget="html" readonly="is_cancel == True"/>
                                <field name="acceptance_criteria" placeholder="Define acceptance criteria..." widget="html" readonly="is_cancel == True"/>
                            </group>
                        </page>
                        <page name="page_result" string="Result">
                            <group>
                                <field name="result_note" placeholder="Write execution results..." widget="html" readonly="is_cancel == True"/>
                                <field name="reject_reason" readonly="is_cancel == True" invisible="not reject_reason"/>
                            </group>
                        </page>
                        <page name="page_timesheets" string="Timesheets">
                            <field name="timesheet_line_ids" mode="list,kanban">
                                <list editable="bottom" string="Timesheet Activities">
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="name"/>
                                    <field name="unit_amount" string="Hours" sum="Total Hours"/>
                                </list>
                            </field>
                        </page>
                        <page name="page_subtasks" string="Sub-tasks">
                            <field name="child_task_ids" context="{'default_parent_id': id, 'default_project_id': project_id, 'default_scope_id': scope_id}">
                                <list string="Sub-tasks">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="assignee_id"/>
                                    <field name="planned_end"/>
                                    <field name="progress_percent"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="page_attachments" string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="is_cancel == True"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_dcg_project_task_search" model="ir.ui.view">
        <field name="name">dcg.project.task.search</field>
        <field name="model">dcg.project.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name" string="Task" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="project_id"/>
                <field name="scope_id"/>
                <field name="assignee_id"/>
                <field name="reviewer_id"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assignee_id', '=', uid)]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter string="BA / Analysis" name="type_ba" domain="[('task_type', '=', 'ba')]"/>
                <filter string="Development" name="type_dev" domain="[('task_type', '=', 'dev')]"/>
                <filter string="Testing / QA" name="type_qa" domain="[('task_type', '=', 'qa')]"/>
                <filter string="Code Review" name="type_review" domain="[('task_type', '=', 'review')]"/>
                <filter string="Deployment" name="type_deploy" domain="[('task_type', '=', 'deploy')]"/>
                <separator/>
                <filter string="Critical Priority" name="priority_critical" domain="[('priority', '=', 'critical')]"/>
                <filter string="High Priority" name="priority_high" domain="[('priority', '=', 'high')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Assignee" name="group_by_assignee" context="{'group_by': 'assignee_id'}"/>
                    <filter string="Task Type" name="group_by_type" context="{'group_by': 'task_type'}"/>
                    <filter string="Milestone" name="group_by_milestone" context="{'group_by': 'milestone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dcg_project_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">dcg.project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dcg_project_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
        </field>
    </record>

    <!-- My Tasks Action -->
    <record id="action_dcg_project_task_my" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">dcg.project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dcg_project_task_search"/>
        <field name="context">{'search_default_my_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks assigned to you.
            </p>
        </field>
    </record>

    <!-- Tasks by Project Action -->
    <record id="action_dcg_project_task_by_project" model="ir.actions.act_window">
        <field name="name">Tasks by Project</field>
        <field name="res_model">dcg.project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dcg_project_task_search"/>
        <field name="context">{'search_default_group_by_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
        </field>
    </record>

    <!-- Task Stage Action -->
    <record id="action_dcg_project_task_stage" model="ir.actions.act_window">
        <field name="name">Task Stages</field>
        <field name="res_model">dcg.project.task.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Task Tag Action -->
    <record id="action_dcg_project_task_tag" model="ir.actions.act_window">
        <field name="name">Task Tags</field>
        <field name="res_model">dcg.project.task.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
