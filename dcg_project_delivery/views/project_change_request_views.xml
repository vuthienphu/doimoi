<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_project_change_request_list" model="ir.ui.view">
        <field name="name">dcg.project.change.request.list</field>
        <field name="model">dcg.project.change.request</field>
        <field name="arch" type="xml">
            <list string="Change Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="request_date"/>
                <field name="requested_by"/>
                <field name="estimated_extra_hours" optional="show" sum="Total"/>
                <field name="estimated_value_delta" optional="show" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'implemented'"
                       decoration-info="state in ('approved', 'analysis')"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_project_change_request_form" model="ir.ui.view">
        <field name="name">dcg.project.change.request.form</field>
        <field name="model">dcg.project.change.request</field>
        <field name="arch" type="xml">
            <form string="Change Request">
                <header>
                    <button name="action_submit_analysis" type="object" string="Submit for Analysis"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'analysis'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'analysis'"/>
                    <button name="action_create_appendix" type="object" string="Create Appendix"
                            class="btn-primary" invisible="state != 'approved' or appendix_id"/>
                    <button name="action_mark_implemented" type="object" string="Mark Implemented"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('implemented', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,analysis,approved,implemented"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="scope_id"/>
                            <field name="request_date"/>
                            <field name="requested_by"/>
                            <field name="owner_id"/>
                        </group>
                        <group string="Estimated Impact">
                            <field name="estimated_extra_hours"/>
                            <field name="estimated_extra_cost"/>
                            <field name="estimated_value_delta"/>
                            <field name="new_target_end_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="appendix_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Impact Analysis" name="impact">
                            <field name="impact_scope"/>
                            <field name="impact_timeline"/>
                            <field name="impact_cost"/>
                        </page>
                        <page string="Decision" name="decision">
                            <field name="decision_note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dcg_project_change_request_search" model="ir.ui.view">
        <field name="name">dcg.project.change.request.search</field>
        <field name="model">dcg.project.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="requested_by"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Pending Analysis" name="filter_analysis" domain="[('state', '=', 'analysis')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_project_change_request" model="ir.actions.act_window">
        <field name="name">Change Requests</field>
        <field name="res_model">dcg.project.change.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
