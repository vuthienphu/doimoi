<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_todo" model="dcg.project.task.stage">
            <field name="name">To Do</field>
            <field name="sequence">1</field>
            <field name="is_start" eval="True"/>
            <field name="allow_timesheet" eval="False"/>
        </record>
        <record id="stage_in_progress" model="dcg.project.task.stage">
            <field name="name">In Progress</field>
            <field name="sequence">2</field>
            <field name="allow_timesheet" eval="True"/>
        </record>
        <record id="stage_in_review" model="dcg.project.task.stage">
            <field name="name">In Review</field>
            <field name="sequence">3</field>
            <field name="allow_timesheet" eval="True"/>
        </record>
        <record id="stage_done" model="dcg.project.task.stage">
            <field name="name">Done</field>
            <field name="sequence">4</field>
            <field name="is_done" eval="True"/>
            <field name="allow_timesheet" eval="False"/>
        </record>
        <record id="stage_cancelled" model="dcg.project.task.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">5</field>
            <field name="is_cancel" eval="True"/>
            <field name="fold" eval="True"/>
            <field name="allow_timesheet" eval="False"/>
        </record>
    </data>
</odoo>
