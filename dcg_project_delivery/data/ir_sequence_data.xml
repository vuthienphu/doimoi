<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dcg_project_delivery" model="ir.sequence">
            <field name="name">DCG Project Delivery</field>
            <field name="code">dcg.project.delivery</field>
            <field name="prefix">PRJ/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dcg_project_change_request" model="ir.sequence">
            <field name="name">DCG Change Request</field>
            <field name="code">dcg.project.change.request</field>
            <field name="prefix">CR/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dcg_project_task" model="ir.sequence">
            <field name="name">DCG Project Task</field>
            <field name="code">dcg.project.task</field>
            <field name="prefix">TSK/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
