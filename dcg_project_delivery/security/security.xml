<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_project_user" model="res.groups">
        <field name="name">DCG Delivery / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">PM / BA / delivery member: CRUD project, scope, milestone, issue, CR.</field>
    </record>
    <record id="group_dcg_project_manager" model="res.groups">
        <field name="name">DCG Delivery / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_project_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: close project, override state, quản lý toàn bộ.</field>
    </record>
</odoo>
