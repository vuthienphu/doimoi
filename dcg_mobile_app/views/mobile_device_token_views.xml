<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_device_token_list" model="ir.ui.view">
        <field name="name">mobile.device.token.list</field>
        <field name="model">mobile.device.token</field>
        <field name="arch" type="xml">
            <list string="Thiết bị đăng ký" decoration-muted="not is_active">
                <field name="user_id"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="last_login"/>
                <field name="login_count"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_device_token_form" model="ir.ui.view">
        <field name="name">mobile.device.token.form</field>
        <field name="model">mobile.device.token</field>
        <field name="arch" type="xml">
            <form string="Thông tin Thiết bị">
                <header>
                    <button name="action_activate" string="Kích hoạt lại" type="object" class="oe_highlight" invisible="is_active"/>
                    <button name="action_deactivate" string="Vô hiệu hóa" type="object" invisible="not is_active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Người dùng &amp; Thiết bị">
                            <field name="user_id"/>
                            <field name="device_name"/>
                            <field name="device_id"/>
                            <field name="platform"/>
                            <field name="app_version"/>
                        </group>
                        <group string="Trạng thái &amp; Token">
                            <field name="is_active"/>
                            <field name="last_login" readonly="1"/>
                            <field name="login_count"/>
                            <field name="token" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử đăng nhập">
                            <field name="login_history_ids" readonly="1">
                                <list string="Lịch sử">
                                    <field name="login_time"/>
                                    <field name="ip_address"/>
                                    <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'revoked'"/>
                                    <field name="failure_reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobile_device_token_search" model="ir.ui.view">
        <field name="name">mobile.device.token.search</field>
        <field name="model">mobile.device.token</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Thiết bị">
                <field name="user_id"/>
                <field name="device_name"/>
                <field name="device_id"/>
                <filter name="filter_active" string="Đang hoạt động" domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Đã vô hiệu hóa" domain="[('is_active', '=', False)]"/>
                <group>
                    <filter name="group_by_user" string="Người dùng" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_platform" string="Nền tảng" context="{'group_by': 'platform'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mobile_device_token" model="ir.actions.act_window">
        <field name="name">Thiết bị Đăng nhập</field>
        <field name="res_model">mobile.device.token</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobile_device_token_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có thiết bị nào đăng ký trên App.
            </p>
        </field>
    </record>
</odoo>
