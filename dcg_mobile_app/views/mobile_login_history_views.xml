<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mobile_login_history_list" model="ir.ui.view">
        <field name="name">mobile.login.history.list</field>
        <field name="model">mobile.login.history</field>
        <field name="arch" type="xml">
            <list string="Lịch sử Đăng nhập App" create="false" edit="false">
                <field name="login_time"/>
                <field name="user_id"/>
                <field name="email_attempted"/>
                <field name="device_name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="ip_address"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'failed'" decoration-warning="status == 'revoked'"/>
                <field name="failure_reason"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_login_history_search" model="ir.ui.view">
        <field name="name">mobile.login.history.search</field>
        <field name="model">mobile.login.history</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch sử">
                <field name="user_id"/>
                <field name="email_attempted"/>
                <field name="device_name"/>
                <field name="ip_address"/>
                <filter name="filter_success" string="Thành công" domain="[('status', '=', 'success')]"/>
                <filter name="filter_failed" string="Thất bại (Cảnh báo mail lạ)" domain="[('status', '=', 'failed')]"/>
                <group>
                    <filter name="group_by_user" string="Người dùng" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_status" string="Trạng thái" context="{'group_by': 'status'}"/>
                    <filter name="group_by_platform" string="Nền tảng" context="{'group_by': 'platform'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mobile_login_history" model="ir.actions.act_window">
        <field name="name">Lịch sử Đăng nhập App</field>
        <field name="res_model">mobile.login.history</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_mobile_login_history_search"/>
    </record>
</odoo>
