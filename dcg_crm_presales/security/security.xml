<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Groups                                                          -->
    <!-- ============================================================ -->
    <record id="group_dcg_presales_user" model="res.groups">
        <field name="name">DCG Presales / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">Sale/presales user: CRUD lead/requirement/scope/estimate/cost trong phạm vi mình phụ trách.</field>
    </record>

    <record id="group_dcg_presales_manager" model="res.groups">
        <field name="name">DCG Presales / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_presales_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: thấy toàn bộ deal/estimate/cost, có thể force chỉnh approved/current version.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record rules                                                    -->
    <!-- ============================================================ -->

    <!-- Requirement: theo lead mà user phụ trách -->
    <record id="rule_crm_requirement_user" model="ir.rule">
        <field name="name">CRM Requirement: scoped via lead ownership</field>
        <field name="model_id" ref="model_dcg_crm_requirement"/>
        <field name="domain_force">
            ['|', '|', '|',
                ('lead_id.user_id', '=', user.id),
                ('lead_id.presales_owner_id', '=', user.id),
                ('lead_id.presales_team_member_ids', 'in', [user.id]),
                ('owner_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('group_dcg_presales_user'))]"/>
    </record>

    <record id="rule_crm_requirement_manager" model="ir.rule">
        <field name="name">CRM Requirement: Manager sees all</field>
        <field name="model_id" ref="model_dcg_crm_requirement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dcg_presales_manager'))]"/>
    </record>

    <!-- Solution Scope: theo lead -->
