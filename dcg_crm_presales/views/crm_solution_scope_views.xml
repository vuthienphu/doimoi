<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_crm_solution_scope_list" model="ir.ui.view">
        <field name="name">dcg.crm.solution.scope.list</field>
        <field name="model">dcg.crm.solution.scope</field>
        <field name="arch" type="xml">
            <list string="Solution Scope" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="lead_id"/>
                <field name="name"/>
                <field name="service_catalog_id"/>
                <field name="scope_type"/>
                <field name="estimated_complexity"/>
                <field name="in_scope" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_crm_solution_scope_form" model="ir.ui.view">
        <field name="name">dcg.crm.solution.scope.form</field>
        <field name="model">dcg.crm.solution.scope</field>
        <field name="arch" type="xml">
            <form string="Solution Scope Item">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="requirement_id"/>
                            <field name="name"/>
                            <field name="service_catalog_id"/>
                        </group>
                        <group>
                            <field name="scope_type"/>
                            <field name="estimated_complexity"/>
                            <field name="in_scope"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Estimate Note" name="estimate_note">
                            <field name="estimated_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_crm_solution_scope_search" model="ir.ui.view">
        <field name="name">dcg.crm.solution.scope.search</field>
        <field name="model">dcg.crm.solution.scope</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="service_catalog_id"/>
                <filter string="In Scope" name="filter_in_scope" domain="[('in_scope', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Opportunity" name="group_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Scope Type" name="group_scope_type" context="{'group_by': 'scope_type'}"/>
                    <filter string="Complexity" name="group_complexity" context="{'group_by': 'estimated_complexity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_crm_solution_scope" model="ir.actions.act_window">
        <field name="name">Solution Scope</field>
        <field name="res_model">dcg.crm.solution.scope</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a solution scope item
            </p>
        </field>
    </record>

</odoo>
