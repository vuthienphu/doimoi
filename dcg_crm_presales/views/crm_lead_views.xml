<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Form: header buttons + button box + ownership fields           -->
    <!-- ============================================================ -->
    <record id="crm_lead_view_form_dcg_presales" model="ir.ui.view">
        <field name="name">crm.lead.form.dcg.presales</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Header: insert our buttons right before the stage_id statusbar,
                 and the approval_state badge right after it. -->
            <xpath expr="//field[@name='stage_id']" position="before">
                <button name="action_submit_approval" type="object"
                        string="Submit Deal Approval"
                        class="btn-primary"
                        invisible="approval_state == 'waiting' or type != 'opportunity'"/>
                <button name="action_view_approval_request" type="object"
                        string="View Approval"
                        invisible="not approval_request_id"/>
                <button name="action_create_quotation" type="object"
                        string="Create Quotation"
                        class="btn-primary"
                        invisible="not quotation_ready or quotation_id"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="approval_state" widget="statusbar"
                       invisible="type != 'opportunity'"/>
            </xpath>

            <!-- Smart buttons: button_box has 2 existing buttons (meeting, duplicates) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_requirements" type="object"
                        class="oe_stat_button" icon="fa-clipboard"
                        invisible="type != 'opportunity'">
                    <field name="requirement_count" widget="statinfo" string="Requirements"/>
                </button>
                <button name="action_view_solution_scope" type="object"
                        class="oe_stat_button" icon="fa-list-ul"
                        invisible="type != 'opportunity'">
                    <field name="solution_scope_count" widget="statinfo" string="Scope Items"/>
                </button>
                <button name="action_view_estimates" type="object"
                        class="oe_stat_button" icon="fa-calculator"
                        invisible="type != 'opportunity'">
                    <field name="estimate_count" widget="statinfo" string="Estimates"/>
                </button>
                <button name="action_view_presales_costs" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="type != 'opportunity'">
                    <field name="presales_cost_count" widget="statinfo" string="Presales Costs"/>
                </button>
                <button name="action_view_quotations" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="type != 'opportunity' or not quotation_count">
                    <field name="quotation_count" widget="statinfo" string="Quotations"/>
                </button>
            </xpath>

            <!-- Ownership: the opportunity-only group containing user_id + date_deadline + priority.
                 We anchor on date_deadline (unique in that group) to add our fields right after it,
                 inside the same <div class="o_lead_opportunity_form_inline_fields"> sibling area. -->
            <xpath expr="//div[hasclass('o_lead_opportunity_form_inline_fields')]" position="after">
                <field name="account_manager_id" invisible="type == 'lead'"/>
                <field name="presales_owner_id" invisible="type == 'lead'"/>
                <field name="presales_team_member_ids" widget="many2many_tags" invisible="type == 'lead'"/>
                <field name="lead_source_id" invisible="type == 'lead'"/>
                <field name="industry_id" invisible="type == 'lead'"/>
            </xpath>

            <!-- Extra notebook pages, added after the existing "Internal Notes" page -->
            <xpath expr="//page[@name='internal_notes']" position="after">

                <page string="Business Discovery" name="dcg_discovery"
                      invisible="type != 'opportunity'">
                    <group>
                        <field name="customer_need_summary"/>
                        <field name="pain_point"/>
                        <field name="business_goal"/>
                        <field name="current_system"/>
                    </group>
                    <group>
                        <field name="competitor_info"/>
                        <field name="risk_note"/>
                    </group>
                    <group>
                        <field name="decision_deadline"/>
                        <field name="expected_go_live_date"/>
                    </group>
                </page>

                <page string="Requirement Surveys" name="dcg_requirements"
                      invisible="type != 'opportunity'">
                    <field name="requirement_ids">
                        <list>
                            <field name="name"/>
                            <field name="survey_date"/>
                            <field name="owner_id"/>
                            <field name="version"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>

                <page string="Solution Scope" name="dcg_scope"
                      invisible="type != 'opportunity'">
                    <field name="solution_scope_summary"/>
                    <field name="solution_scope_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="service_catalog_id"/>
                            <field name="scope_type"/>
                            <field name="estimated_complexity"/>
                            <field name="in_scope" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>

                <page string="Estimates" name="dcg_estimates"
                      invisible="type != 'opportunity'">
                    <group>
                        <group string="Current Reference">
                            <field name="latest_estimate_id" readonly="1"/>
                            <field name="approved_estimate_id" readonly="1"/>
                        </group>
                        <group string="Summary">
                            <field name="estimated_revenue"/>
                            <field name="estimated_cost"/>
                            <field name="estimated_margin" readonly="1"/>
                            <field name="estimated_margin_rate" readonly="1" widget="percentage"/>
                            <field name="estimated_timeline_days"/>
                        </group>
                    </group>
                    <field name="estimate_ids">
                        <list>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="estimate_date"/>
                            <field name="estimated_revenue"/>
                            <field name="estimated_margin_rate" widget="percentage"/>
                            <field name="is_current_version" widget="boolean_toggle"/>
                            <field name="is_approved_version" widget="boolean_toggle"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>

                <page string="Presales Costs" name="dcg_costs"
                      invisible="type != 'opportunity'">
                    <group>
                        <field name="presales_cost_amount" readonly="1"/>
                    </group>
                    <field name="presales_cost_ids">
                        <list>
                            <field name="name"/>
                            <field name="expense_type_id"/>
                            <field name="expense_date"/>
                            <field name="amount"/>
                            <field name="billable_to_customer" widget="boolean_toggle"/>
                            <field name="state" widget="badge"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>

                <page string="Approval &amp; Quotation" name="dcg_approval_quotation"
                      invisible="type != 'opportunity'">
                    <group>
                        <group string="Approval">
                            <field name="deal_approval_required"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="approval_request_id" readonly="1"/>
                            <field name="deal_submit_note"/>
                        </group>
                        <group string="Quotation">
                            <field name="quotation_id" readonly="1"/>
                            <field name="quotation_ready" readonly="1"/>
                        </group>
                    </group>
                    <field name="handover_note"/>
                </page>

            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- List view: extend the forecast list (inherits crm_case_tree_view_oppor) -->
    <!-- We anchor on stage_id, which exists exactly once in that list. -->
    <!-- ============================================================ -->
    <record id="crm_lead_view_list_dcg_presales" model="ir.ui.view">
        <field name="name">crm.lead.list.dcg.presales</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="commercial_status" optional="show"/>
                <field name="account_manager_id" optional="hide"/>
                <field name="presales_owner_id" optional="hide"/>
                <field name="estimated_margin_rate" optional="hide" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search: filters and group by                                    -->
    <!-- ============================================================ -->
    <record id="crm_lead_view_search_dcg_presales" model="ir.ui.view">
        <field name="name">crm.lead.search.dcg.presales</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter string="Need Approval" name="filter_dcg_need_approval"
                        domain="[('deal_approval_required', '=', True), ('approval_state', 'in', ('draft', False))]"/>
                <filter string="Waiting Approval" name="filter_dcg_waiting_approval"
                        domain="[('approval_state', '=', 'waiting')]"/>
                <filter string="Low Margin (&lt;20%)" name="filter_dcg_low_margin"
                        domain="[('estimated_margin_rate', '&lt;', 20), ('estimated_margin_rate', '!=', 0)]"/>
                <filter string="Quoted" name="filter_dcg_quoted"
                        domain="[('commercial_status', '=', 'quoted')]"/>
            </xpath>
            <xpath expr="//filter[@name='salesperson']" position="after">
                <filter string="Account Manager" name="group_dcg_account_manager"
                        context="{'group_by': 'account_manager_id'}"/>
                <filter string="Presales Owner" name="group_dcg_presales_owner"
                        context="{'group_by': 'presales_owner_id'}"/>
                <filter string="Commercial Status" name="group_dcg_commercial_status"
                        context="{'group_by': 'commercial_status'}"/>
                <filter string="Industry" name="group_dcg_industry"
                        context="{'group_by': 'industry_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
