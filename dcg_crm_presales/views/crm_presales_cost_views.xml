<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_crm_presales_cost_list" model="ir.ui.view">
        <field name="name">dcg.crm.presales.cost.list</field>
        <field name="model">dcg.crm.presales.cost</field>
        <field name="arch" type="xml">
            <list string="Presales Costs" editable="bottom">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="expense_type_id"/>
                <field name="expense_date"/>
                <field name="amount" sum="Total"/>
                <field name="billable_to_customer" widget="boolean_toggle"/>
                <field name="state"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"
                       widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_crm_presales_cost_form" model="ir.ui.view">
        <field name="name">dcg.crm.presales.cost.form</field>
        <field name="model">dcg.crm.presales.cost</field>
        <field name="arch" type="xml">
            <form string="Presales Cost">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="name"/>
                            <field name="expense_type_id"/>
                        </group>
                        <group>
                            <field name="expense_date"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="billable_to_customer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_crm_presales_cost_search" model="ir.ui.view">
        <field name="name">dcg.crm.presales.cost.search</field>
        <field name="model">dcg.crm.presales.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="expense_type_id"/>
                <filter string="Billable" name="filter_billable" domain="[('billable_to_customer', '=', True)]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Opportunity" name="group_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Expense Type" name="group_expense_type" context="{'group_by': 'expense_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_crm_presales_cost" model="ir.actions.act_window">
        <field name="name">Presales Costs</field>
        <field name="res_model">dcg.crm.presales.cost</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a presales cost
            </p>
        </field>
    </record>

</odoo>
