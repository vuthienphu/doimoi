<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         button_box in base.view_partner_form is a self-closing empty
         div: <div class="oe_button_box" name="button_box"/>
         "position=inside" on a self-closing tag still inserts children. -->
    <record id="view_partner_form_dcg_presales" model="ir.ui.view">
        <field name="name">res.partner.form.dcg.presales</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_opportunities"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="not total_opportunity_count">
                    <field name="total_opportunity_count" widget="statinfo" string="Opportunities"/>
                </button>
                <button name="action_view_quotations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not total_quotation_count">
                    <field name="total_quotation_count" widget="statinfo" string="Quotations"/>
                </button>
            </xpath>

            <!-- category_id (Tags) sits in the right-hand <group> next to email/phone/website -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_company_customer"/>
                <field name="customer_code" invisible="not is_company_customer"/>
                <field name="partner_status" invisible="not is_company_customer"/>
                <field name="account_manager_id" invisible="not is_company_customer"/>
                <field name="industry_id" invisible="not is_company_customer"/>
                <field name="dcg_industry_id" invisible="not is_company_customer"/>
                <field name="source_id" invisible="not is_company_customer"/>
            </xpath>

            <!-- Add a dedicated notebook page after "Sales & Purchase" -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Customer Classification" name="dcg_classification"
                      invisible="not is_company_customer">
                    <group>
                        <group string="Classification">
                            <field name="customer_rank_level"/>
                            <field name="cooperation_status"/>
                            <field name="debt_risk_level"/>
                            <field name="support_level"/>
                        </group>
                        <group string="History">
                            <field name="last_presales_date"/>
                            <field name="last_contract_date"/>
                        </group>
                    </group>
                    <group string="Internal Note">
                        <field name="note_internal" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_dcg_presales" model="ir.ui.view">
        <field name="name">res.partner.list.dcg.presales</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="partner_status" optional="hide"/>
                <field name="account_manager_id" optional="hide"/>
                <field name="dcg_industry_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
