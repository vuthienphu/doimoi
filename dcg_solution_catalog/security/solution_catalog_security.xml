<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_solution_catalog" model="ir.module.category">
        <field name="name">Solution Catalog</field>
        <field name="description">Quản lý Danh mục Giải pháp &amp; Knowledge Base</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_solution_catalog" model="res.groups.privilege">
        <field name="name">Solution Catalog</field>
        <field name="category_id" ref="category_solution_catalog"/>
    </record>

    <record id="group_solution_catalog_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_solution_catalog"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_solution_catalog_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_solution_catalog"/>
        <field name="implied_ids" eval="[(4, ref('group_solution_catalog_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
