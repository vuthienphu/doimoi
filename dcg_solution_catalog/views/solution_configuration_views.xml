<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="solution_configuration_view_tree" model="ir.ui.view">
        <field name="name">solution.configuration.tree</field>
        <field name="model">solution.configuration</field>
        <field name="arch" type="xml">
            <list string="Cấu hình phân hệ" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="solution_configuration_view_form" model="ir.ui.view">
        <field name="name">solution.configuration.form</field>
        <field name="model">solution.configuration</field>
        <field name="arch" type="xml">
            <form string="Cấu hình phân hệ">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Mô tả">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="solution_configuration_action" model="ir.actions.act_window">
        <field name="name">Cấu hình phân hệ</field>
        <field name="res_model">solution.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
