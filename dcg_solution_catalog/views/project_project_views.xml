<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_solution" model="ir.ui.view">
        <field name="name">project.project.form.inherit.solution</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="solution_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Chọn các giải pháp triển khai..."/>
            </xpath>
        </field>
    </record>
</odoo>
