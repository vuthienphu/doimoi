<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_asset_checkout_list" model="ir.ui.view">
        <field name="name">dcg.asset.checkout.list</field>
        <field name="model">dcg.asset.checkout</field>
        <field name="arch" type="xml">
            <list string="Checkouts">
                <field name="name"/><field name="asset_id"/><field name="employee_id"/>
                <field name="purpose"/><field name="checkout_date"/><field name="expected_return"/>
                <field name="actual_return" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'checked_out'" decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_asset_checkout_form" model="ir.ui.view">
        <field name="name">dcg.asset.checkout.form</field>
        <field name="model">dcg.asset.checkout</field>
        <field name="arch" type="xml">
            <form string="Asset Checkout">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'draft'" groups="dcg_asset_it.group_dcg_asset_manager"/>
                    <button name="action_checkout" type="object" string="Check Out" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_return" type="object" string="Return" class="btn-primary" invisible="state != 'checked_out'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('returned','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,checked_out,returned"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name" readonly="1"/><field name="asset_id"/><field name="employee_id"/><field name="purpose"/></group>
                        <group><field name="checkout_date"/><field name="expected_return"/><field name="actual_return" readonly="1"/><field name="approver_id" readonly="1"/></group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_dcg_asset_checkout" model="ir.actions.act_window">
        <field name="name">Checkouts</field><field name="res_model">dcg.asset.checkout</field><field name="view_mode">list,form</field>
    </record>
</odoo>
