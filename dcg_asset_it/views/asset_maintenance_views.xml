<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_asset_maintenance_list" model="ir.ui.view">
        <field name="name">dcg.asset.maintenance.list</field>
        <field name="model">dcg.asset.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Log" editable="bottom">
                <field name="asset_id"/><field name="maintenance_date"/><field name="supplier"/>
                <field name="cost" sum="Total"/><field name="description" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_asset_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Log</field><field name="res_model">dcg.asset.maintenance</field><field name="view_mode">list,form</field>
    </record>
</odoo>
