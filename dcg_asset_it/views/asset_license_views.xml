<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_asset_license_list" model="ir.ui.view">
        <field name="name">dcg.asset.license.list</field>
        <field name="model">dcg.asset.license</field>
        <field name="arch" type="xml">
            <list string="Licenses">
                <field name="name"/><field name="license_key" optional="show" password="True"/>
                <field name="vendor_id" optional="show"/><field name="expiry_date"/>
                <field name="seat_count"/><field name="assigned_count"/><field name="available_seats"/>
                <field name="is_expired" widget="boolean" decoration-danger="is_expired"/>
                <field name="is_over_licensed" widget="boolean" decoration-danger="is_over_licensed" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_asset_license_form" model="ir.ui.view">
        <field name="name">dcg.asset.license.form</field>
        <field name="model">dcg.asset.license</field>
        <field name="arch" type="xml">
            <form string="License">
                <sheet>
                    <group>
                        <group><field name="name"/><field name="license_key" password="True"/><field name="vendor_id"/><field name="purchase_date"/><field name="expiry_date"/><field name="is_expired" readonly="1"/></group>
                        <group><field name="seat_count"/><field name="assigned_count" readonly="1"/><field name="available_seats" readonly="1"/><field name="is_over_licensed" readonly="1"/><field name="cost"/><field name="currency_id" invisible="1"/></group>
                    </group>
                    <separator string="Assigned Employees"/>
                    <field name="assigned_employee_ids" widget="many2many_tags"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dcg_asset_license" model="ir.actions.act_window">
        <field name="name">Licenses</field><field name="res_model">dcg.asset.license</field><field name="view_mode">list,form</field>
    </record>
</odoo>
