<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_asset" model="ir.ui.view">
        <field name="name">hr.employee.form.asset</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_assets" class="oe_stat_button" icon="fa-laptop"
                        invisible="not assigned_asset_count">
                    <field name="assigned_asset_count" widget="statinfo" string="Assets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
