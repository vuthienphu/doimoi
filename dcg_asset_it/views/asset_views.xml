<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_asset_kanban" model="ir.ui.view">
        <field name="name">dcg.asset.kanban</field>
        <field name="model">dcg.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="stage_id"/><field name="type_id"/>
                <templates>
                    <t t-name="card">
                        <field name="image" widget="image" options="{'preview_image': 'image'}" class="o_kanban_image"/>
                        <div>
                            <field name="name" class="fw-bold"/>
                            <field name="asset_code" class="text-muted"/>
                            <div><field name="type_id"/> — <field name="current_employee_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dcg_asset_list" model="ir.ui.view">
        <field name="name">dcg.asset.list</field>
        <field name="model">dcg.asset</field>
        <field name="arch" type="xml">
            <list string="Assets">
                <field name="asset_code"/><field name="name"/>
                <field name="type_id"/><field name="category_id" optional="show"/>
                <field name="serial_number" optional="show"/>
                <field name="brand" optional="show"/><field name="model_name" optional="show"/>
                <field name="current_employee_id"/>
                <field name="current_project_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="purchase_date" optional="hide"/>
                <field name="purchase_price" optional="hide"/>
                <field name="stage_id" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_asset_form" model="ir.ui.view">
        <field name="name">dcg.asset.form</field>
        <field name="model">dcg.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/><h1><field name="name"/></h1>
                        <field name="asset_code" readonly="1"/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="type_id"/><field name="category_id"/>
                            <field name="location_id"/>
                            <field name="serial_number"/><field name="barcode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Current Assignment">
                            <field name="current_employee_id" readonly="1"/>
                            <field name="current_project_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tech Specs" name="specs">
                            <group>
                                <group><field name="manufacturer"/><field name="brand"/><field name="model_name"/><field name="cpu"/><field name="ram"/><field name="storage"/></group>
                                <group><field name="mac_address"/><field name="ip_address"/><field name="operating_system"/></group>
                            </group>
                        </page>
                        <page string="Purchase" name="purchase">
                            <group>
                                <field name="purchase_date"/><field name="vendor_id"/>
                                <field name="purchase_price"/><field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Assignments" name="assignments">
                            <field name="assignment_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Warranties" name="warranties">
                            <field name="warranty_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Maintenance" name="maintenance">
                            <field name="maintenance_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Software" name="software">
                            <field name="software_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="Checkouts" name="checkouts">
                            <field name="checkout_ids" context="{'default_asset_id': id}"/>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_asset_search" model="ir.ui.view">
        <field name="name">dcg.asset.search</field>
        <field name="model">dcg.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="asset_code"/><field name="serial_number"/>
                <field name="type_id"/><field name="current_employee_id"/>
                <filter string="Available" name="filter_available" domain="[('current_employee_id', '=', False)]"/>
                <filter string="Assigned" name="filter_assigned" domain="[('current_employee_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Category" name="group_cat" context="{'group_by': 'category_id'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Location" name="group_loc" context="{'group_by': 'location_id'}"/>
                    <filter string="Employee" name="group_emp" context="{'group_by': 'current_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">dcg.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Register an asset</p></field>
    </record>

</odoo>
