<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_asset_location_list" model="ir.ui.view">
        <field name="name">dcg.asset.location.list</field>
        <field name="model">dcg.asset.location</field>
        <field name="arch" type="xml"><list string="Asset Locations" editable="bottom"><field name="code"/><field name="name"/><field name="address" optional="show"/></list></field>
