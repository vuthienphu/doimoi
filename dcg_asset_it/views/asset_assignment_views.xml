<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_asset_assignment_list" model="ir.ui.view">
        <field name="name">dcg.asset.assignment.list</field>
        <field name="model">dcg.asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Assignments" editable="bottom">
                <field name="asset_id"/><field name="employee_id"/><field name="project_id" optional="show"/>
                <field name="assigned_date"/><field name="returned_date"/>
                <field name="status" widget="badge" decoration-success="status == 'assigned'" decoration-muted="status == 'returned'" decoration-danger="status in ('lost','broken')"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_asset_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field><field name="res_model">dcg.asset.assignment</field><field name="view_mode">list,form</field>
    </record>
</odoo>
