<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Đồng bộ Phiếu hỗ trợ từ hệ thống phụ (5 phút 1 lần) -->
        <record id="cron_sync_external_tickets" model="ir.cron">
            <field name="name">Helpdesk: Đồng bộ Phiếu hỗ trợ</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_external_tickets()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- System Parameters (Khai báo sẵn key trong hệ thống, giá trị mặc định là False) -->
        <record id="param_external_api_base_url" model="ir.config_parameter">
            <field name="key">dcg_helpdesk.external_api_base_url</field>
            <field name="value">False</field>
        </record>

        <record id="param_external_api_db" model="ir.config_parameter">
            <field name="key">dcg_helpdesk.external_api_db</field>
            <field name="value">False</field>
        </record>

        <record id="param_external_api_login" model="ir.config_parameter">
            <field name="key">dcg_helpdesk.external_api_login</field>
            <field name="value">False</field>
        </record>

        <record id="param_external_api_password" model="ir.config_parameter">
            <field name="key">dcg_helpdesk.external_api_password</field>
            <field name="value">False</field>
        </record>

        <record id="param_external_api_enabled" model="ir.config_parameter">
            <field name="key">dcg_helpdesk.external_api_enabled</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
