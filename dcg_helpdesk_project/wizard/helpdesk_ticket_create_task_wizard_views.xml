<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_create_task_wizard_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.create.task.wizard.form</field>
        <field name="model">helpdesk.ticket.create.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Task từ Yêu cầu">
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="project_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="task_name"/>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung mô tả">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_task" string="Tạo Task" type="object" class="btn-primary"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
