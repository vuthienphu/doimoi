<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_zalo_channel_view_kanban" model="ir.ui.view">
        <field name="name">res.partner.zalo.channel.kanban</field>
        <field name="model">res.partner.zalo.channel</field>
        <field name="arch" type="xml">
            <kanban default_group_by="mapping_status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="mapping_status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2 border rounded">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title fs-6 text-primary">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="text-muted small mb-1">
                                <span>ID Kênh: </span><field name="channel_id"/>
                            </div>
                            <div class="mt-2">
                                <span class="fw-bold">Công ty / Partner: </span>
                                <field name="partner_id"/>
                            </div>
                            <div class="mt-1" t-if="record.project_id.raw_value">
                                <span class="fw-bold text-info">Dự án mặc định: </span>
                                <field name="project_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="res_partner_zalo_channel_view_tree" model="ir.ui.view">
        <field name="name">res.partner.zalo.channel.tree</field>
        <field name="model">res.partner.zalo.channel</field>
        <field name="arch" type="xml">
            <list string="Kênh Zalo" editable="bottom">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="mapping_status"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="res_partner_zalo_channel_view_form" model="ir.ui.view">
        <field name="name">res.partner.zalo.channel.form</field>
        <field name="model">res.partner.zalo.channel</field>
        <field name="arch" type="xml">
            <form string="Kênh Zalo">
                <sheet>
                    <group>
                        <group string="Thông tin Kênh">
                            <field name="name"/>
                            <field name="channel_id"/>
                        </group>
                        <group string="Liên kết Partner &amp; Dự án">
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="mapping_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_zalo_channel_action" model="ir.actions.act_window">
        <field name="name">Kênh Zalo Khách hàng</field>
        <field name="res_model">res.partner.zalo.channel</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
