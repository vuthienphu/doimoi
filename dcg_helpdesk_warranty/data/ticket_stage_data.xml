<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_new" model="dcg.warranty.ticket.stage">
            <field name="name">New</field>
            <field name="sequence">10</field>
            <field name="is_start" eval="True"/>
            <field name="sla_running" eval="True"/>
        </record>
        <record id="stage_assigned" model="dcg.warranty.ticket.stage">
            <field name="name">Assigned</field>
            <field name="sequence">20</field>
            <field name="sla_running" eval="True"/>
        </record>
        <record id="stage_investigating" model="dcg.warranty.ticket.stage">
            <field name="name">Investigating</field>
            <field name="sequence">30</field>
            <field name="sla_running" eval="True"/>
        </record>
        <record id="stage_waiting_customer" model="dcg.warranty.ticket.stage">
            <field name="name">Waiting Customer</field>
            <field name="sequence">40</field>
            <field name="pause_sla" eval="True"/>
            <field name="sla_running" eval="False"/>
        </record>
        <record id="stage_development" model="dcg.warranty.ticket.stage">
            <field name="name">Development</field>
            <field name="sequence">50</field>
            <field name="sla_running" eval="True"/>
        </record>
        <record id="stage_testing" model="dcg.warranty.ticket.stage">
            <field name="name">Testing</field>
            <field name="sequence">60</field>
            <field name="sla_running" eval="True"/>
        </record>
        <record id="stage_resolved" model="dcg.warranty.ticket.stage">
            <field name="name">Resolved</field>
            <field name="sequence">70</field>
            <field name="stop_sla" eval="True"/>
            <field name="sla_running" eval="False"/>
        </record>
        <record id="stage_closed" model="dcg.warranty.ticket.stage">
            <field name="name">Closed</field>
            <field name="sequence">80</field>
            <field name="is_done" eval="True"/>
            <field name="fold" eval="True"/>
            <field name="allow_edit" eval="False"/>
            <field name="sla_running" eval="False"/>
        </record>
        <record id="stage_cancelled" model="dcg.warranty.ticket.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">90</field>
            <field name="is_cancel" eval="True"/>
            <field name="fold" eval="True"/>
            <field name="allow_edit" eval="False"/>
            <field name="sla_running" eval="False"/>
        </record>
    </data>
</odoo>
