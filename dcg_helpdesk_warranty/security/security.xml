<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_warranty_user" model="res.groups">
        <field name="name">DCG Warranty / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
    </record>
    <record id="group_dcg_warranty_leader" model="res.groups">
        <field name="name">DCG Warranty / Leader</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_warranty_user'))]"/>
    </record>
    <record id="group_dcg_warranty_manager" model="res.groups">
        <field name="name">DCG Warranty / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_warranty_leader'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
