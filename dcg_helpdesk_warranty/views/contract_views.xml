<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_contract_form_warranty" model="ir.ui.view">
        <field name="name">dcg.contract.form.warranty</field>
        <field name="model">dcg.contract</field>
        <field name="inherit_id" ref="dcg_contract_management.view_dcg_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tickets" type="object"
                        class="oe_stat_button" icon="fa-life-ring"
                        invisible="not ticket_count">
                    <field name="ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
