<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_warranty_sla_list" model="ir.ui.view">
        <field name="name">dcg.warranty.sla.list</field>
        <field name="model">dcg.warranty.sla</field>
        <field name="arch" type="xml">
            <list string="SLA Policies" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="severity"/>
                <field name="priority"/>
                <field name="response_hours"/>
                <field name="resolve_hours"/>
                <field name="team_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_warranty_sla" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">dcg.warranty.sla</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
