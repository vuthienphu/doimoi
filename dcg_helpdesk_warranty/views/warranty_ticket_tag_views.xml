<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_warranty_ticket_tag_list" model="ir.ui.view">
        <field name="name">dcg.warranty.ticket.tag.list</field>
        <field name="model">dcg.warranty.ticket.tag</field>
        <field name="arch" type="xml">
            <list string="Ticket Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_warranty_ticket_tag" model="ir.actions.act_window">
        <field name="name">Ticket Tags</field>
        <field name="res_model">dcg.warranty.ticket.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
