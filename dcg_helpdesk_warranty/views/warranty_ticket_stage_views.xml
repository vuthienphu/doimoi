<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_warranty_ticket_stage_list" model="ir.ui.view">
        <field name="name">dcg.warranty.ticket.stage.list</field>
        <field name="model">dcg.warranty.ticket.stage</field>
        <field name="arch" type="xml">
            <list string="Ticket Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_start" widget="boolean_toggle"/>
                <field name="is_done" widget="boolean_toggle"/>
                <field name="is_cancel" widget="boolean_toggle"/>
                <field name="fold" widget="boolean_toggle"/>
                <field name="sla_running" widget="boolean_toggle"/>
                <field name="pause_sla" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_warranty_ticket_stage" model="ir.actions.act_window">
        <field name="name">Ticket Stages</field>
        <field name="res_model">dcg.warranty.ticket.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
