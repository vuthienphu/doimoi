<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_contract_close_wizard_form" model="ir.ui.view">
        <field name="name">dcg.contract.close.wizard.form</field>
        <field name="model">dcg.contract.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Contract">
                <group>
                    <field name="contract_id" readonly="1"/>
                </group>
                <group string="Close Note (optional)">
                    <field name="close_note" nolabel="1" placeholder="Final remarks before closing..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Close" class="btn-warning"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
