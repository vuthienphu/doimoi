<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_dcg_contract_user" model="res.groups">
        <field name="name">DCG Contract / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">Sales/PM/legal/ops: CRUD hợp đồng, phụ lục, thanh toán, nghiệm thu.</field>
    </record>

    <record id="group_dcg_contract_manager" model="res.groups">
        <field name="name">DCG Contract / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_contract_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: close contract, mark appendix effective, override.</field>
    </record>

</odoo>
