<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- List                                                            -->
    <!-- ============================================================ -->
    <record id="view_dcg_contract_list" model="ir.ui.view">
        <field name="name">dcg.contract.list</field>
        <field name="model">dcg.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts" sample="1" multi_edit="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="sign_date"/>
                <field name="effective_date" optional="show"/>
                <field name="amount_total" sum="Total"/>
                <field name="expected_margin_rate" widget="percentage" optional="hide"/>
                <field name="account_manager_id" optional="show"/>
                <field name="project_manager_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('active', 'done', 'closed')"
                       decoration-info="state in ('approved', 'in_progress')"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="approval_state" widget="badge" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form — 7 tabs per spec mục 76                                   -->
    <!-- ============================================================ -->
    <record id="view_dcg_contract_form" model="ir.ui.view">
        <field name="name">dcg.contract.form</field>
        <field name="model">dcg.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <!-- State actions -->
                    <button name="action_submit_approval" type="object" string="Submit Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_approval_request" type="object" string="View Approval"
                            invisible="not approval_request_id"/>
                    <button name="action_activate_contract" type="object" string="Activate Contract"
                            class="btn-primary" invisible="state != 'approved'"
                            confirm="Activate this contract?"/>
                    <button name="action_mark_in_progress" type="object" string="Mark In Progress"
                            invisible="state != 'active'"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_open_close_wizard" type="object" string="Close Contract"
                            invisible="state != 'done'"/>
                    <button name="action_cancel_contract" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancelled')"/>
                    <!-- Related actions -->
                    <button name="action_create_appendix" type="object" string="Create Appendix"
                            invisible="state not in ('active', 'in_progress')"/>
                    <button name="action_create_acceptance" type="object" string="Create Acceptance"
                            invisible="state not in ('active', 'in_progress', 'done')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved,active,in_progress,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appendices" type="object"
                                class="oe_stat_button" icon="fa-files-o"
                                invisible="not appendix_count">
                            <field name="appendix_count" widget="statinfo" string="Appendices"/>
                        </button>
                        <button name="action_view_acceptances" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="not acceptance_count">
                            <field name="acceptance_count" widget="statinfo" string="Acceptances"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Customer &amp; Source">
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="quotation_id"/>
                            <field name="estimate_id"/>
                            <field name="contract_type"/>
                        </group>
                        <group string="Ownership">
                            <field name="account_manager_id"/>
                            <field name="presales_owner_id"/>
                            <field name="project_manager_id"/>
                            <field name="delivery_owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Timeline">
                            <field name="sign_date"/>
                            <field name="effective_date"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="warranty_end_date"/>
                        </group>
                        <group string="Commercial">
                            <field name="amount_untaxed"/>
                            <field name="tax_amount"/>
                            <field name="amount_total"/>
                            <field name="expected_cost"/>
                            <field name="expected_margin" readonly="1"/>
                            <field name="expected_margin_rate" readonly="1" widget="percentage"/>
                            <field name="line_amount_total" readonly="1" string="Lines Subtotal"/>
                        </group>
                    </group>

                    <!-- Approval fields (from mixin) -->
                    <field name="approval_state" invisible="1"/>
                    <field name="approval_request_id" invisible="1"/>
                    <field name="approval_readonly" invisible="1"/>

                    <notebook>
                        <!-- Tab 1: Scope & Contract Lines -->
                        <page string="Scope &amp; Lines" name="scope_lines">
                            <field name="scope_summary" placeholder="Scope summary..."/>
                            <field name="line_ids" context="{'default_contract_id': id}"/>
                        </page>

                        <!-- Tab 2: Payment Schedule -->
                        <page string="Payment Schedule" name="payments">
                            <field name="payment_term_note"/>
                            <field name="payment_ids" context="{'default_contract_id': id}"/>
                            <field name="billing_note" placeholder="Billing note..."/>
                        </page>

                        <!-- Tab 3: Appendices -->
                        <page string="Appendices" name="appendices">
                            <field name="appendix_ids">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="appendix_type"/>
                                    <field name="appendix_date"/>
                                    <field name="value_delta"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 4: Acceptance -->
                        <page string="Acceptances" name="acceptances">
                            <field name="acceptance_ids">
                                <list create="false">
                                    <field name="name"/>
                                    <field name="acceptance_type"/>
                                    <field name="acceptance_date"/>
                                    <field name="payment_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 5: Legal / Notes -->
                        <page string="Legal &amp; Notes" name="legal_notes">
                            <group>
                                <field name="contract_summary"/>
                                <field name="assumption_note"/>
                                <field name="exclusion_note"/>
                                <field name="legal_note"/>
                                <field name="handover_note"/>
                                <field name="internal_note"/>
                            </group>
                        </page>

                        <!-- Tab 6: Documents -->
                        <page string="Documents" name="documents">
                            <group>
                                <group string="Signed Documents">
                                    <field name="signed_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                                <group string="Draft Documents">
                                    <field name="draft_attachment_ids" widget="many2many_binary" nolabel="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 7: Handover -->
                        <page string="Handover" name="handover">
                            <group>
                                <field name="handover_completed"/>
                                <field name="handover_date" invisible="not handover_completed"/>
                                <field name="contract_code"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search                                                          -->
    <!-- ============================================================ -->
    <record id="view_dcg_contract_search" model="ir.ui.view">
        <field name="name">dcg.contract.search</field>
        <field name="model">dcg.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_type"/>
                <field name="account_manager_id"/>
                <field name="project_manager_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="My Contracts (AM)" name="filter_my_am"
                        domain="[('account_manager_id', '=', uid)]"/>
                <filter string="My Contracts (PM)" name="filter_my_pm"
                        domain="[('project_manager_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Contract Type" name="group_type" context="{'group_by': 'contract_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Account Manager" name="group_am" context="{'group_by': 'account_manager_id'}"/>
                    <filter string="Project Manager" name="group_pm" context="{'group_by': 'project_manager_id'}"/>
                    <filter string="Signed Date" name="group_sign_date" context="{'group_by': 'sign_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Action                                                          -->
    <!-- ============================================================ -->
    <record id="action_dcg_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">dcg.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract
            </p>
            <p>
                Contracts are typically created from a quotation (sale order) or directly from a CRM opportunity.
            </p>
        </field>
    </record>

</odoo>
