<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_contract_payment_list" model="ir.ui.view">
        <field name="name">dcg.contract.payment.list</field>
        <field name="model">dcg.contract.payment</field>
        <field name="arch" type="xml">
            <list string="Payment Schedule" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="payment_type"/>
                <field name="percent" invisible="payment_type != 'percent'" sum="Total %"/>
                <field name="amount" sum="Total"/>
                <field name="due_date"/>
                <field name="amount_received" sum="Total Received"/>
                <field name="balance_amount" sum="Balance"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'partial'"
                       decoration-info="state == 'waiting'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_contract_payment_form" model="ir.ui.view">
        <field name="name">dcg.contract.payment.form</field>
        <field name="model">dcg.contract.payment</field>
        <field name="arch" type="xml">
            <form string="Payment Milestone">
                <header>
                    <button name="action_mark_waiting" type="object" string="Mark Waiting"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_partial" type="object" string="Mark Partial"
                            invisible="state not in ('waiting',)"/>
                    <button name="action_mark_paid" type="object" string="Mark Paid" class="btn-primary"
                            invisible="state not in ('waiting', 'partial')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,paid"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id" readonly="1"/>
                            <field name="name"/>
                            <field name="milestone_name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="payment_type"/>
                            <field name="percent" invisible="payment_type != 'percent'"/>
                            <field name="amount"/>
                            <field name="amount_received"/>
                            <field name="balance_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="due_date"/>
                            <field name="planned_invoice_date"/>
                            <field name="actual_received_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Condition" name="condition">
                            <field name="condition_note"/>
                        </page>
                        <page string="Invoice Note" name="invoice_note">
                            <field name="invoice_note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_contract_payment_search" model="ir.ui.view">
        <field name="name">dcg.contract.payment.search</field>
        <field name="model">dcg.contract.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <filter string="Waiting" name="filter_waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_contract_payment" model="ir.actions.act_window">
        <field name="name">Payment Schedules</field>
        <field name="res_model">dcg.contract.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
