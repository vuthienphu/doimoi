<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_contract_acceptance_list" model="ir.ui.view">
        <field name="name">dcg.contract.acceptance.list</field>
        <field name="model">dcg.contract.acceptance</field>
        <field name="arch" type="xml">
            <list string="Acceptances">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="acceptance_type"/>
                <field name="acceptance_date"/>
                <field name="payment_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_contract_acceptance_form" model="ir.ui.view">
        <field name="name">dcg.contract.acceptance.form</field>
        <field name="model">dcg.contract.acceptance</field>
        <field name="arch" type="xml">
            <form string="Contract Acceptance">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <button name="action_set_draft" type="object" string="Set to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="acceptance_type"/>
                            <field name="acceptance_date"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="payment_id"/>
                            <field name="appendix_id"/>
                            <field name="signed_by_customer"/>
                            <field name="signed_by_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="summary"/>
                        </page>
                        <page string="Result" name="result">
                            <field name="result_note"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_contract_acceptance_search" model="ir.ui.view">
        <field name="name">dcg.contract.acceptance.search</field>
        <field name="model">dcg.contract.acceptance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="acceptance_type"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'acceptance_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_contract_acceptance" model="ir.actions.act_window">
        <field name="name">Acceptances</field>
        <field name="res_model">dcg.contract.acceptance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
