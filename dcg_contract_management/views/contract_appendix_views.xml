<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_contract_appendix_list" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.list</field>
        <field name="model">dcg.contract.appendix</field>
        <field name="arch" type="xml">
            <list string="Appendices">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="appendix_type"/>
                <field name="appendix_date"/>
                <field name="value_delta" sum="Total"/>
                <field name="new_amount_total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'effective'"
                       decoration-info="state in ('approved', 'waiting_approval')"
                       decoration-muted="state == 'cancelled'"/>
                <field name="approval_state" widget="badge" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_contract_appendix_form" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.form</field>
        <field name="model">dcg.contract.appendix</field>
        <field name="arch" type="xml">
            <form string="Contract Appendix">
                <header>
                    <button name="action_submit_approval" type="object" string="Submit Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_approval_request" type="object" string="View Approval"
                            invisible="not approval_request_id"/>
                    <button name="action_mark_effective" type="object" string="Mark Effective"
                            class="btn-primary" invisible="state != 'approved'"
                            confirm="This will update the contract amounts and scope. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('effective', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved,effective"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="contract_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="appendix_type"/>
                            <field name="appendix_date"/>
                            <field name="effective_date"/>
                        </group>
                        <group string="Impact">
                            <field name="old_amount_total" readonly="1"/>
                            <field name="value_delta"/>
                            <field name="new_amount_total" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="old_end_date" readonly="1"/>
                            <field name="new_end_date"/>
                        </group>
                    </group>
                    <group string="Approval">
                        <field name="approval_state" readonly="1"/>
                        <field name="approval_request_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Summary" name="summary">
                            <field name="reason"/>
                            <field name="summary"/>
                        </page>
                        <page string="Change Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="change_type"/>
                                    <field name="contract_line_id" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount_delta" sum="Total"/>
                                    <field name="planned_start_date" optional="hide"/>
                                    <field name="planned_end_date" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_contract_appendix_search" model="ir.ui.view">
        <field name="name">dcg.contract.appendix.search</field>
        <field name="model">dcg.contract.appendix</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="appendix_type"/>
                <filter string="Effective" name="filter_effective" domain="[('state', '=', 'effective')]"/>
                <filter string="Waiting Approval" name="filter_waiting" domain="[('state', '=', 'waiting_approval')]"/>
                <group expand="0" string="Group By">
                    <filter string="Contract" name="group_contract" context="{'group_by': 'contract_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'appendix_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_contract_appendix" model="ir.actions.act_window">
        <field name="name">Appendices</field>
        <field name="res_model">dcg.contract.appendix</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
