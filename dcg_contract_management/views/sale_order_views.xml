<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- sale.order form: add smart button + Create Contract in button_box -->
    <record id="view_order_form_dcg_contract" model="ir.ui.view">
        <field name="name">sale.order.form.dcg.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_contract" type="object"
                        class="oe_stat_button" icon="fa-file-text"
                        string="Create Contract"
                        invisible="contract_created">
                </button>
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text"
                        invisible="not contract_count">
                    <field name="contract_count" widget="statinfo" string="Contracts"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- sale.order list: add contract_created optional column -->
    <record id="view_order_tree_dcg_contract" model="ir.ui.view">
        <field name="name">sale.order.list.dcg.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="contract_created" optional="hide" widget="boolean"/>
            </xpath>
        </field>
    </record>

</odoo>
