<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dcg_contract" model="ir.sequence">
            <field name="name">DCG Contract</field>
            <field name="code">dcg.contract</field>
            <field name="prefix">CTR/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dcg_contract_appendix" model="ir.sequence">
            <field name="name">DCG Contract Appendix</field>
            <field name="code">dcg.contract.appendix</field>
            <field name="prefix">APX/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dcg_contract_acceptance" model="ir.sequence">
            <field name="name">DCG Contract Acceptance</field>
            <field name="code">dcg.contract.acceptance</field>
            <field name="prefix">ACC/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
