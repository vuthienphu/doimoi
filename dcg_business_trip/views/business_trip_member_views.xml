<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_business_trip_member_list" model="ir.ui.view">
        <field name="name">dcg.business.trip.member.list</field>
        <field name="model">dcg.business.trip.member</field>
        <field name="arch" type="xml">
            <list string="Trip Members" editable="bottom">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="role"/>
                <field name="is_team_lead" widget="boolean_toggle"/>
                <field name="join_datetime" optional="show"/>
                <field name="leave_datetime" optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
