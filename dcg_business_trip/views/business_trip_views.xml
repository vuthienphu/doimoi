<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_business_trip_list" model="ir.ui.view">
        <field name="name">dcg.business.trip.list</field>
        <field name="model">dcg.business.trip</field>
        <field name="arch" type="xml">
            <list string="Business Trips" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="request_date"/>
                <field name="employee_id"/>
                <field name="project_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="destination_place"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="total_days" optional="show"/>
                <field name="estimated_cost" sum="Total"/>
                <field name="actual_cost" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('approved', 'in_progress')"
                       decoration-warning="state == 'waiting_approval'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_business_trip_form" model="ir.ui.view">
        <field name="name">dcg.business.trip.form</field>
        <field name="model">dcg.business.trip</field>
        <field name="arch" type="xml">
            <form string="Business Trip">
                <header>
                    <button name="action_submit_approval" type="object" string="Submit Approval"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_view_approval_request" type="object" string="View Approval"
                            invisible="not approval_request_id"/>
                    <button name="action_start_trip" type="object" string="Start Trip"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_sync_to_finance" type="object" string="Sync to Finance"
                            invisible="state != 'done' or not finance_id"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval,approved,in_progress,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                        <field name="name" readonly="1"/>
                    </div>

                    <group>
                        <group string="Requester">
                            <field name="requester_id"/>
                            <field name="employee_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Business Link">
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="scope_id"/>
                            <field name="milestone_id"/>
                            <field name="finance_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Classification">
                            <field name="trip_type"/>
                            <field name="trip_purpose"/>
                            <field name="work_type"/>
                            <field name="is_billable"/>
                            <field name="is_onsite"/>
                        </group>
                        <group string="Schedule">
                            <field name="request_date"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="total_days" readonly="1"/>
                            <field name="departure_place"/>
                            <field name="destination_place"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cost Summary">
                            <field name="estimated_cost" readonly="1"/>
                            <field name="actual_cost" readonly="1"/>
                            <field name="cost_variance" readonly="1"/>
                        </group>
                    </group>

                    <field name="approval_state" invisible="1"/>
                    <field name="approval_request_id" invisible="1"/>
                    <field name="approval_readonly" invisible="1"/>

                    <notebook>
                        <page string="Members" name="members">
                            <field name="member_ids"/>
                        </page>
                        <page string="Expenses" name="expenses">
                            <field name="expense_ids"
                                   context="{'default_trip_id': id}"/>
                        </page>
                        <page string="Objectives" name="objectives">
                            <field name="objective"/>
                            <field name="agenda"/>
                            <field name="expected_result"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="destination_address"/>
                            <field name="note_schedule"/>
                            <field name="internal_note"/>
                            <field name="cancel_reason" invisible="state != 'cancelled'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_business_trip_search" model="ir.ui.view">
        <field name="name">dcg.business.trip.search</field>
        <field name="model">dcg.business.trip</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="trip_type"/>
                <separator/>
                <filter string="My Trips" name="filter_my"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Project Trips" name="filter_project"
                        domain="[('project_id', '!=', False)]"/>
                <filter string="Internal" name="filter_internal"
                        domain="[('trip_type', '=', 'internal')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Trip Type" name="group_type" context="{'group_by': 'trip_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_business_trip" model="ir.actions.act_window">
        <field name="name">Business Trips</field>
        <field name="res_model">dcg.business.trip</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a business trip request</p>
        </field>
    </record>

</odoo>
