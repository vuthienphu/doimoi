<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_business_trip_expense_list" model="ir.ui.view">
        <field name="name">dcg.business.trip.expense.list</field>
        <field name="model">dcg.business.trip.expense</field>
        <field name="arch" type="xml">
            <list string="Trip Expenses" editable="bottom">
                <field name="expense_date"/>
                <field name="name"/>
                <field name="expense_category"/>
                <field name="source_type"/>
                <field name="expense_type_id" optional="show"/>
                <field name="member_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="finance_synced" widget="boolean" readonly="1" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="trip_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_business_trip_expense_form" model="ir.ui.view">
        <field name="name">dcg.business.trip.expense.form</field>
        <field name="model">dcg.business.trip.expense</field>
        <field name="arch" type="xml">
            <form string="Trip Expense">
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id" readonly="1"/>
                            <field name="name"/>
                            <field name="expense_category"/>
                            <field name="expense_type_id"/>
                            <field name="source_type"/>
                            <field name="member_id"/>
                        </group>
                        <group>
                            <field name="expense_date"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="vendor_name"/>
                            <field name="bill_reference"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="note"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                    <group string="Finance Trace" invisible="not finance_synced">
                        <field name="finance_cost_line_id" readonly="1"/>
                        <field name="finance_synced" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_business_trip_expense_search" model="ir.ui.view">
        <field name="name">dcg.business.trip.expense.search</field>
        <field name="model">dcg.business.trip.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="trip_id"/>
                <field name="expense_category"/>
                <filter string="Estimated" name="filter_estimated" domain="[('source_type', '=', 'estimated')]"/>
                <filter string="Actual" name="filter_actual" domain="[('source_type', '=', 'actual')]"/>
                <filter string="Synced" name="filter_synced" domain="[('finance_synced', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Trip" name="group_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'expense_category'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_business_trip_expense" model="ir.actions.act_window">
        <field name="name">Trip Expenses</field>
        <field name="res_model">dcg.business.trip.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
