<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_kanban_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.dcg.customize</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="sample">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="project_task_view_form_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.task.form.inherit.dcg.customize</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_draft" invisible="1"/>
                <field name="current_user_status" invisible="1"/>
                <field name="is_over_estimate" invisible="1"/>
                <field name="is_over_deadline" invisible="1"/>
                <field name="is_current_user_assignee" invisible="1"/>
                <button name="action_timer_start" type="object" string="Bắt đầu" class="btn-primary" 
                        invisible="not is_current_user_assignee or current_user_status != 'not_started'"/>
                <button name="action_timer_pause" type="object" string="Tạm dừng" class="btn-warning" 
                        invisible="not is_current_user_assignee or current_user_status != 'running'"/>
                <button name="action_timer_start" type="object" string="Tiếp tục" class="btn-success" 
                        invisible="not is_current_user_assignee or current_user_status != 'paused'"/>
                <button name="action_timer_stop" type="object" string="Kết thúc" class="btn-danger" 
                        invisible="not is_current_user_assignee or current_user_status not in ('running', 'paused')"/>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not is_over_estimate">
                    <strong>Cảnh báo:</strong> Thời gian thực tế đã vượt quá số giờ Estimate!
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="not is_over_deadline">
                    <strong>Quá hạn:</strong> Task này đã quá Deadline nhưng chưa hoàn thành!
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="readonly">not is_draft</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="reviewer_ids" widget="many2many_tags" string="Danh sách người kiểm tra" readonly="not is_draft"/>
                <field name="customer_company_id" invisible="1"/>
                <field name="request_date"/>
                <field name="requester_id"
                       domain="['|', ('parent_id', '=', partner_id), ('id', '=', partner_id), ('is_company', '=', False)]"
                       options="{'no_create': True}"
                       readonly="not is_draft"/>
                <field name="planned_finish_date" readonly="not is_draft"/>
                <field name="actual_finish_date" readonly="not is_draft"/>
                <field name="estimate_hours" widget="float_time" readonly="not is_draft"/>
                <field name="actual_hours" widget="float_time"/>
                <field name="over_deadline_reason" invisible="not over_deadline_reason"/>
            </xpath>
            <xpath expr="//page[@name='description_page']" position="after">
                <page name="dcg_checklist" string="Danh sách kiểm tra">
                    <field name="checklist_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="finish_date" readonly="1"/>
                            <field name="reviewer_id" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page name="dcg_work_logs" string="Lịch sử làm việc">
                    <field name="work_log_ids" nolabel="1" readonly="1">
                        <list decoration-success="is_running">
                            <field name="user_id"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" widget="float_time" sum="Total"/>
                            <field name="is_running" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
