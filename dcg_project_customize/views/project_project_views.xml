<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.project.form.inherit.dcg.customize</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id"/>
                <field name="survey_id" readonly="1"/>
                <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="manager_ids" widget="many2many_avatar_user" options="{'no_create': True}"/>
                <field name="eligible_external_user_ids" invisible="1"/>
                <field name="external_user_ids" widget="many2many_avatar_user"
                       string="Khách hàng/Nhà cung cấp được cấp quyền"
                       groups="project.group_project_manager"
                       domain="[('id', 'in', eligible_external_user_ids)]"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='settings']" position="before">
                <page name="dcg_handover" string="Tài liệu bàn giao">
                    <field name="handover_checklist_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="task_id" readonly="1"/>
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="handover_date" required="1"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_tree_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.project.tree.inherit.dcg.customize</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="member_ids" widget="many2many_tags" string="Thành viên tham gia" optional="show"/>
                <field name="stage_id" optional="show" widget="badge"/>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="default_group_by">stage_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_kanban_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.dcg.customize</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">stage_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tài khoản của bạn chưa được cấp quyền truy cập dự án nào.
            </p>
            <p>
                Vui lòng liên hệ người phụ trách của Đổi Mới để được hỗ trợ.
            </p>
        </field>
    </record>

    <record id="project.open_view_project_all_group_stage" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tài khoản của bạn chưa được cấp quyền truy cập dự án nào.
            </p>
            <p>
                Vui lòng liên hệ người phụ trách của Đổi Mới để được hỗ trợ.
            </p>
        </field>
    </record>
</odoo>
