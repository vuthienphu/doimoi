<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_view_form_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.project.form.inherit.dcg.customize</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_id"/>
                <field name="survey_id" readonly="1"/>
                <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//group//field[@name='label_tasks']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='settings']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='settings']" position="before">
                <page name="dcg_handover" string="Tài liệu bàn giao">
                    <field name="handover_checklist_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="project_project_view_tree_inherit_dcg_customize" model="ir.ui.view">
        <field name="name">project.project.tree.inherit.dcg.customize</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="member_ids" widget="many2many_tags" string="Thành viên tham gia" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
