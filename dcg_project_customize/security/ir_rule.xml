<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vô hiệu hóa các rule mặc định của module project để áp dụng chuẩn theo yêu cầu -->
    <function name="write" model="ir.rule">
        <function name="search" model="ir.rule">
            <value eval="[('id', 'in', [
                ref('project.project_public_members_rule', False),
                ref('project.task_visibility_rule', False),
                ref('project.task_visibility_rule_project_user', False),
                ref('project.project_manager_all_project_tasks_rule', False),
                ref('project.ir_rule_private_task', False)
            ])]"/>
        </function>
        <value eval="{'active': False}"/>
    </function>

    <data noupdate="0">
        <!-- ============================================================
             RULES CHO PROJECT (DỰ ÁN)
             ============================================================ -->

        <!-- Project: employees: following required for follower-only projects -->
        <record id="project_public_members_rule_custom" model="ir.rule">
            <field name="name">Project: employees: following required for follower-only projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[
                '|',
                    ('manager_ids', 'in', user.id),
                    ('member_ids.user_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Project: external users: assigned projects -->
        <record id="external_user_project_visibility_rule" model="ir.rule">
            <field name="name">Project: external users: assigned projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('external_user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('dcg_project_customize.group_external_project_user'))]"/>
        </record>

        <!-- ============================================================
             RULES CHO TASK (CÔNG VIỆC)
             ============================================================ -->

        <!-- Project/Task: project manager: see all tasks linked to a project or its own tasks -->
        <record id="project_manager_all_project_tasks_rule_custom" model="ir.rule">
            <field name="name">Project/Task: project manager: see all tasks linked to a project or its own tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', ('project_id', '!=', False),
                     ('user_ids', 'in', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>

        <!-- Project/Task: employees: Full access to own private task only -->
        <record id="task_visibility_rule_custom" model="ir.rule">
            <field name="name">Project/Task: employees: Full access to own private task only</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                    ('user_ids', 'in', user.id),
                    ('reviewer_ids', 'in', user.id),
                    ('user_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('reviewer_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('project_id.manager_ids', 'in', user.id),
                    ('project_id.user_id', '=', user.id),
                    ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Project/Task: system administrators: all tasks -->
        <record id="project_task_system_admin_all_rule" model="ir.rule">
            <field name="name">Project/Task: system administrators: all tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Project/Task: external users: all assigned project tasks -->
        <record id="external_user_task_visibility_rule" model="ir.rule">
            <field name="name">Project/Task: external users: all assigned project tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('project_id.external_user_ids', 'in', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('dcg_project_customize.group_external_project_user'))]"/>
        </record>
    </data>
</odoo>
