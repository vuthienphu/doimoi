<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cho phép ghi đè các rule mặc định của Odoo -->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'project'), ('name', 'in', ['project_public_members_rule', 'task_visibility_rule', 'task_visibility_rule_project_user', 'project_manager_all_project_tasks_rule'])]"/>
        </function>
        <value eval="{'noupdate': False}"/>
    </function>

    <data noupdate="0">
        <!-- Ghi đè Rule Project của Nhân sự: Chỉ người phụ trách dự án mới thấy dự án -->
        <record id="project.project_public_members_rule" model="ir.rule">
            <field name="name">Project: employees: custom visibility</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[
                '|',
                    ('manager_ids', 'in', user.id),
                    ('user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Ghi đè Rule Task của Nhân sự -->
        <record id="project.task_visibility_rule" model="ir.rule">
            <field name="name">Project/Task: employees: custom visibility</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                    ('user_ids', 'in', user.id),
                    ('reviewer_ids', 'in', user.id),
                    ('user_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('reviewer_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('project_id.manager_ids', 'in', user.id),
                    ('project_id.user_id', '=', user.id),
                    ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Ghi đè Rule Task của Project User -->
        <record id="project.task_visibility_rule_project_user" model="ir.rule">
            <field name="name">Project/Task: project users: custom visibility</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                    ('user_ids', 'in', user.id),
                    ('reviewer_ids', 'in', user.id),
                    ('user_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('reviewer_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('project_id.manager_ids', 'in', user.id),
                    ('project_id.user_id', '=', user.id),
                    ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

        <!-- Ghi đè Rule Task của Project Manager -->
        <record id="project.project_manager_all_project_tasks_rule" model="ir.rule">
            <field name="name">Project/Task: project manager: custom visibility</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                    ('user_ids', 'in', user.id),
                    ('reviewer_ids', 'in', user.id),
                    ('user_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('reviewer_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('project_id.manager_ids', 'in', user.id),
                    ('project_id.user_id', '=', user.id),
                    ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
        </record>

        <!-- Ghi đè ir_rule_private_task -->
        <record id="project.ir_rule_private_task" model="ir.rule">
            <field name="name">Project: See private tasks: custom visibility</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|', '|',
                    ('user_ids', 'in', user.id),
                    ('reviewer_ids', 'in', user.id),
                    ('user_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('reviewer_ids.employee_ids.parent_id.user_id', '=', user.id),
                    ('project_id.manager_ids', 'in', user.id),
                    ('project_id.user_id', '=', user.id),
                    ('message_partner_ids', 'in', [user.partner_id.id])
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Quản trị hệ thống cần đọc các task cấu hình kỹ thuật như task nghỉ phép. -->
        <record id="project_task_system_admin_all_rule" model="ir.rule">
            <field name="name">Project/Task: system administrators: all tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <!-- Rule riêng, không phụ thuộc trạng thái noupdate của rule chuẩn Odoo. -->
        <record id="external_user_project_visibility_rule" model="ir.rule">
            <field name="name">Project: external users: assigned projects</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('external_user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('dcg_project_customize.group_external_project_user'))]"/>
        </record>

        <record id="external_user_task_visibility_rule" model="ir.rule">
            <field name="name">Project/Task: external users: all assigned project tasks</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">[('project_id.external_user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('dcg_project_customize.group_external_project_user'))]"/>
        </record>
    </data>

    <!-- Khóa lại để bảo vệ rule -->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'project'), ('name', 'in', ['project_public_members_rule', 'task_visibility_rule', 'task_visibility_rule_project_user', 'project_manager_all_project_tasks_rule', 'ir_rule_private_task'])]"/>
        </function>
        <value eval="{'noupdate': True}"/>
    </function>
</odoo>
