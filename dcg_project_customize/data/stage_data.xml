<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="project_stage_expected" model="project.project.stage">
            <field name="name">Dự kiến</field>
            <field name="description">Dự án đã được xác định nhưng chưa bắt đầu triển khai</field>
            <field name="sequence">10</field>
        </record>
        
        <record id="project_stage_preparing" model="project.project.stage">
            <field name="name">Đang chuẩn bị</field>
            <field name="description">Đang chuẩn bị nhân sự, hồ sơ, kế hoạch, môi trường, thiết bị...</field>
            <field name="sequence">20</field>
        </record>

        <record id="project_stage_implementing" model="project.project.stage">
            <field name="name">Đang triển khai</field>
            <field name="sequence">30</field>
            <field name="description">Dự án đang thực hiện các công việc theo phạm vi Hợp đồng</field>
        </record>

        <record id="project_stage_waiting_acceptance" model="project.project.stage">
            <field name="name">Chờ nghiệm thu</field>
            <field name="sequence">40</field>
            <field name="description">Đã hoàn thành phần công việc chính, đang hoàn thiện hồ sơ/chờ nghiệm thu</field>
        </record>

        <record id="project_stage_accepted" model="project.project.stage">
            <field name="name">Đã nghiệm thu</field>
            <field name="sequence">50</field>
            <field name="description">Đã nghiệm thu/bàn giao theo phạm vi</field>
        </record>

        <record id="project_stage_done" model="project.project.stage">
            <field name="name">Hoàn thành</field>
            <field name="sequence">60</field>
            <field name="description">Dự án đã hoàn tất và không còn công việc triển khai chính</field>
            <field name="fold" eval="True"/>
        </record>

        <record id="project_stage_maintaining" model="project.project.stage">
            <field name="name">Đang bảo trì</field>
            <field name="sequence">70</field>
            <field name="description">Dự án đã hoàn thành nhưng đang trong thời gian bảo hành/bảo trì/hỗ trợ</field>
        </record>

        <record id="project_stage_paused" model="project.project.stage">
            <field name="name">Tạm dừng</field>
            <field name="sequence">80</field>
            <field name="description">Dự án tạm thời không triển khai</field>
            <field name="fold" eval="True"/>
        </record>

        <record id="project_stage_cancelled" model="project.project.stage">
            <field name="name">Hủy</field>
            <field name="sequence">90</field>
            <field name="description">Dự án không tiếp tục thực hiện</field>
            <field name="fold" eval="True"/>
        </record>
    </data>

    <record id="task_stage_todo" model="project.task.type">
        <field name="name">Cần làm</field>
        <field name="sequence">10</field>
        <field name="active">True</field>
        <field name="is_draft">True</field>
        <field name="is_dcg_default">True</field>
    </record>
    <record id="task_stage_processing" model="project.task.type">
        <field name="name">Đang làm</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
        <field name="is_processing">True</field>
        <field name="is_dcg_default">True</field>
    </record>
    <record id="task_stage_testing" model="project.task.type">
        <field name="name">Chuyển test</field>
        <field name="sequence">30</field>
        <field name="active">True</field>
        <field name="is_test">True</field>
        <field name="is_dcg_default">True</field>
    </record>
    <record id="task_stage_done" model="project.task.type">
        <field name="name">Hoàn thành</field>
        <field name="sequence">40</field>
        <field name="active">True</field>
        <field name="is_done">True</field>
        <field name="is_dcg_default">True</field>
    </record>
    <record id="task_stage_live" model="project.task.type">
        <field name="name">Đã đưa lên Live</field>
        <field name="sequence">50</field>
        <field name="active">True</field>
        <field name="is_live">True</field>
        <field name="is_dcg_default">True</field>
    </record>
    <function model="project.task.type" name="_dcg_cleanup_duplicate_stages"/>
    <function model="project.task.type" name="_dcg_cleanup_non_standard_project_stages"/>
    <function model="project.project" name="_dcg_assign_all_stages_to_all_projects"/>
    <function model="project.project.stage" name="_dcg_open_all_project_stages"/>
</odoo>
