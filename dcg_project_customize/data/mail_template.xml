<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_processing_notify" model="mail.template">
        <field name="name">Email: Đang thực hiện</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Đang thực hiện</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang được thực hiện.</p>
                <p>Nhân sự thực hiện: <t t-out="', '.join(object.user_ids.mapped('name')) or ''"/></p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_test_notify" model="mail.template">
        <field name="name">Email: Chờ kiểm tra</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Cần kiểm tra</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang chờ kiểm tra.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_done_notify" model="mail.template">
        <field name="name">Email: Hoàn thành</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Đã hoàn thành</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đã hoàn thành.</p>
                <p>Vui lòng đưa công việc lên môi trường Live.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_processing" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Đang thực hiện</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Đang thực hiện</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang thực hiện. Vui lòng cập nhật tiến độ.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_test" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Chờ kiểm tra</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Chờ kiểm tra</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang chờ kiểm tra. Vui lòng kiểm tra công việc.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_done_not_live" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Hoàn thành chưa lên Live</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Chưa lên Live</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đã hoàn thành nhưng chưa lên Live.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
