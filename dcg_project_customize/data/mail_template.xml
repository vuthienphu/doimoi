<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_processing_notify" model="mail.template">
        <field name="name">Email: Đang làm</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - {{ object.stage_id.name }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px;">
                <ul>
                    <li><strong>Tên Task:</strong> <t t-out="object.name"/></li>
                    <li><strong>Trạng thái hiện tại:</strong> <t t-out="object.stage_id.name"/></li>
                    <li><strong>Nhân sự được assign:</strong> <t t-out="', '.join(object.user_ids.mapped('name')) if object.user_ids else ''"/></li>
                    <li><strong>Project:</strong> <t t-out="object.project_id.name if object.project_id else ''"/></li>
                    <li><strong>Customer:</strong> <t t-out="object.partner_id.name if object.partner_id else ''"/></li>
                    <li><strong>Deadline:</strong> <t t-out="object.date_deadline.strftime('%d/%m/%Y') if object.date_deadline else ''"/></li>
                </ul>
                <div style="margin-top: 20px;">
                    <a t-att-href="object._get_task_url()" style="padding: 10px 20px; background-color: #875A7B; color: #ffffff; text-decoration: none; border-radius: 4px; display: inline-block;">Mở công việc</a>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

