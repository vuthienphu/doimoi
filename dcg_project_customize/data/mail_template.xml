<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_processing_notify" model="mail.template">
        <field name="name">Email: Đang làm</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Đang làm</field>
        <field name="body_html" type="html">
            <div>
                <p>Task <strong><t t-out="object.name"/></strong> chuyển qua trạng thái <strong>Đang làm</strong>. Vui lòng truy cập <a t-att-href="object._get_task_url()">tại đây</a> để kiểm tra.</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_test_notify" model="mail.template">
        <field name="name">Email: Chuyển test</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Cần kiểm tra</field>
        <field name="body_html" type="html">
            <div>
                <p>Task <strong><t t-out="object.name"/></strong> chuyển qua trạng thái <strong>Cần kiểm tra</strong>. Vui lòng truy cập <a t-att-href="object._get_task_url()">tại đây</a> để kiểm tra.</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_done_notify" model="mail.template">
        <field name="name">Email: Hoàn thành</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Task] {{ object.name }} - Đã hoàn thành</field>
        <field name="body_html" type="html">
            <div>
                <p>Task <strong><t t-out="object.name"/></strong> chuyển qua trạng thái <strong>Hoàn thành</strong>. Vui lòng truy cập <a t-att-href="object._get_task_url()">tại đây</a> để kiểm tra.</p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_processing" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Đang làm</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Đang làm</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang làm. Vui lòng cập nhật tiến độ.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_test" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Chuyển test</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Chuyển test</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đang chuyển test. Vui lòng kiểm tra công việc.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="task_reminder_done_not_live" model="mail.template">
        <field name="name">Nhắc việc hàng ngày: Hoàn thành chưa lên Live</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="email_from">{{ object._get_mail_from() }}</field>
        <field name="subject">[Nhắc việc] {{ object.name }} - Chưa lên Live</field>
        <field name="body_html" type="html">
            <div>
                <p>Công việc <strong><t t-out="object.name"/></strong> đã hoàn thành nhưng chưa lên Live.</p>
                <p><a t-att-href="object._get_task_url()">Mở công việc</a></p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
