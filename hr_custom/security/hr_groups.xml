<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
    </record>

    <!-- Cho CEO thấy menu private "Employees" (hr.employee) thay vì chỉ Directory (public).
         (4, id) = thêm CEO, giữ nguyên group HRM sẵn có. -->
    <record id="hr.menu_hr_employee_payroll" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>

    <!-- Cho HRM và CEO thấy menu "Configuration" của module Employees. -->
    <record id="hr.menu_human_resources_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>

    <!-- Các menu cấu hình trong "Configuration > Recruitment" cần cho HRM + CEO thấy
         (trước đây chỉ C&B / thiếu CEO). Cấp HRM (hr.group_hr_user) đã bao gồm C&B
         vì C&B implies HRM. -->
    <!-- Vị trí công việc -->
    <record id="hr.menu_view_hr_job" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>
    <!-- Level -->
    <record id="hr_level.hr_level_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>
    <!-- Mẫu hợp đồng (core chỉ cấp C&B) -->
    <record id="hr.menu_hr_employee_contract_templates" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>
    <!-- Loại việc làm / Employment Type (core để active=0 → bật lại + thêm CEO) -->
    <record id="hr.menu_view_hr_contract_type" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="group_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_custom.group_hr_ceo'))]"/>
    </record>

    <data context="{'lang': 'vi_VN'}">
        <function model="res.groups" name="write">
            <value eval="[ref('hr.group_hr_user')]"/>
            <value eval="{'name': 'HRM'}"/>
        </function>

        <function model="res.groups" name="write">
            <value eval="[ref('hr.group_hr_manager')]"/>
            <value eval="{'name': 'C&amp;B'}"/>
        </function>
    </data>
</odoo>
