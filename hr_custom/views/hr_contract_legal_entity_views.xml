<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_hr_contract_legal_entity" model="ir.actions.act_window">
        <field name="name">Pháp nhân ký hợp đồng</field>
        <field name="res_model">hr.contract.legal.entity</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hr_contract_legal_entity_list" model="ir.ui.view">
        <field name="name">hr.contract.legal.entity.list</field>
        <field name="model">hr.contract.legal.entity</field>
        <field name="arch" type="xml">
            <list string="Pháp nhân ký hợp đồng" editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_legal_entity_form" model="ir.ui.view">
        <field name="name">hr.contract.legal.entity.form</field>
        <field name="model">hr.contract.legal.entity</field>
        <field name="arch" type="xml">
            <form string="Pháp nhân ký hợp đồng">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_hr_contract_legal_entity"
              name="Pháp nhân ký hợp đồng"
              parent="hr.menu_config_recruitment"
              action="action_hr_contract_legal_entity"
              groups="hr.group_hr_user,hr_custom.group_hr_ceo"
              sequence="11"/>

</odoo>
