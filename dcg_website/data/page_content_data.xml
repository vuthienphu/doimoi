    <record id="item_timeline_5" model="doimoi.page.item"><field name="section_id" ref="section_about_timeline"/><field name="title">2024</field><field name="subtitle">DCG-MIS 4.0 với AI-assisted analytics và tích hợp IoT mở rộng</field><field name="sequence">50</field></record>

