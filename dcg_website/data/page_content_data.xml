        <field name="secondary_body"><![CDATA[<p>Đội ngũ của chúng tôi gồm cả kỹ sư công nghiệp lẫn kỹ sư phần mềm — sự kết hợp giúp chúng tôi xây dựng giải pháp thực sự phù hợp với thực tế vận hành.</p>]]></field>
        <field name="sequence">10</field><field name="is_published" eval="True"/>
    </record>
