    <record id="item_value_3" model="doimoi.page.item"><field name="section_id" ref="section_about_mission"/><field name="icon">🔧</field><field name="title">Linh hoạt</field><field name="subtitle">Giải pháp tùy chỉnh theo đặc thù từng doanh nghiệp</field><field name="theme">blue</field><field name="sequence">30</field></record>
    <record id="item_value_4" model="doimoi.page.item"><field name="section_id" ref="section_about_mission"/><field name="icon">📈</field><field name="title">Kết quả</field><field name="subtitle">Đo lường hiệu quả bằng số liệu cụ thể, không mơ hồ</field><field name="theme">purple</field><field name="sequence">40</field></record>

