    <record id="item_timeline_2" model="doimoi.page.item"><field name="section_id" ref="section_about_timeline"/><field name="title">2013</field><field name="subtitle">Ra mắt phiên bản đầu tiên của DCG-MIS, triển khai tại 3 nhà máy nhiệt điện</field><field name="sequence">20</field></record>
    <record id="item_timeline_3" model="doimoi.page.item"><field name="section_id" ref="section_about_timeline"/><field name="title">2017</field><field name="subtitle">Mở rộng sang phát triển phần mềm theo yêu cầu và triển khai Odoo ERP</field><field name="sequence">30</field></record>
