<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doimoi_client_tree" model="ir.ui.view">
        <field name="name">doimoi.client.tree</field>
        <field name="model">doimoi.client</field>
        <field name="arch" type="xml">
            <list string="Khách hàng">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="industry"/>
                <field name="website_url"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_doimoi_client_form" model="ir.ui.view">
        <field name="name">doimoi.client.form</field>
        <field name="model">doimoi.client</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên khách hàng..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="short_name"/>
                            <field name="website_id"/>
                            <field name="partner_id"/>
                            <field name="industry"/>
                            <field name="website_url" widget="url"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_doimoi_client" model="ir.actions.act_window">
        <field name="name">Khách hàng tiêu biểu</field>
        <field name="res_model">doimoi.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
