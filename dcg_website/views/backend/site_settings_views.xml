<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doimoi_site_settings_list" model="ir.ui.view">
        <field name="name">doimoi.site.settings.list</field><field name="model">doimoi.site.settings</field>
        <field name="arch" type="xml">
            <list string="Header &amp; Footer theo website">
                <field name="name"/>
                <field name="website_id"/>
            </list>
        </field>
    </record>
    <record id="view_doimoi_site_settings_form" model="ir.ui.view">
        <field name="name">doimoi.site.settings.form</field><field name="model">doimoi.site.settings</field>
        <field name="arch" type="xml">
            <form string="Cấu hình Header &amp; Footer"><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div><group><field name="website_id"/></group>
                <notebook>
                    <page string="Header">
                        <group string="Logo Header">
                            <field name="header_logo" widget="image" options="{'size': [400, 150]}"/>
                            <div class="text-muted">Tải ảnh lên để dùng logo riêng. Để trống để sử dụng logo Website.</div>
                        </group>
                        <group><group string="Nhãn menu"><field name="home_label"/><field name="solutions_label"/><field name="industries_label"/><field name="about_label"/><field name="contact_label"/></group><group string="Đường dẫn"><field name="home_url"/><field name="solutions_url"/><field name="industries_url"/><field name="about_url"/><field name="contact_url"/></group></group>
                        <group string="Nút hành động"><field name="header_cta_label"/><field name="header_cta_url"/></group>
                    </page>
                    <page string="Footer">
                        <group string="Logo Footer">
                            <field name="footer_logo" widget="image" options="{'size': [400, 150]}"/>
                            <div class="text-muted">Tải ảnh lên để dùng logo riêng. Để trống để sử dụng logo Website.</div>
                        </group>
                        <group><group><field name="footer_description"/><field name="address"/><field name="location"/></group><group><field name="phone"/><field name="email"/><field name="website_url"/></group></group>
                        <group string="Mạng xã hội"><field name="facebook_url"/><field name="linkedin_url"/><field name="youtube_url"/></group>
                        <group string="Dòng cuối"><group><field name="copyright_name"/></group><group><field name="privacy_label"/><field name="privacy_url"/><field name="terms_label"/><field name="terms_url"/></group></group>
                    </page>
                </notebook>
            </sheet></form>
        </field>
    </record>
    <record id="action_doimoi_site_settings" model="ir.actions.act_window"><field name="name">Header &amp; Footer</field><field name="res_model">doimoi.site.settings</field><field name="view_mode">list,form</field></record>
</odoo>
