<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doimoi_page_section_list" model="ir.ui.view">
        <field name="name">doimoi.page.section.list</field>
        <field name="model">doimoi.page.section</field>
        <field name="arch" type="xml">
            <list string="Nội dung trang">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id" optional="show"/>
                <field name="page"/>
                <field name="key"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_doimoi_page_section_form" model="ir.ui.view">
        <field name="name">doimoi.page.section.form</field>
        <field name="model">doimoi.page.section</field>
        <field name="arch" type="xml">
            <form string="Nội dung trang">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="page"/>
                            <field name="website_id"/>
                            <field name="key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="eyebrow"/>
                            <field name="title"/>
                            <field name="subtitle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung">
                            <field name="body" widget="html"/>
                            <field name="secondary_body" widget="html"/>
                        </page>
                        <page string="Nút hành động">
                            <group>
                                <field name="button_label"/>
                                <field name="button_url" widget="url"/>
                            </group>
                        </page>
                        <page string="Danh sách mục">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image"/>
                                    <field name="icon"/>
                                    <field name="title"/>
                                    <field name="subtitle"/>
                                    <field name="item_group"/>
                                    <field name="meta"/>
                                    <field name="theme"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_doimoi_page_section" model="ir.actions.act_window">
        <field name="name">Nội dung các trang</field>
        <field name="res_model">doimoi.page.section</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
