<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doimoi_project_list" model="ir.ui.view"><field name="name">doimoi.project.list</field><field name="model">doimoi.project</field><field name="arch" type="xml">
        <list string="Dự án tiêu biểu"><field name="sequence" widget="handle"/><field name="image" widget="image"/><field name="name"/><field name="website_id" optional="show"/><field name="client_name"/><field name="industry_id"/><field name="is_featured" widget="boolean_toggle"/><field name="is_published" widget="boolean_toggle"/></list>
    </field></record>
    <record id="view_doimoi_project_form" model="ir.ui.view"><field name="name">doimoi.project.form</field><field name="model">doimoi.project</field><field name="arch" type="xml">
        <form string="Dự án tiêu biểu"><sheet><field name="image" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="website_id"/><field name="client_name"/><field name="industry_id"/><field name="project_url" widget="url"/></group><group><field name="sequence"/><field name="is_featured" widget="boolean_toggle"/><field name="is_published" widget="boolean_toggle"/></group></group><group><field name="summary"/><field name="result"/></group></sheet><chatter/></form>
    </field></record>
    <record id="action_doimoi_project" model="ir.actions.act_window"><field name="name">Dự án tiêu biểu</field><field name="res_model">doimoi.project</field><field name="view_mode">list,form</field></record>
</odoo>
