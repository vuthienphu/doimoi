<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_doimoi_hero_list" model="ir.ui.view">
        <field name="name">doimoi.hero.list</field>
        <field name="model">doimoi.hero</field>
        <field name="arch" type="xml">
            <list string="Banner và CTA">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [96, 64]}"/>
                <field name="name"/>
                <field name="website_id" optional="show"/>
                <field name="page"/>
                <field name="title"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_doimoi_hero_form" model="ir.ui.view">
        <field name="name">doimoi.hero.form</field>
        <field name="model">doimoi.hero</field>
        <field name="arch" type="xml">
            <form string="Banner và CTA">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="page"/>
                            <field name="website_id"/>
                            <field name="eyebrow"/>
                            <field name="title"/>
                            <field name="highlighted_text"/>
                            <field name="subtitle"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ảnh banner">
                            <field name="visual_mode" widget="radio"/>
                            <field name="image" widget="image" options="{'preview_image': 'image', 'size': [800, 600]}"/>
                        </page>
                        <page string="Dashboard minh họa">
                            <group>
                                <group><field name="dashboard_eyebrow"/><field name="dashboard_title"/><field name="chart_title"/><field name="status_1"/><field name="status_2"/></group>
                                <group string="KPI 1"><field name="metric_1_label"/><field name="metric_1_value"/><field name="metric_1_trend"/></group>
                                <group string="KPI 2"><field name="metric_2_label"/><field name="metric_2_value"/><field name="metric_2_trend"/></group>
                                <group string="KPI 3"><field name="metric_3_label"/><field name="metric_3_value"/><field name="metric_3_trend"/></group>
                            </group>
                        </page>
                        <page string="Nút hành động">
                            <group>
                                <group string="Nút chính"><field name="primary_button_label"/><field name="primary_button_url" widget="url"/></group>
                                <group string="Nút phụ"><field name="secondary_button_label"/><field name="secondary_button_url" widget="url"/></group>
                            </group>
                        </page>
                        <page string="CTA cuối trang">
                            <group>
                                <field name="show_cta" widget="boolean_toggle"/>
                                <field name="cta_title"/>
                                <field name="cta_subtitle"/>
                                <field name="cta_button_label"/>
                                <field name="cta_button_url" widget="url"/>
                            </group>
                        </page>
                        <page string="SEO">
                            <group><field name="seo_title"/><field name="seo_description"/><field name="seo_keywords"/><field name="seo_image" widget="image" options="{'size': [600, 315]}"/></group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_doimoi_hero" model="ir.actions.act_window">
        <field name="name">Banner và CTA</field>
        <field name="res_model">doimoi.hero</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
