<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban class="o_helpdesk_kanban" default_group_by="stage_id" quick_create="false">
                <field name="ticket_number"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="category_id"/>
                <field name="last_activity_date"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="o_kanban_card_content">
                                <div class="o_kanban_card_header">
                                    <field name="priority" widget="priority"/>
                                    <field name="ticket_number"
                                           class="text-muted small"/>
                                </div>
                                <div class="o_kanban_card_title">
                                    <field name="name"/>
                                </div>
                                <div class="o_kanban_card_details">
                                    <div t-if="record.partner_id.raw_value">
                                        <i class="fa fa-user" title="Customer"/>
                                        <field name="partner_id"/>
                                    </div>
                                    <div t-if="record.category_id.raw_value">
                                        <field name="category_id"
                                               class="o_tag_color"/>
                                    </div>
                                </div>
                                <div class="o_kanban_card_bottom">
                                    <div class="o_kanban_card_bottom_left">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                    <div class="o_kanban_card_bottom_right">
                                        <field name="last_activity_date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
