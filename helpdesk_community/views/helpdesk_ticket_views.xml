<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree (List) View -->
    <record id="view_helpdesk_ticket_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.tree</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="ticket_number"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="priority" widget="priority"/>
                <field name="last_activity_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1'}"/>
                    <button name="action_close" type="object"
                            string="Close"
                            groups="helpdesk_community.group_helpdesk_team_leader"
                            confirm="Are you sure you want to close this ticket?"/>
                    <button name="action_reopen" type="object"
                            string="Reopen"
                            groups="helpdesk_community.group_helpdesk_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_assign"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-plus"
                                string="Assign to me"/>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_number"/>
                            <field name="name"/>
                            <field name="priority" widget="priority"/>
                            <field name="category_id"/>
                            <field name="partner_id"
                                   options="{'create_edit': True}"/>
                        </group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id"
                                   options="{'no_create': True}"/>
                            <field name="close_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ticket_number"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="group_stage" context="{'group_by': 'stage_id'}"/>
                <filter name="group_team" context="{'group_by': 'team_id'}"/>
                <filter name="group_priority" context="{'group_by': 'priority'}"/>
                <filter name="group_user" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_helpdesk_ticket_tree" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="help" type="html">
            <p>Create support tickets and track them through your pipeline.</p>
        </field>
    </record>
</odoo>
