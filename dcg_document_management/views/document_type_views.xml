<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_type_list" model="ir.ui.view">
        <field name="name">dcg.document.type.list</field>
        <field name="model">dcg.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="requires_approval" widget="boolean_toggle"/>
                <field name="requires_version" widget="boolean_toggle"/>
                <field name="portal_visible" widget="boolean_toggle"/>
                <field name="retention_days" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">dcg.document.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
