<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_review_list" model="ir.ui.view">
        <field name="name">dcg.document.review.list</field>
        <field name="model">dcg.document.review</field>
        <field name="arch" type="xml">
            <list string="Reviews" editable="bottom">
                <field name="review_date"/>
                <field name="reviewer_id"/>
                <field name="version_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-info="status == 'comment'"
                       decoration-muted="status == 'pending'"/>
                <field name="comment" optional="show"/>
                <field name="document_id" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
