<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_version_list" model="ir.ui.view">
        <field name="name">dcg.document.version.list</field>
        <field name="model">dcg.document.version</field>
        <field name="arch" type="xml">
            <list string="Versions" editable="bottom">
                <field name="version_number"/>
                <field name="attachment_id"/>
                <field name="file_name" optional="show"/>
                <field name="created_by_id"/>
                <field name="create_date"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="change_log" optional="show"/>
                <field name="document_id" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
