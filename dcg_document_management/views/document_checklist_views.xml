<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_checklist_list" model="ir.ui.view">
        <field name="name">dcg.document.checklist.list</field>
        <field name="model">dcg.document.checklist</field>
        <field name="arch" type="xml">
            <list string="Document Checklist" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="type_id" optional="show"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="document_id"/>
                <field name="is_fulfilled" widget="boolean"/>
                <field name="note" optional="hide"/>
                <field name="project_id" column_invisible="1"/>
            </list>
        </field>
    </record>
</odoo>
