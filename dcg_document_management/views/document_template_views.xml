<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_template_list" model="ir.ui.view">
        <field name="name">dcg.document.template.list</field>
        <field name="model">dcg.document.template</field>
        <field name="arch" type="xml">
            <list string="Document Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="category_id"/>
                <field name="folder_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_document_template_form" model="ir.ui.view">
        <field name="name">dcg.document.template.form</field>
        <field name="model">dcg.document.template</field>
        <field name="arch" type="xml">
            <form string="Document Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="category_id"/>
                            <field name="folder_id"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="default_content"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dcg_document_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">dcg.document.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
