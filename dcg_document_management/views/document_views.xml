<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_document_kanban" model="ir.ui.view">
        <field name="name">dcg.document.kanban</field>
        <field name="model">dcg.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <field name="folder_id"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="code" class="text-muted"/>
                        <div>
                            <field name="category_id"/>
                            <t t-if="record.folder_id.value"> — <field name="folder_id"/></t>
                        </div>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer>
                            <field name="current_version" class="text-muted"/>
                            <field name="owner_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dcg_document_list" model="ir.ui.view">
        <field name="name">dcg.document.list</field>
        <field name="model">dcg.document</field>
        <field name="arch" type="xml">
            <list string="Documents" multi_edit="1">
                <field name="code"/>
                <field name="name"/>
                <field name="folder_id" optional="show"/>
                <field name="type_id" optional="show"/>
                <field name="category_id"/>
                <field name="partner_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="current_version"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-info="state in ('approved', 'review')"
                       decoration-muted="state in ('archived', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_document_form" model="ir.ui.view">
        <field name="name">dcg.document.form</field>
        <field name="model">dcg.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_submit_review" type="object" string="Submit Review"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'review'"
                            groups="dcg_document_management.group_dcg_document_reviewer"/>
                    <button name="action_publish" type="object" string="Publish"
                            invisible="state != 'approved'"/>
                    <button name="action_archive_doc" type="object" string="Archive"
                            invisible="state not in ('approved', 'published')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('published', 'archived', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('review', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="template_id" invisible="state != 'draft'"/>
                            <field name="type_id"/>
                            <field name="category_id"/>
                            <field name="folder_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Ownership">
                            <field name="owner_id"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current File">
                            <field name="current_version" readonly="1"/>
                            <field name="current_attachment_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Content" name="content">
                            <field name="description"/>
                            <field name="content"/>
                        </page>
                        <page string="Versions" name="versions">
                            <field name="version_ids"
                                   context="{'default_document_id': id}"/>
                        </page>
                        <page string="Reviews" name="reviews">
                            <field name="review_ids"
                                   context="{'default_document_id': id}"/>
                        </page>
                        <page string="Business Links" name="links">
                            <field name="link_ids"
                                   context="{'default_document_id': id}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_document_search" model="ir.ui.view">
        <field name="name">dcg.document.search</field>
        <field name="model">dcg.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="folder_id"/>
                <field name="type_id"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="tag_ids"/>
                <separator/>
                <filter string="My Documents" name="filter_my"
                        domain="[('owner_id', '=', uid)]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Review" name="filter_review" domain="[('state', '=', 'review')]"/>
                <filter string="Published" name="filter_published" domain="[('state', '=', 'published')]"/>
                <group expand="0" string="Group By">
                    <filter string="Folder" name="group_folder" context="{'group_by': 'folder_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">dcg.document</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document</p>
        </field>
    </record>

</odoo>
