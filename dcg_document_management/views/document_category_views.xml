<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_category_list" model="ir.ui.view">
        <field name="name">dcg.document.category.list</field>
        <field name="model">dcg.document.category</field>
        <field name="arch" type="xml">
            <list string="Document Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_document_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">dcg.document.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
