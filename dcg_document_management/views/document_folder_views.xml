<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_document_folder_list" model="ir.ui.view">
        <field name="name">dcg.document.folder.list</field>
        <field name="model">dcg.document.folder</field>
        <field name="arch" type="xml">
            <list string="Document Folders">
                <field name="sequence" widget="handle"/>
                <field name="complete_name"/>
                <field name="manager_id" optional="show"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>
    <record id="action_dcg_document_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">dcg.document.folder</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
