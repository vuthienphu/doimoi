<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Groups                                                          -->
    <!-- ============================================================ -->
    <record id="group_dcg_approval_user" model="res.groups">
        <field name="name">DCG Approval / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">User được submit document và xem các approval request liên quan đến mình.</field>
    </record>

    <record id="group_dcg_approval_manager" model="res.groups">
        <field name="name">DCG Approval / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_approval_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Manager có toàn quyền cấu hình matrix, xem mọi request, cancel khi cần.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record rules                                                    -->
    <!-- ============================================================ -->

    <!-- Approval matrix: user thường chỉ thấy, manager full -->
    <record id="rule_approval_matrix_user_read" model="ir.rule">
        <field name="name">Approval Matrix: User read all</field>
        <field name="model_id" ref="model_dcg_approval_matrix"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Approval request: user thấy nếu là requester hoặc participant -->
    <record id="rule_approval_request_user" model="ir.rule">
        <field name="name">Approval Request: User scoped access</field>
        <field name="model_id" ref="model_dcg_approval_request"/>
        <field name="domain_force">
            ['|',
                ('requester_id', '=', user.id),
                ('participant_user_ids', 'in', [user.id])]
        </field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_user'))]"/>
    </record>

    <!-- Approval request: manager thấy tất cả -->
    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Approval Request: Manager sees all</field>
        <field name="model_id" ref="model_dcg_approval_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_manager'))]"/>
    </record>

    <!-- Approval request step: theo request -->
    <record id="rule_approval_request_step_user" model="ir.rule">
        <field name="name">Approval Request Step: scoped via request</field>
        <field name="model_id" ref="model_dcg_approval_request_step"/>
        <field name="domain_force">
            ['|',
                ('request_id.requester_id', '=', user.id),
                ('request_id.participant_user_ids', 'in', [user.id])]
        </field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_user'))]"/>
    </record>

    <record id="rule_approval_request_step_manager" model="ir.rule">
        <field name="name">Approval Request Step: Manager sees all</field>
        <field name="model_id" ref="model_dcg_approval_request_step"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_manager'))]"/>
    </record>

    <!-- Approval log: theo request -->
    <record id="rule_approval_log_user" model="ir.rule">
        <field name="name">Approval Log: scoped via request</field>
        <field name="model_id" ref="model_dcg_approval_log"/>
        <field name="domain_force">
            ['|',
                ('request_id.requester_id', '=', user.id),
                ('request_id.participant_user_ids', 'in', [user.id])]
        </field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_user'))]"/>
    </record>

    <record id="rule_approval_log_manager" model="ir.rule">
        <field name="name">Approval Log: Manager sees all</field>
        <field name="model_id" ref="model_dcg_approval_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dcg_approval_manager'))]"/>
    </record>

</odoo>
