<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_approval_request_step_list" model="ir.ui.view">
        <field name="name">dcg.approval.request.step.list</field>
        <field name="model">dcg.approval.request.step</field>
        <field name="arch" type="xml">
            <list string="Approval Steps" create="false" delete="false">
                <field name="sequence"/>
                <field name="name"/>
                <field name="approver_type"/>
                <field name="approver_user_ids" widget="many2many_tags"/>
                <field name="state" decoration-success="state == 'approved'"
                                    decoration-danger="state == 'rejected'"
                                    decoration-muted="state == 'cancelled'"
                                    decoration-info="state == 'pending'"/>
                <field name="approved_by" optional="show"/>
                <field name="approved_date" optional="show"/>
                <field name="rejected_by" optional="hide"/>
                <field name="rejected_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_approval_request_step_form" model="ir.ui.view">
        <field name="name">dcg.approval.request.step.form</field>
        <field name="model">dcg.approval.request.step</field>
        <field name="arch" type="xml">
            <form string="Approval Step" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="matrix_line_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="approver_type" readonly="1"/>
                            <field name="approver_user_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approved">
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group string="Rejected">
                            <field name="rejected_by" readonly="1"/>
                            <field name="rejected_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
