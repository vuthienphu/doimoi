<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Matrix line list/form (inline in matrix form)                  -->
    <!-- ============================================================ -->
    <record id="view_dcg_approval_matrix_line_list" model="ir.ui.view">
        <field name="name">dcg.approval.matrix.line.list</field>
        <field name="model">dcg.approval.matrix.line</field>
        <field name="arch" type="xml">
            <list string="Approval Steps" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approver_type"/>
                <field name="user_id"
                       optional="show"
                       invisible="approver_type != 'specific_user'"/>
                <field name="group_id"
                       optional="show"
                       invisible="approver_type != 'group'"/>
                <field name="manager_level"
                       optional="show"
                       invisible="approver_type != 'employee_manager'"/>
                <field name="min_amount" optional="show"/>
                <field name="max_amount" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_approval_matrix_line_form" model="ir.ui.view">
        <field name="name">dcg.approval.matrix.line.form</field>
        <field name="model">dcg.approval.matrix.line</field>
        <field name="arch" type="xml">
            <form string="Approval Step">
                <sheet>
                    <group>
                        <group>
                            <field name="matrix_id" readonly="1" force_save="1"/>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="approver_type"/>
                            <field name="user_id"
                                   invisible="approver_type != 'specific_user'"
                                   required="approver_type == 'specific_user'"/>
                            <field name="group_id"
                                   invisible="approver_type != 'group'"
                                   required="approver_type == 'group'"/>
                            <field name="manager_level"
                                   invisible="approver_type != 'employee_manager'"/>
                        </group>
                    </group>
                    <group string="Amount Filter">
                        <field name="min_amount"/>
                        <field name="max_amount"/>
                    </group>
                    <notebook>
                        <page string="Advanced" name="advanced">
                            <field name="condition_json"
                                   placeholder='Reserved for advanced conditions. Example: {"region": "north"}'/>
                            <field name="stop_if_rejected"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Matrix list / form / search                                    -->
    <!-- ============================================================ -->
    <record id="view_dcg_approval_matrix_list" model="ir.ui.view">
        <field name="name">dcg.approval.matrix.list</field>
        <field name="model">dcg.approval.matrix</field>
        <field name="arch" type="xml">
            <list string="Approval Matrices">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="approval_type"/>
                <field name="company_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="amount_from" optional="hide"/>
                <field name="amount_to" optional="hide"/>
                <field name="line_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_approval_matrix_form" model="ir.ui.view">
        <field name="name">dcg.approval.matrix.form</field>
        <field name="model">dcg.approval.matrix</field>
        <field name="arch" type="xml">
            <form string="Approval Matrix">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Matrix name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="approval_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id"/>
                            <field name="amount_from"/>
                            <field name="amount_to"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Steps" name="steps">
                            <field name="line_ids" context="{'default_matrix_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="user_id"
                                           invisible="approver_type != 'specific_user'"/>
                                    <field name="group_id"
                                           invisible="approver_type != 'group'"/>
                                    <field name="manager_level"
                                           invisible="approver_type != 'employee_manager'"/>
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_approval_matrix_search" model="ir.ui.view">
        <field name="name">dcg.approval.matrix.search</field>
        <field name="model">dcg.approval.matrix</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="approval_type"/>
                <field name="company_id"/>
                <field name="department_id"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Approval Type" name="group_approval_type"
                            context="{'group_by': 'approval_type'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_approval_matrix" model="ir.actions.act_window">
        <field name="name">Approval Matrices</field>
        <field name="res_model">dcg.approval.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first approval matrix
            </p>
            <p>
                A matrix defines the sequence of approval steps for a given approval type.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dcg_approval_matrix"
        name="Approval Matrices"
        parent="menu_dcg_approval_config"
        action="action_dcg_approval_matrix"
        sequence="10"/>

</odoo>
