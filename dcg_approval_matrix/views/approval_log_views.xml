<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_approval_log_list" model="ir.ui.view">
        <field name="name">dcg.approval.log.list</field>
        <field name="model">dcg.approval.log</field>
        <field name="arch" type="xml">
            <list string="Approval Logs" create="false" delete="false" edit="false">
                <field name="action_date"/>
                <field name="request_id"/>
                <field name="step_no"/>
                <field name="action" decoration-success="action == 'approve'"
                                     decoration-danger="action == 'reject'"
                                     decoration-warning="action == 'cancel'"
                                     decoration-info="action == 'submit'"/>
                <field name="approver_id"/>
                <field name="from_state" optional="hide"/>
                <field name="to_state" optional="show"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_approval_log_form" model="ir.ui.view">
        <field name="name">dcg.approval.log.form</field>
        <field name="model">dcg.approval.log</field>
        <field name="arch" type="xml">
            <form string="Approval Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="step_no"/>
                            <field name="matrix_line_id"/>
                            <field name="request_step_id"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="action_date"/>
                            <field name="approver_id"/>
                            <field name="from_state"/>
                            <field name="to_state"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dcg_approval_log" model="ir.actions.act_window">
        <field name="name">Approval Logs</field>
        <field name="res_model">dcg.approval.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_dcg_approval_log"
        name="Approval Logs"
        parent="menu_dcg_approval_operations"
        action="action_dcg_approval_log"
        sequence="50"
        groups="dcg_approval_matrix.group_dcg_approval_manager"/>

</odoo>
