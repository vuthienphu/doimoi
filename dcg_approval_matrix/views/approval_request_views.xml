<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- List                                                            -->
    <!-- ============================================================ -->
    <record id="view_dcg_approval_request_list" model="ir.ui.view">
        <field name="name">dcg.approval.request.list</field>
        <field name="model">dcg.approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" create="false">
                <field name="name"/>
                <field name="approval_type"/>
                <field name="requester_id"/>
                <field name="res_name" string="Document"/>
                <field name="amount_total" sum="Total Amount"/>
                <field name="currency_id" optional="hide"/>
                <field name="request_date"/>
                <field name="current_step" optional="show"/>
                <field name="state"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'cancelled'"
                       decoration-info="state == 'waiting'"
                       decoration-muted="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Form                                                            -->
    <!-- ============================================================ -->
    <record id="view_dcg_approval_request_form" model="ir.ui.view">
        <field name="name">dcg.approval.request.form</field>
        <field name="model">dcg.approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="false">
                <header>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="not can_current_user_approve"
                            confirm="Are you sure you want to approve this request?"/>
                    <button name="action_open_reject_wizard"
                            type="object"
                            string="Reject"
                            class="btn-danger"
                            invisible="not can_current_user_approve"/>
                    <button name="action_open_cancel_wizard"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="not can_current_user_cancel"/>
                    <button name="action_open_source_document"
                            type="object"
                            string="Open Source Document"
                            class="btn-secondary"
                            invisible="not res_model or not res_id"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,waiting,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="approval_type" readonly="1"/>
                            <field name="matrix_id" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="currency_id" readonly="1" groups="base.group_multi_currency"/>
                            <field name="request_date" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Requester">
                            <field name="requester_id" readonly="1"/>
                            <field name="requester_employee_id" readonly="1"/>
                            <field name="requester_department_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Step">
                            <field name="current_step" readonly="1"/>
                            <field name="current_step_id" readonly="1"/>
                            <field name="current_approver_user_ids"
                                   widget="many2many_tags"
                                   readonly="1"/>
                        </group>
                        <group string="Result">
                            <field name="approved_date" readonly="1"
                                   invisible="state != 'approved'"/>
                            <field name="final_approver_id" readonly="1"
                                   invisible="state != 'approved'"/>
                            <field name="rejected_date" readonly="1"
                                   invisible="state != 'rejected'"/>
                            <field name="cancelled_date" readonly="1"
                                   invisible="state != 'cancelled'"/>
                        </group>
                    </group>
                    <group string="Source Document">
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="res_name" readonly="1"/>
                    </group>
                    <!-- Hidden helper flags for buttons -->
                    <field name="can_current_user_approve" invisible="1"/>
                    <field name="can_current_user_cancel" invisible="1"/>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="approver_user_ids" widget="many2many_tags"/>
                                    <field name="state"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'cancelled'"
                                           decoration-info="state == 'pending'"/>
                                    <field name="approved_by"/>
                                    <field name="approved_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Logs" name="logs">
                            <field name="log_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="action_date"/>
                                    <field name="step_no"/>
                                    <field name="action"
                                           decoration-success="action == 'approve'"
                                           decoration-danger="action == 'reject'"
                                           decoration-warning="action == 'cancel'"
                                           decoration-info="action == 'submit'"/>
                                    <field name="approver_id"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submission Note" name="note">
                            <field name="note" readonly="1"/>
                        </page>
                        <page string="Result Detail" name="result"
                              invisible="state not in ('rejected', 'cancelled', 'approved')">
                            <group>
                                <field name="reject_reason"
                                       invisible="state != 'rejected'"
                                       readonly="1"/>
                                <field name="cancel_reason"
                                       invisible="state != 'cancelled'"
                                       readonly="1"/>
                                <field name="result_note" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Search                                                          -->
    <!-- ============================================================ -->
    <record id="view_dcg_approval_request_search" model="ir.ui.view">
        <field name="name">dcg.approval.request.search</field>
        <field name="model">dcg.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="approval_type"/>
                <field name="requester_id"/>
                <field name="res_name" string="Document"/>
                <field name="matrix_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting" name="filter_waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="My Requests" name="filter_my_requests"
                        domain="[('requester_id', '=', uid)]"/>
                <filter string="Pending My Approval" name="filter_my_approvals"
                        domain="[('state', '=', 'waiting'), ('current_approver_user_ids', 'in', [uid])]"/>
                <group expand="0" string="Group By">
                    <filter string="Approval Type" name="group_approval_type"
                            context="{'group_by': 'approval_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Requester" name="group_requester"
                            context="{'group_by': 'requester_id'}"/>
                    <filter string="Matrix" name="group_matrix"
                            context="{'group_by': 'matrix_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Actions                                                         -->
    <!-- ============================================================ -->
    <record id="action_dcg_approval_request_all" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">dcg.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval request yet
            </p>
            <p>
                Approval requests are created automatically when a business document
                is submitted for approval.
            </p>
        </field>
    </record>

    <record id="action_dcg_approval_request_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">dcg.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [('state', '=', 'waiting'), ('current_approver_user_ids', 'in', [uid])]
        </field>
        <field name="context">{'search_default_filter_waiting': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval is waiting for you
            </p>
        </field>
    </record>

    <record id="action_dcg_approval_request_my_requests" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">dcg.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
    </record>

    <!-- ============================================================ -->
    <!-- Menus                                                           -->
    <!-- ============================================================ -->
    <menuitem
        id="menu_dcg_approval_my_approvals"
        name="My Approvals"
        parent="menu_dcg_approval_operations"
        action="action_dcg_approval_request_my_approvals"
        sequence="10"/>

    <menuitem
        id="menu_dcg_approval_my_requests"
        name="My Requests"
        parent="menu_dcg_approval_operations"
        action="action_dcg_approval_request_my_requests"
        sequence="20"/>

    <menuitem
        id="menu_dcg_approval_all_requests"
        name="All Requests"
        parent="menu_dcg_approval_operations"
        action="action_dcg_approval_request_all"
        sequence="30"
        groups="dcg_approval_matrix.group_dcg_approval_manager"/>

</odoo>
