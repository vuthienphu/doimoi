<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_approval_cancel_wizard_form" model="ir.ui.view">
        <field name="name">dcg.approval.cancel.wizard.form</field>
        <field name="model">dcg.approval.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Approval Request">
                <group>
                    <field name="request_id" readonly="1"/>
                </group>
                <group string="Cancel Reason (optional)">
                    <field name="reason" nolabel="1" placeholder="Reason for cancellation..."/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Cancel"
                            class="btn-warning"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
