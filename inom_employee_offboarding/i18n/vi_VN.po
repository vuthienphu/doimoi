#. module: inom_employee_offboarding
#: model:mail.template,body_html:inom_employee_offboarding.mail_template_offboarding_relieved
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #2b2b2b;\">\n"
"                    <p>Xin chào <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Quy trình nghỉ việc của bạn đã được <strong>hoàn tất</strong>.</p>\n"
"                    <p><strong>Mã yêu cầu:</strong> <t t-out=\"object.name or ''\"/></p>\n"
"                    <p><strong>Ngày làm việc cuối cùng:</strong> <t t-out=\"object.proposed_last_day and object.proposed_last_day.strftime('%d/%m/%Y') or ''\"/></p>\n"
"                    <p>Mọi thủ tục nghỉ việc đã được hoàn thành. Vui lòng truy cập hệ thống nếu bạn\n"
"                        muốn xem lại thông tin.</p>\n"
"                    <p style=\"margin: 16px 0;\">\n"
"                        <a t-att-href=\"object.env.context.get('record_url') or '#'\" style=\"background-color: #0b3954; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n"
"                            Xem chi tiết yêu cầu\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Bravestars Games chân thành cảm ơn những đóng góp của bạn trong thời gian đồng\n"
"                        hành cùng Công ty. Kính chúc bạn nhiều sức khỏe, thành công và gặt hái nhiều\n"
"                        thành tựu trên chặng đường sắp tới.</p>\n"
"                    <p>Trân trọng,<br/><strong>Phòng Nhân Sự Bravestars Games</strong></p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: inom_employee_offboarding
#: model:mail.template,body_html:inom_employee_offboarding.mail_template_offboarding_rejected
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #2b2b2b;\">\n"
"                    <p>Xin chào <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Đơn xin nghỉ việc của bạn <strong>đã bị từ chối</strong>.</p>\n"
"                    <p><strong>Mã yêu cầu:</strong> <t t-out=\"object.name or ''\"/></p>\n"
"                    <p><strong>Lý do:</strong> <t t-out=\"object.rejection_reason or ''\"/></p>\n"
"                    <p>Vui lòng truy cập hệ thống để xem thông tin chi tiết. Nếu cần thêm thông tin\n"
"                        hoặc có bất kỳ thắc mắc nào, bạn hãy liên hệ Phòng Nhân sự để được giải đáp.</p>\n"
"                    <p style=\"margin: 16px 0;\">\n"
"                        <a t-att-href=\"object.env.context.get('record_url') or '#'\" style=\"background-color: #0b3954; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n"
"                            Xem chi tiết yêu cầu\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Trân trọng,<br/><strong>Phòng Nhân Sự Bravestars Games</strong></p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: inom_employee_offboarding
#: model:mail.template,body_html:inom_employee_offboarding.mail_template_offboarding_approved
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #2b2b2b;\">\n"
"                    <p>Xin chào <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Đơn xin nghỉ việc của bạn đã <strong>được phê duyệt</strong>.</p>\n"
"                    <p>\n"
"                        <strong>Mã yêu cầu:</strong> <t t-out=\"object.name or ''\"/><br/>\n"
"                        <strong>Ngày làm việc cuối cùng:</strong> <t t-out=\"object.proposed_last_day or ''\"/>\n"
"                    </p>\n"
"                    <p>Trong thời gian còn lại, vui lòng thực hiện bàn giao công việc theo quy định của Công ty.</p>\n"
"                    <p>Đồng thời, vui lòng truy cập hệ thống để:</p>\n"
"                    <ul>\n"
"                        <li>Xem các thông tin và hướng dẫn cần thực hiện trước ngày nghỉ việc.</li>\n"
"                        <li>Theo dõi tiến độ của quy trình nghỉ việc.</li>\n"
"                        <li>Kiểm tra các khoản thanh toán liên quan.</li>\n"
"                    </ul>\n"
"                    <p style=\"margin: 16px 0;\">\n"
"                        <a t-att-href=\"object.env.context.get('record_url') or '#'\" style=\"background-color: #0b3954; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n"
"                            Xem chi tiết yêu cầu\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Nếu cần hỗ trợ thêm bất cứ thông tin nào, bạn vui lòng liên hệ Phòng Nhân sự.</p>\n"
"                    <p>Cảm ơn bạn đã đồng hành cùng Bravestars Games. Chúc bạn nhiều thành công trên chặng đường sắp tới.</p>\n"
"                    <p>Trân trọng,<br/><strong>Phòng Nhân Sự Bravestars Games</strong></p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: inom_employee_offboarding
#: model:mail.template,body_html:inom_employee_offboarding.mail_template_offboarding_hr_review
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #2b2b2b;\">\n"
"                    <p>Xin chào <t t-out=\"object.env.context.get('hr_recipient_name') or 'anh/chị'\"/>,</p>\n"
"                    <p>Bạn có <strong>một đơn xin nghỉ việc mới</strong> đang chờ phê duyệt.</p>\n"
"                    <p><strong>Mã yêu cầu:</strong> <t t-out=\"object.name or ''\"/></p>\n"
"                    <p><strong>Nhân viên:</strong> <t t-out=\"object.employee_id.name or ''\"/></p>\n"
"                    <p><strong>Phòng ban:</strong> <t t-out=\"object.department_id.name or ''\"/></p>\n"
"                    <p><strong>Loại nghỉ việc:</strong> <t t-out=\"dict(object._fields['offboarding_type'].selection).get(object.offboarding_type) or ''\"/></p>\n"
"                    <p><strong>Ngày làm việc cuối cùng (dự kiến):</strong> <t t-out=\"object.proposed_last_day and object.proposed_last_day.strftime('%d/%m/%Y') or ''\"/></p>\n"
"                    <p><strong>Lý do:</strong> <t t-out=\"object.reason_id.name or ''\"/></p>\n"
"                    <p>Vui lòng truy cập hệ thống để xem thông tin chi tiết và thực hiện phê duyệt\n"
"                        <strong>trước ngày <t t-out=\"object.env.context.get('hr_deadline') or ''\"/></strong>.</p>\n"
"                    <p style=\"margin: 16px 0;\">\n"
"                        <a t-att-href=\"object.env.context.get('record_url') or '#'\" style=\"background-color: #0b3954; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n"
"                            Xem chi tiết yêu cầu\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Trân trọng,<br/><strong>Phòng Nhân Sự Bravestars Games</strong></p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: inom_employee_offboarding
#: model:mail.template,body_html:inom_employee_offboarding.mail_template_offboarding_reminder
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #2b2b2b;\">\n"
"                    <p>Xin chào <t t-out=\"object.env.context.get('reminder_recipient_name') or 'anh/chị'\"/>,</p>\n"
"                    <p>Đây là email nhắc phê duyệt cho Đơn xin nghỉ việc của\n"
"                        <t t-out=\"object.employee_id.name or ''\"/>. Đơn xin nghỉ việc này cần được\n"
"                        hoàn tất phê duyệt trong ngày hôm nay để quy trình nghỉ việc của nhân viên\n"
"                        được xử lý đúng tiến độ.</p>\n"
"                    <p>Vui lòng truy cập hệ thống và thực hiện phê duyệt tại đây.</p>\n"
"                    <p style=\"margin: 16px 0;\">\n"
"                        <a t-att-href=\"object.env.context.get('record_url') or '#'\" style=\"background-color: #0b3954; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px; display: inline-block;\">\n"
"                            Xem chi tiết yêu cầu\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Nếu anh/chị đã hoàn tất, vui lòng bỏ qua email này.</p>\n"
"                    <p>Trân trọng,<br/><strong>Phòng Nhân Sự Bravestars Games</strong></p>\n"
"                </div>\n"
"            "
msgstr ""

