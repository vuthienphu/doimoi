<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_offboarding_approval_remind" model="ir.cron">
            <field name="name">Nghỉ việc: Nhắc phê duyệt đơn</field>
            <field name="model_id" ref="model_inom_offboarding_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_approval_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=2, minute=0, second=0, microsecond=0))"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_offboarding_relieve_auto" model="ir.cron">
            <field name="name">Nghỉ việc: Tự động xác nhận nghỉ việc</field>
            <field name="model_id" ref="model_inom_offboarding_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_relieve_due_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=17, minute=1, second=0, microsecond=0))"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
