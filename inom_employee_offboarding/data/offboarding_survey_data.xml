<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="offboarding_exit_interview_survey" model="survey.survey">
            <field name="title">Bộ câu hỏi phỏng vấn nghỉ việc</field>
            <field name="survey_type">survey</field>
            <field name="questions_layout">one_page</field>
            <field name="questions_selection">all</field>
            <field name="users_login_required">True</field>
            <field name="is_exit_interview">True</field>
        </record>

    </data>

    <record id="action_offboarding_exit_interview_survey" model="ir.actions.act_window">
        <field name="name">Phỏng vấn nghỉ việc</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="offboarding_exit_interview_survey"/>
        <field name="target">current</field>
    </record>

</odoo>
