<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_offboarding_mail_template_list" model="ir.ui.view">
        <field name="name">inom.offboarding.mail.template.list</field>
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu email nghỉ việc">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_offboarding_mail_template" model="ir.actions.act_window">
        <field name="name">Mẫu email nghỉ việc</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', '=', 'inom.offboarding.request')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_offboarding_mail_template_list')})]"/>
    </record>

</odoo>
