<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_offboarding_payment_template_list" model="ir.ui.view">
        <field name="name">inom.offboarding.payment.template.list</field>
        <field name="model">inom.offboarding.payment.template</field>
        <field name="arch" type="xml">
            <list string="Khoản thanh toán">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="notes"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_offboarding_payment_template_form" model="ir.ui.view">
        <field name="name">inom.offboarding.payment.template.form</field>
        <field name="model">inom.offboarding.payment.template</field>
        <field name="arch" type="xml">
            <form string="Khoản thanh toán">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="append_last_day"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Ghi chú">
                        <field name="notes" colspan="4" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_offboarding_payment_template" model="ir.actions.act_window">
        <field name="name">Khoản thanh toán</field>
        <field name="res_model">inom.offboarding.payment.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
