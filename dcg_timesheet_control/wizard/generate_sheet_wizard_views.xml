<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_generate_sheet_wizard_form" model="ir.ui.view">
        <field name="name">dcg.generate.sheet.wizard.form</field>
        <field name="model">dcg.generate.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Timesheet Sheet">
                <group>
                    <field name="employee_id"/>
                    <field name="period_type"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate Sheet" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dcg_generate_sheet_wizard" model="ir.actions.act_window">
        <field name="name">Generate Timesheet Sheet</field>
        <field name="res_model">dcg.generate.sheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
