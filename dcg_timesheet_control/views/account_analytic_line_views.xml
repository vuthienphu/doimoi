<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_timesheet_line_list" model="ir.ui.view">
        <field name="name">account.analytic.line.list.dcg.timesheet</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="DCG Timesheet Lines" editable="bottom" sample="1">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="dcg_project_id"/>
                <field name="dcg_scope_id" optional="show"/>
                <field name="name" string="Description"/>
                <field name="unit_amount" string="Hours" sum="Total"/>
                <field name="work_type" optional="show"/>
                <field name="charge_type"/>
                <field name="is_overtime" widget="boolean_toggle" optional="show"/>
                <field name="overtime_hours" optional="hide" sum="OT"/>
                <field name="dcg_sheet_id" optional="show"/>
                <field name="line_state" widget="badge"
                       decoration-success="line_state == 'approved'"
                       decoration-info="line_state == 'submitted'"
                       decoration-danger="line_state == 'rejected'"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_timesheet_line_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form.dcg.timesheet</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Timesheet Line">
                <sheet>
                    <group>
                        <group string="Basic">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="user_id" readonly="1"/>
                            <field name="unit_amount" string="Hours"/>
                            <field name="name" string="Description"/>
                        </group>
                        <group string="Delivery">
                            <field name="dcg_project_id"/>
                            <field name="dcg_scope_id"/>
                            <field name="dcg_milestone_id" optional="show"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="project_id" readonly="1" optional="show"/>
                        </group>
                    </group>
                    <group>
                        <group string="Classification">
                            <field name="work_type"/>
                            <field name="charge_type"/>
                            <field name="is_billable" readonly="1"/>
                            <field name="is_overtime"/>
                            <field name="overtime_hours" invisible="not is_overtime"/>
                            <field name="ot_request_id"/>
                        </group>
                        <group string="Costing">
                            <field name="cost_rate"/>
                            <field name="billing_rate"/>
                            <field name="line_cost_amount" readonly="1"/>
                            <field name="line_billing_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Content">
                            <field name="work_summary"/>
                            <field name="result_note"/>
                        </group>
                        <group string="Approval">
                            <field name="dcg_sheet_id" readonly="1"/>
                            <field name="line_state" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dcg_timesheet_line_search" model="ir.ui.view">
        <field name="name">account.analytic.line.search.dcg.timesheet</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="dcg_project_id"/>
                <field name="dcg_scope_id"/>
                <field name="work_type"/>
                <field name="charge_type"/>
                <separator/>
                <filter string="My Lines" name="filter_my" domain="[('user_id', '=', uid)]"/>
                <filter string="Billable" name="filter_billable" domain="[('charge_type', '=', 'billable')]"/>
                <filter string="Overtime" name="filter_ot" domain="[('is_overtime', '=', True)]"/>
                <filter string="Approved" name="filter_approved" domain="[('line_state', '=', 'approved')]"/>
                <filter string="Draft" name="filter_draft" domain="[('line_state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'dcg_project_id'}"/>
                    <filter string="Scope" name="group_scope" context="{'group_by': 'dcg_scope_id'}"/>
                    <filter string="Work Type" name="group_work_type" context="{'group_by': 'work_type'}"/>
                    <filter string="Charge Type" name="group_charge" context="{'group_by': 'charge_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_timesheet_lines" model="ir.actions.act_window">
        <field name="name">Timesheet Lines</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dcg_timesheet_line_list"/>
        <field name="search_view_id" ref="view_dcg_timesheet_line_search"/>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_my': 1}</field>
    </record>

</odoo>
