<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_timesheet_user" model="res.groups">
        <field name="name">DCG Timesheet / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">Nhân sự chấm công: CRUD line/sheet/OT của mình.</field>
    </record>
    <record id="group_dcg_timesheet_approver" model="res.groups">
        <field name="name">DCG Timesheet / Approver</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_timesheet_user'))]"/>
        <field name="comment">PM/Manager: approve sheet/OT của cấp dưới.</field>
    </record>
    <record id="group_dcg_timesheet_manager" model="res.groups">
        <field name="name">DCG Timesheet / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_timesheet_approver'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: xem tất cả, reset, override.</field>
    </record>
</odoo>
