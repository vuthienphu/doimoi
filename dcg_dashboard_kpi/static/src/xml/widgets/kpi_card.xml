<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="dcg_dashboard_kpi.KpiCard">
        <div class="dcg-kpi-card" t-attf-class="border-{{props.color or 'primary'}}"
             t-on-click="() => props.onClick and props.onClick()">
            <div class="dcg-kpi-label" t-esc="props.label"/>
            <div class="dcg-kpi-value" t-attf-class="text-{{props.color or 'primary'}}">
                <t t-esc="props.prefix || ''"/><t t-esc="formatValue(props.value)"/><t t-esc="props.suffix || ''"/>
            </div>
            <div class="dcg-kpi-sub" t-if="props.sub" t-esc="props.sub"/>
        </div>
    </t>
    <t t-name="dcg_dashboard_kpi.DashboardTable">
        <div class="dcg-dash-table">
            <div class="dcg-dash-table-title" t-esc="props.title"/>
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th t-foreach="props.columns" t-as="col" t-key="col.key" t-esc="col.label"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="props.rows" t-as="row" t-key="row_index"
                        t-on-click="() => props.onRowClick and props.onRowClick(row)"
                        style="cursor:pointer;">
                        <td t-foreach="props.columns" t-as="col" t-key="col.key" t-esc="row[col.key]"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
</templates>
