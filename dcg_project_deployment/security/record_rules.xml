<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_account_system_rule" model="ir.rule">
        <field name="name">Tài khoản dự án: quản trị hệ thống truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="project_account_pm_rule" model="ir.rule">
        <field name="name">Tài khoản dự án: quản lý dự án được đọc toàn bộ</field>
        <field name="model_id" ref="model_project_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="project_remote_system_rule" model="ir.rule">
        <field name="name">Kết nối máy chủ: quản trị hệ thống truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_remote"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
