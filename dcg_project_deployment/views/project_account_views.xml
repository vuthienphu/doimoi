<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_account_view_list" model="ir.ui.view">
        <field name="name">project.account.list</field>
        <field name="model">project.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="account_type"/>
                <field name="username"/>
                <field name="password_masked" groups="project.group_project_manager" invisible="1"/>
                <field name="url" widget="url"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="project_account_view_form" model="ir.ui.view">
        <field name="name">project.account.form</field>
        <field name="model">project.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="name"/>
                            <field name="account_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="username" widget="CopyClipboardChar"/>
                            <field name="password" widget="password" groups="base.group_system"/>
                            <field name="password" string="Sao chép mật khẩu" widget="CopyClipboardButton" groups="base.group_system" options="{'btn_class': 'secondary'}"/>
                            <field name="password_masked" readonly="1" groups="project.group_project_manager" invisible="1"/>
                            <field name="url" widget="url"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="project_account_view_search" model="ir.ui.view">
        <field name="name">project.account.search</field>
        <field name="model">project.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="account_type"/>
                <field name="username"/>
                <field name="url"/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Dự án" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Loại tài khoản" name="group_account_type" context="{'group_by': 'account_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="project_account_action" model="ir.actions.act_window">
        <field name="name">Tài khoản dự án</field>
        <field name="res_model">project.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_account_view_search"/>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
