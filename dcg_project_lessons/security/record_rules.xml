<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_lesson_employee_read_rule" model="ir.rule">
        <field name="name">Bài học: nhân viên đọc bài của mình hoặc dự án tham gia</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">['|', '|', ('author_id', '=', user.id), ('project_id.user_id', '=', user.id), ('project_id.favorite_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('dcg_project_lessons.group_project_lesson_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_lesson_employee_write_rule" model="ir.rule">
        <field name="name">Bài học: nhân viên sửa bài nháp của mình</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[('author_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('dcg_project_lessons.group_project_lesson_employee'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_lesson_pm_rule" model="ir.rule">
        <field name="name">Bài học: quản lý dự án truy cập dự án phụ trách</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">['|', ('project_id.user_id', '=', user.id), ('project_id.favorite_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('dcg_project_lessons.group_project_lesson_pm'))]"/>
    </record>

    <record id="project_lesson_director_rule" model="ir.rule">
        <field name="name">Bài học: giám đốc truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('dcg_project_lessons.group_project_lesson_director'))]"/>
    </record>

    <record id="project_lesson_system_rule" model="ir.rule">
        <field name="name">Bài học: quản trị hệ thống truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
