<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_lesson_employee_read_rule" model="ir.rule">
        <field name="name">Bài học: người dùng đọc bài của mình hoặc bài học chia sẻ</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">['|', ('author_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_lesson_employee_write_rule" model="ir.rule">
        <field name="name">Bài học: người dùng sửa bài nháp của mình</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[('author_id', '=', user.id), ('state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_lesson_pm_rule" model="ir.rule">
        <field name="name">Bài học: quản lý truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="project_lesson_system_rule" model="ir.rule">
        <field name="name">Bài học: quản trị hệ thống truy cập toàn bộ</field>
        <field name="model_id" ref="model_project_lesson"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
