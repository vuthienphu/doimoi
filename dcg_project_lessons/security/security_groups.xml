<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_project_lessons" model="res.groups.privilege">
        <field name="name">Bài học kinh nghiệm</field>
        <field name="category_id" ref="base.module_category_services_project"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_project_lesson_employee" model="res.groups">
        <field name="name">Bài học kinh nghiệm - Nhân viên</field>
        <field name="privilege_id" ref="dcg_project_lessons.res_groups_privilege_project_lessons"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_project_lesson_pm" model="res.groups">
        <field name="name">Bài học kinh nghiệm - Quản lý dự án</field>
        <field name="privilege_id" ref="dcg_project_lessons.res_groups_privilege_project_lessons"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('dcg_project_lessons.group_project_lesson_employee')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="group_project_lesson_director" model="res.groups">
        <field name="name">Bài học kinh nghiệm - Giám đốc</field>
        <field name="privilege_id" ref="dcg_project_lessons.res_groups_privilege_project_lessons"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('dcg_project_lessons.group_project_lesson_pm'))]"/>
    </record>
</odoo>
