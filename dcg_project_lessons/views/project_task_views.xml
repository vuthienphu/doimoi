<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_inherit_lessons" model="ir.ui.view">
        <field name="name">project.task.form.inherit.lessons</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_task_lessons"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-lightbulb-o">
                    <field name="lesson_count" widget="statinfo" string="Bài học"/>
                </button>
            </xpath>
            <xpath expr="//page[@id='timesheets_tab']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="caution_lessons" string="Bài học cần lưu ý">
                    <field name="caution_lesson_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="category"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="author_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
