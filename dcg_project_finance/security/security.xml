<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dcg_project_finance_user" model="res.groups">
        <field name="name">DCG Project Finance / User</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="comment">PM / delivery: xem finance project được phân công, thêm cost line manual.</field>
    </record>
    <record id="group_dcg_project_finance_manager" model="res.groups">
        <field name="name">DCG Project Finance / Manager</field>
        <field name="category_id" ref="dcg_master_data.module_category_dcg"/>
        <field name="implied_ids" eval="[(4, ref('group_dcg_project_finance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Toàn quyền: close finance, override, sửa revenue line.</field>
    </record>
</odoo>
