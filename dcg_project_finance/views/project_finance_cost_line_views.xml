<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_finance_cost_line_list" model="ir.ui.view">
        <field name="name">dcg.project.finance.cost.line.list</field>
        <field name="model">dcg.project.finance.cost.line</field>
        <field name="arch" type="xml">
            <list string="Cost Lines" editable="bottom">
                <field name="cost_date"/>
                <field name="name"/>
                <field name="cost_type"/>
                <field name="source_type"/>
                <field name="project_id" column_invisible="1"/>
                <field name="scope_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_finance_cost_line_form" model="ir.ui.view">
        <field name="name">dcg.project.finance.cost.line.form</field>
        <field name="model">dcg.project.finance.cost.line</field>
        <field name="arch" type="xml">
            <form string="Cost Line">
                <sheet>
                    <group>
                        <group>
                            <field name="finance_id"/>
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="scope_id"/>
                            <field name="milestone_id"/>
                        </group>
                        <group>
                            <field name="cost_type"/>
                            <field name="source_type"/>
                            <field name="name"/>
                            <field name="cost_date"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="timesheet_line_id" readonly="1"/>
                            <field name="external_ref"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dcg_finance_cost_line_search" model="ir.ui.view">
        <field name="name">dcg.project.finance.cost.line.search</field>
        <field name="model">dcg.project.finance.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="cost_type"/>
                <field name="source_type"/>
                <field name="employee_id"/>
                <filter string="Labor" name="filter_labor" domain="[('cost_type', '=', 'labor')]"/>
                <filter string="Travel" name="filter_travel" domain="[('cost_type', '=', 'travel')]"/>
                <filter string="Manual" name="filter_manual" domain="[('source_type', '=', 'manual')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Cost Type" name="group_cost_type" context="{'group_by': 'cost_type'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source_type'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'cost_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_finance_cost_line" model="ir.actions.act_window">
        <field name="name">Cost Lines</field>
        <field name="res_model">dcg.project.finance.cost.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
