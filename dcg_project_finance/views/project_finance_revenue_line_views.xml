<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcg_finance_revenue_line_list" model="ir.ui.view">
        <field name="name">dcg.project.finance.revenue.line.list</field>
        <field name="model">dcg.project.finance.revenue.line</field>
        <field name="arch" type="xml">
            <list string="Revenue Lines" editable="bottom">
                <field name="revenue_date"/>
                <field name="name"/>
                <field name="line_type"/>
                <field name="planned_amount" sum="Total"/>
                <field name="invoiced_amount" sum="Total"/>
                <field name="collected_amount" sum="Total"/>
                <field name="balance_amount" sum="Total"/>
                <field name="payment_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'collected'"
                       decoration-info="state in ('invoiced', 'partial')"
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dcg_finance_revenue_line_form" model="ir.ui.view">
        <field name="name">dcg.project.finance.revenue.line.form</field>
        <field name="model">dcg.project.finance.revenue.line</field>
        <field name="arch" type="xml">
            <form string="Revenue Line">
                <sheet>
                    <group>
                        <group>
                            <field name="finance_id"/>
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="line_type"/>
                            <field name="name"/>
                            <field name="revenue_date"/>
                        </group>
                        <group>
                            <field name="payment_id"/>
                            <field name="acceptance_id"/>
                            <field name="milestone_id"/>
                            <field name="state"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <group>
                            <field name="planned_amount"/>
                            <field name="invoiced_amount"/>
                        </group>
                        <group>
                            <field name="collected_amount"/>
                            <field name="balance_amount" readonly="1"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dcg_finance_revenue_line_search" model="ir.ui.view">
        <field name="name">dcg.project.finance.revenue.line.search</field>
        <field name="model">dcg.project.finance.revenue.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="line_type"/>
                <filter string="Planned" name="filter_planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Invoiced" name="filter_invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter string="Collected" name="filter_collected" domain="[('state', '=', 'collected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'line_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dcg_finance_revenue_line" model="ir.actions.act_window">
        <field name="name">Revenue Lines</field>
        <field name="res_model">dcg.project.finance.revenue.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
