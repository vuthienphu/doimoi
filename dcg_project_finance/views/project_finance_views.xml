<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dcg_project_finance_list" model="ir.ui.view">
        <field name="name">dcg.project.finance.list</field>
        <field name="model">dcg.project.finance</field>
        <field name="arch" type="xml">
            <list string="Project Finance" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="contract_id" optional="show"/>
                <field name="project_manager_id" widget="many2one_avatar_user" optional="show"/>
                <field name="planned_revenue"/>
                <field name="planned_cost"/>
                <field name="actual_revenue" optional="show"/>
                <field name="actual_cost"/>
                <field name="actual_margin"/>
                <field name="collected_amount" optional="show"/>
                <field name="finance_health" widget="badge"
                       decoration-success="finance_health == 'green'"
                       decoration-warning="finance_health == 'yellow'"
                       decoration-danger="finance_health == 'red'"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('done', 'closed')"
                       decoration-info="state == 'active'"
                       decoration-muted="state == 'draft'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dcg_project_finance_form" model="ir.ui.view">
        <field name="name">dcg.project.finance.form</field>
        <field name="model">dcg.project.finance</field>
        <field name="arch" type="xml">
            <form string="Project Finance">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_sync_revenue_from_contract" type="object"
                            string="Sync Revenue" invisible="state in ('closed',)"/>
                    <button name="action_refresh_actual_cost" type="object"
                            string="Refresh Costs" invisible="state in ('closed',)"/>
                    <button name="action_set_on_hold" type="object" string="On Hold"
                            invisible="state != 'active'"/>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            invisible="state not in ('active', 'on_hold')"/>
                    <button name="action_close" type="object" string="Close Finance"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project" type="object"
                                class="oe_stat_button" icon="fa-cogs">
                            <span class="o_stat_text">Project</span>
                        </button>
                        <button name="action_view_contract" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <span class="o_stat_text">Contract</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Source">
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="project_manager_id"/>
                            <field name="delivery_owner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group string="Health">
                            <field name="finance_health" widget="badge"
                                   decoration-success="finance_health == 'green'"
                                   decoration-warning="finance_health == 'yellow'"
                                   decoration-danger="finance_health == 'red'"/>
                            <field name="collection_rate" widget="progressbar"/>
                            <field name="freeze_snapshot"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Tab 1: Overview P&L -->
                        <page string="P&amp;L Overview" name="overview">
                            <group>
                                <group string="Planned (Budget)">
                                    <field name="planned_revenue"/>
                                    <field name="planned_cost"/>
                                    <field name="planned_labor_cost"/>
                                    <field name="planned_travel_cost"/>
                                    <field name="planned_subcontract_cost"/>
                                    <field name="planned_other_cost"/>
                                    <field name="planned_margin" readonly="1"/>
                                    <field name="planned_margin_rate" readonly="1" widget="percentage"/>
                                </group>
                                <group string="Actual">
                                    <field name="actual_revenue" readonly="1"/>
                                    <field name="actual_cost" readonly="1"/>
                                    <field name="actual_labor_cost" readonly="1"/>
                                    <field name="actual_travel_cost" readonly="1"/>
                                    <field name="actual_subcontract_cost" readonly="1"/>
                                    <field name="actual_other_cost" readonly="1"/>
                                    <field name="actual_margin" readonly="1"/>
                                    <field name="actual_margin_rate" readonly="1" widget="percentage"/>
                                </group>
                            </group>
                            <group>
                                <group string="Collection">
                                    <field name="invoiced_amount" readonly="1"/>
                                    <field name="collected_amount" readonly="1"/>
                                    <field name="uncollected_amount" readonly="1"/>
                                </group>
                                <group string="Effort">
                                    <field name="planned_hours"/>
                                    <field name="actual_hours" readonly="1"/>
                                    <field name="billable_hours" readonly="1"/>
                                    <field name="non_billable_hours" readonly="1"/>
                                    <field name="ot_hours" readonly="1"/>
                                    <field name="avg_cost_per_hour" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 2: Cost Lines -->
                        <page string="Cost Lines" name="costs">
                            <field name="cost_line_ids"
                                   context="{'default_finance_id': id, 'default_project_id': project_id, 'default_contract_id': contract_id, 'default_currency_id': currency_id}"/>
                        </page>

                        <!-- Tab 3: Revenue Lines -->
                        <page string="Revenue Lines" name="revenue">
                            <field name="revenue_line_ids"
                                   context="{'default_finance_id': id, 'default_project_id': project_id, 'default_contract_id': contract_id}"/>
                        </page>

                        <!-- Tab 4: Variance -->
                        <page string="Variance" name="variance">
                            <group>
                                <group string="Planned vs Actual">
                                    <field name="revenue_variance" readonly="1"/>
                                    <field name="cost_variance" readonly="1"/>
                                    <field name="margin_variance" readonly="1"/>
                                    <field name="hours_variance" readonly="1"/>
                                </group>
                                <group string="Warning">
                                    <field name="warning_note"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab 5: Notes -->
                        <page string="Notes" name="notes">
                            <field name="note"/>
                            <group>
                                <field name="lead_id"/>
                                <field name="estimate_id"/>
                                <field name="quotation_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcg_project_finance_search" model="ir.ui.view">
        <field name="name">dcg.project.finance.search</field>
        <field name="model">dcg.project.finance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="contract_id"/>
                <field name="project_manager_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Red Health" name="filter_red" domain="[('finance_health', '=', 'red')]"/>
                <filter string="Yellow Health" name="filter_yellow" domain="[('finance_health', '=', 'yellow')]"/>
                <filter string="Over Budget" name="filter_over_budget"
                        domain="[('cost_variance', '&gt;', 0)]"/>
                <filter string="Negative Margin" name="filter_negative_margin"
                        domain="[('actual_margin', '&lt;', 0)]"/>
                <separator/>
                <filter string="My Projects" name="filter_my"
                        domain="[('project_manager_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="PM" name="group_pm" context="{'group_by': 'project_manager_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Health" name="group_health" context="{'group_by': 'finance_health'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcg_project_finance" model="ir.actions.act_window">
        <field name="name">Project Finance</field>
        <field name="res_model">dcg.project.finance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a finance record for a project
            </p>
            <p>Finance records are typically created automatically from the project delivery.</p>
        </field>
    </record>

</odoo>
