<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Finance smart button to project delivery form -->
    <record id="view_dcg_project_delivery_form_finance" model="ir.ui.view">
        <field name="name">dcg.project.delivery.form.finance</field>
        <field name="model">dcg.project.delivery</field>
        <field name="inherit_id" ref="dcg_project_delivery.view_dcg_project_delivery_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_finance" type="object"
                        class="oe_stat_button" icon="fa-line-chart"
                        string="Finance"/>
            </xpath>
        </field>
    </record>

</odoo>
